---
import Layout from "@/layouts/Layout.astro";
import CardSearch from "@/components/mtg/CardSearch.astro";
import ChaseList from "@/components/mtg/ChaseList.astro";
---

<Layout
  title="BinderLink"
  description="Build your Magic: The Gathering chase list, list cards for sale, and connect with other players on BinderLink."
>
  <section
    aria-labelledby="mtg-heading"
    class="mtg-hero px-6 pt-16 pb-6 sm:pt-24 sm:pb-8"
  >
    <div class="mx-auto max-w-5xl">
      <a
        href="/"
        class="rounded-sm font-semibold text-pyroduck-plasma transition-colors hover:text-pyroduck-lime focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-pyroduck-lime"
      >
        ← PyroDuck Tech
      </a>

      <p
        class="mb-3 mt-10 text-sm font-semibold uppercase tracking-widest text-pyroduck-lime"
      >
        Connect your collection. Find your next card.
      </p>

      <h1
        id="mtg-heading"
        class="text-4xl font-bold tracking-tight text-brand-text sm:text-6xl"
      >
        Binder<span class="text-pyroduck-plasma">Link.</span>
      </h1>

      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-brand-muted">
        A place for Magic: The Gathering players to build chase lists, discover
        cards for sale, and connect with other collectors. Find the cards you’re
        looking for and help someone else find theirs.
      </p>

      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="/mtg/decks"
          class="inline-flex min-h-11 items-center rounded-lg border border-pyroduck-plasma px-5 py-3 font-semibold text-pyroduck-plasma hover:border-pyroduck-lime hover:text-pyroduck-lime focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-pyroduck-lime"
        >
          My Commander decks →
        </a>

        <a
          href="/mtg/sell"
          class="inline-flex min-h-11 items-center rounded-lg border border-pyroduck-plasma px-5 py-3 font-semibold text-pyroduck-plasma hover:border-pyroduck-lime hover:text-pyroduck-lime focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-pyroduck-lime"
        >
          My Sell List →
        </a>
      </div>

      <div id="card-hunt" class="mt-10 scroll-mt-32">
        <CardSearch />
      </div>
    </div>
  </section>

  <div class="px-6 pb-16 sm:pb-24">
    <div class="mx-auto max-w-5xl">
      <ChaseList />
    </div>
  </div>
</Layout>
