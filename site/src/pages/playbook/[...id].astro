---
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("playbook");

  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={entry.data.title}>
  <article class="playbook-entry mx-auto max-w-5xl px-6 py-12 sm:py-16">
    <a href="/playbook/software-security">← Software Security</a>

    <p class="category">{entry.data.category}</p>
    <h1>{entry.data.title}</h1>
    <p class="course">{entry.data.course}</p>

    <div class="entry-content">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .playbook-entry > a {
    color: var(--color-pyroduck-plasma);
    font-weight: 700;
  }

  .category {
    margin-top: 2rem;
    color: var(--color-pyroduck-lime);
    font-weight: 700;
  }

  h1 {
    margin-top: 0.75rem;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 700;
  }

  .course {
    margin-top: 0.5rem;
    color: var(--color-brand-muted);
  }

  .entry-content {
    max-width: 48rem;
    margin-top: 2rem;
    line-height: 1.7;
  }

  .entry-content :global(h2) {
    margin-top: 2rem;
    color: var(--color-pyroduck-lime);
    font-size: 1.4rem;
    font-weight: 700;
  }

  .entry-content :global(p) {
    margin-top: 0.75rem;
  }

  .entry-content :global(ul),
  .entry-content :global(ol) {
    margin-top: 0.75rem;
    padding-left: 1.5rem;
  }

  .entry-content :global(ul) {
    list-style-type: disc;
  }

  .entry-content :global(ol) {
    list-style-type: decimal;
  }

  .entry-content :global(li) {
    margin-top: 0.35rem;
  }

  .entry-content :global(pre) {
    margin-top: 1rem;
    padding: 1rem;
    overflow-x: auto;
    border: 1px solid var(--color-pyroduck-plasma);
    border-radius: 0.5rem;
  }

  .entry-content :global(a) {
    color: var(--color-pyroduck-plasma);
    text-decoration: underline;
  }

  .playbook-entry :global(a:focus-visible) {
    outline: 2px solid var(--color-pyroduck-lime);
    outline-offset: 3px;
  }
</style>
