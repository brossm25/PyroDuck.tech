---
import Layout from "@/layouts/Layout.astro";
import DeckImport from "@/components/mtg/DeckImport.astro";
---

<Layout title="Commander Deck">
  <section class="px-6 py-12 sm:py-16" aria-labelledby="deck-heading">
    <div class="deck-editor mx-auto max-w-5xl">
      <a href="/mtg/decks">← Your decks</a>
      <h1 id="deck-heading" class="mt-8 text-4xl font-bold">Commander deck</h1>
      <p id="deck-status" role="status">Loading deck…</p>
      <p id="deck-count"></p>

      <form id="deck-settings" class="panel" hidden>
        <h2>Deck details</h2>
        <label>Deck name<input name="name" required maxlength="100" /></label>
        <label
          >Description<textarea name="description" maxlength="5000" rows="3"
          ></textarea></label
        >
        <label
          >Who can view this deck?
          <select name="visibility">
            <option value="private">Private — only you</option>
            <option value="friends">Friends — accepted friends</option>
            <option value="public">Public — anyone with the link</option>
          </select>
        </label>
        <button type="submit">Save details</button>
        <button id="delete-deck" type="button"> Delete entire deck </button>
      </form>

      <div id="deck-add" class="panel" hidden>
        <h2>Add a card</h2>
        <DeckImport />
        <form id="deck-search">
          <label for="deck-query">Card name or Scryfall search</label>
          <div class="control-row">
            <input
              id="deck-query"
              name="query"
              required
              maxlength="150"
              placeholder="Try Atla Palani"
            />
            <button type="submit">Search</button>
          </div>
        </form>
        <p id="deck-search-status" role="status"></p>
        <ul id="deck-results" class="card-grid"></ul>
        <p class="muted">
          Card information and images provided by <a
            href="https://scryfall.com"
            target="_blank"
            rel="noopener noreferrer">Scryfall ↗</a
          >.
        </p>
      </div>

      <div class="deck-summary">
        <section class="panel" aria-labelledby="commander-heading">
          <h2 id="commander-heading">Commanders</h2>
          <ul id="deck-commanders" class="card-grid"></ul>
        </section>

        <section class="panel overview-panel" aria-label="Deck overview">
          <div
            class="overview-tabs"
            role="tablist"
            aria-label="Deck information"
          >
            <button
              id="tab-overview"
              type="button"
              role="tab"
              aria-selected="true"
              aria-controls="panel-overview"
              tabindex="0">Overview</button
            >
            <button
              id="tab-value"
              type="button"
              role="tab"
              aria-selected="false"
              aria-controls="panel-value"
              tabindex="-1">Value</button
            >
            <button
              id="tab-power"
              type="button"
              role="tab"
              aria-selected="false"
              aria-controls="panel-power"
              tabindex="-1">Power indicators</button
            >
            <button
              id="tab-mana"
              type="button"
              role="tab"
              aria-selected="false"
              aria-controls="panel-mana"
              tabindex="-1">Mana</button
            >
            <button
              id="tab-checks"
              type="button"
              role="tab"
              aria-selected="false"
              aria-controls="panel-checks"
              tabindex="-1">Deck checks</button
            >
          </div>

          <div
            id="panel-overview"
            role="tabpanel"
            aria-labelledby="tab-overview"
            tabindex="0"
          >
          </div>
          <div
            id="panel-value"
            role="tabpanel"
            aria-labelledby="tab-value"
            tabindex="0"
            hidden
          >
          </div>
          <div
            id="panel-mana"
            role="tabpanel"
            aria-labelledby="tab-mana"
            tabindex="0"
            hidden
          >
          </div>

          <div
            id="panel-checks"
            role="tabpanel"
            aria-labelledby="tab-checks"
            tabindex="0"
            hidden
          >
            <p class="muted">
              Deck checks provide guidance. You can still add cards and save
              your deck when warnings are present.
            </p>
          </div>

          <div
            id="panel-power"
            role="tabpanel"
            aria-labelledby="tab-power"
            tabindex="0"
            hidden
          >
          </div>

          <button id="refresh-deck-data" type="button" hidden>
            Refresh card data
          </button>
          <p id="deck-data-status" class="muted" role="status"></p>
        </section>
      </div>

      <div class="deck-view-controls" role="group" aria-label="Card display">
        <span>Card view</span>
        <button
          type="button"
          data-card-view="compact"
          aria-controls="deck-groups"
          aria-pressed="true">Compact list</button
        >
        <button
          type="button"
          data-card-view="grid"
          aria-controls="deck-groups"
          aria-pressed="false">Grid</button
        >
      </div>

      <div id="deck-groups" data-view="compact"></div>

      <p class="muted">
        The deck count includes commanders. Open Deck checks to review warnings
        about deck size, color restrictions, copy limits, commander selections,
        and saved Commander legality. Some special cases are not fully checked.
        Warnings do not prevent saving; your pod can agree to house rules.
      </p>
    </div>
  </section>

  <dialog id="missing-prices" aria-labelledby="missing-prices-heading">
    <form method="dialog" class="missing-prices-close">
      <button autofocus>Close ×</button>
    </form>

    <h2 id="missing-prices-heading">Missing prices</h2>

    <p class="missing-prices-help">
      Estimates are in USD per copy. Your estimate stays unchanged until you
      edit it. If a later refresh finds a Scryfall price, that price takes
      priority.
    </p>

    <p id="missing-prices-status" role="status"></p>
    <ul id="missing-prices-list"></ul>
  </dialog>

  <dialog id="card-preview" aria-labelledby="card-preview-heading">
    <form method="dialog" class="preview-close">
      <button autofocus>Close ×</button>
    </form>

    <h2 id="card-preview-heading"></h2>

    <div id="card-preview-art" class="card-art">
      <img id="card-preview-image" alt="" width="488" height="680" />
      <button
        id="card-preview-flip"
        type="button"
        aria-label="Show back face"
        aria-controls="card-preview-image"
        title="Show back face"
        hidden
      >
        <svg
          viewBox="0 0 24 24"
          width="26"
          height="26"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20 7v5h-5M4 17v-5h5"></path>
          <path d="M6.1 7a7 7 0 0 1 11.6-1L20 12"></path>
          <path d="M17.9 17a7 7 0 0 1-11.6 1L4 12"></path>
        </svg>
      </button>
    </div>

    <div
      id="card-preview-faces"
      class="preview-faces"
      role="group"
      aria-label="Card faces"
    >
    </div>
  </dialog>

  <dialog id="deck-picker" aria-labelledby="picker-heading">
    <form method="dialog"><button autofocus>Close ×</button></form>
    <h2 id="picker-heading">Choose printing</h2>
    <p id="picker-status" role="status"></p>
    <form id="picker-add">
      <label>Printing<select id="picker-printing" required></select></label>
      <div id="picker-art" class="card-art" hidden>
        <img id="picker-image" alt="" width="488" height="680" hidden />
      </div>
      <label>Finish<select id="picker-finish" required></select></label>
      <label>
        Add to
        <select id="picker-role">
          <option value="main">Main deck</option>
          <option value="commander">Commander</option>
          <option value="sideboard">Sideboard</option>
          <option value="maybeboard">Maybeboard</option>
        </select>
      </label>
      <label
        >Quantity<input
          id="picker-quantity"
          type="number"
          min="1"
          max="1000"
          step="1"
          value="1"
          required
        /></label
      >
      <label class="proxy-option">
        <input id="picker-proxy" type="checkbox" />
        This card is a proxy
      </label>
      <button id="picker-save" type="submit" disabled>Add to deck</button>
    </form>
  </dialog>
</Layout>

<script>
  import { supabase } from "@/lib/supabase";
  import { checkDeck } from "@/lib/deckChecks";
  import { loadAllPages } from "@/lib/paginate";
  import { renderManaCost } from "@/lib/renderManaCost";
  import { renderDeckOverview } from "@/lib/deckOverview";
  import { createDeckCardPreview } from "@/lib/deckCardPreview";
  import { createDeckEntryEditor } from "@/lib/deckEntryEditor";
  import { sectionNames, sectionFor } from "@/lib/deckSections";
  import { createDeckPicker } from "@/lib/deckPicker";
  import { createAccountChangeGuard } from "@/lib/authAccountGuard";
  import { cardData, type DeckCard as Card } from "@/lib/deckCardData";
  import { setupDeckImport } from "@/lib/deckImportUI";
  import {
    money,
    effectivePrice,
    quantityOf,
    safeCardImage,
  } from "@/lib/mtgFormat";
  import { renderDeckCombos, resetDeckCombos } from "@/lib/deckCombosUI";

  let deckImporter: ReturnType<typeof setupDeckImport> | undefined;

  interface Deck {
    id: string;
    user_id: string;
    name: string;
    description: string;
    visibility: string;
  }
  interface SavedFace {
    name: string;
    image_url: string | null;
    oracle_text: string;
  }
  interface Entry {
    id: string;
    scryfall_id: string;
    name: string;
    set_name: string;
    collector_number: string;
    finish: string;
    is_proxy: boolean;
    quantity: number;
    card_role: string;
    image_url: string | null;
    oracle_text: string | null;
    card_faces: SavedFace[] | null;
    type_line: string | null;
    mana_cost: string | null;
    mana_value: number | null;
    colors: string[] | null;
    color_identity: string[] | null;
    game_changer: boolean | null;
    power_checked_at: string | null;
    commander_legality: "legal" | "not_legal" | "restricted" | "banned" | null;
    legality_checked_at: string | null;
    price_usd: number | string | null;
    price_checked_at: string | null;
    manual_price_usd: number | string | null;
    manual_price_updated_at: string | null;
  }

  interface Page {
    data: Card[];
    has_more: boolean;
    next_page?: string;
  }
  const get = <T extends HTMLElement>(id: string) =>
    document.getElementById(id) as T;
  const settings = get<HTMLFormElement>("deck-settings");
  const search = get<HTMLFormElement>("deck-search");
  const picker = get<HTMLDialogElement>("deck-picker");
  const printing = get<HTMLSelectElement>("picker-printing");
  const finish = get<HTMLSelectElement>("picker-finish");
  const role = get<HTMLSelectElement>("picker-role");
  const quantity = get<HTMLInputElement>("picker-quantity");
  const image = get<HTMLImageElement>("picker-image");
  const pickerArt = get<HTMLDivElement>("picker-art");
  const proxy = get<HTMLInputElement>("picker-proxy");
  const save = get<HTMLButtonElement>("picker-save");
  const deckId = new URLSearchParams(location.search).get("id");
  let deck: Deck | null = null;
  let owner = false;
  let busy = false;
  let version = 0;
  let savedEntries: Entry[] = [];
  let editingPrintingEntry: Entry | null = null;

  picker.addEventListener("close", () => {
    editingPrintingEntry = null;
  });

  const cardViewButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-card-view]"),
  );

  function setCardView(view: "grid" | "compact") {
    get("deck-groups").dataset.view = view;

    for (const button of cardViewButtons) {
      button.setAttribute(
        "aria-pressed",
        String(button.dataset.cardView === view),
      );
    }
  }

  let initialCardView: "grid" | "compact" = "compact";

  try {
    if (localStorage.getItem("binderlink-card-view") === "grid") {
      initialCardView = "grid";
    }
  } catch {
    // Default to Compact when browser storage is unavailable.
  }

  setCardView(initialCardView);

  for (const button of cardViewButtons) {
    button.addEventListener("click", () => {
      const view = button.dataset.cardView === "compact" ? "compact" : "grid";
      setCardView(view);

      try {
        localStorage.setItem("binderlink-card-view", view);
      } catch {
        // Keep the selected view for this visit.
      }
    });
  }

  const openCardPreview = createDeckCardPreview({
    dialog: get<HTMLDialogElement>("card-preview"),
    image: get<HTMLImageElement>("card-preview-image"),
    art: get<HTMLDivElement>("card-preview-art"),
    faces: get<HTMLDivElement>("card-preview-faces"),
    flip: get<HTMLButtonElement>("card-preview-flip"),
    heading: get("card-preview-heading"),
  });

  const missingPrices = get<HTMLDialogElement>("missing-prices");
  let missingPriceIds = new Set<string>();

  function openMissingPrices(label: string, cards: Entry[]) {
    missingPriceIds = new Set(cards.map((entry) => entry.id));
    get("missing-prices-heading").textContent = `Missing prices · ${label}`;
    get("missing-prices-status").textContent = "";

    renderMissingPrices();
    missingPrices.showModal();
  }

  function renderMissingPrices() {
    const list = get<HTMLUListElement>("missing-prices-list");
    list.replaceChildren();

    const entries = savedEntries.filter(
      (entry) =>
        missingPriceIds.has(entry.id) && effectivePrice(entry).amount === null,
    );

    if (!entries.length) {
      const empty = document.createElement("li");
      empty.textContent = "All cards in this section now have a price.";
      list.append(empty);
      return;
    }

    for (const entry of entries) {
      const item = document.createElement("li");
      item.className = "missing-price-card";

      const url = safeCardImage(entry.image_url);

      if (url) {
        const image = document.createElement("img");
        image.src = url;
        image.alt = entry.name;
        image.width = 488;
        image.height = 680;
        image.loading = "lazy";
        item.append(image);
      }

      const information = document.createElement("div");
      information.className = "missing-price-information";

      const name = document.createElement("h3");
      name.textContent = entry.name;

      const printing = document.createElement("p");
      printing.textContent = `${entry.set_name} #${entry.collector_number} · ${entry.finish}`;

      const detail = document.createElement("p");
      detail.textContent =
        `${entry.quantity} ${entry.quantity === 1 ? "copy" : "copies"} · ` +
        (entry.is_proxy ? "Proxy" : "Owned");

      information.append(name, printing, detail);

      if (owner) {
        const form = document.createElement("form");
        form.className = "missing-price-form";

        const label = document.createElement("label");
        label.textContent = "Estimate per copy (USD)";

        const input = document.createElement("input");
        input.type = "number";
        input.min = "0";
        input.max = "99999999.99";
        input.step = "0.01";
        input.inputMode = "decimal";
        input.placeholder = "0.00";
        input.required = true;

        label.append(input);

        const button = document.createElement("button");
        button.type = "submit";
        button.textContent = "Save estimate";

        form.append(label, button);

        form.addEventListener("submit", (event) => {
          event.preventDefault();
          if (!owner || busy || !form.reportValidity()) return;

          const raw = input.value.trim();
          const amount = Number(raw);

          if (
            !raw ||
            !Number.isFinite(amount) ||
            amount < 0 ||
            amount > 99999999.99
          ) {
            get("missing-prices-status").textContent =
              "Enter a valid estimate.";
            input.focus();
            return;
          }

          const expectedVersion = version;
          get("missing-prices-status").textContent =
            `Saving estimate for ${entry.name}…`;

          void mutate(async () => {
            const { data, error } = await supabase
              .from("deck_cards")
              .update({
                manual_price_usd: amount,
                manual_price_updated_at: new Date().toISOString(),
              })
              .eq("id", entry.id)
              .eq("deck_id", deckId!)
              .select("id");

            if (error) throw error;
            if (!data?.length) throw new Error("Estimate was not saved.");
            if (expectedVersion !== version) return;

            await loadEntries();
            if (expectedVersion !== version) return;

            if (missingPrices.open) renderMissingPrices();

            get("missing-prices-status").textContent =
              `Saved ${money(amount)} per copy for ${entry.name}.`;
            message(`Estimate saved for ${entry.name}.`);
          });
        });

        information.append(form);
      }

      item.append(information);
      list.append(item);
    }

    controls();
  }

  function addNote(parent: HTMLElement, text: string) {
    const note = document.createElement("p");
    note.className = "muted";
    note.textContent = text;
    parent.append(note);
  }

  function renderPowerIndicators(entries: Entry[]) {
    resetDeckCombos();
    const panel = get("panel-power");
    panel.replaceChildren();

    const heading = document.createElement("h3");
    heading.textContent = "Power indicators";
    panel.append(heading);

    addNote(
      panel,
      "Includes commanders and main-deck cards, including proxies. " +
        "Sideboard and maybeboard are excluded. These indicators do not assign a bracket.",
    );

    const active = entries.filter(
      (entry) => entry.card_role === "main" || entry.card_role === "commander",
    );

    function category(
      label: string,
      cards: Entry[],
      incomplete: boolean,
      explanation: string,
    ) {
      const details = document.createElement("details");
      const summary = document.createElement("summary");
      summary.textContent =
        `${label}: ${quantityOf(cards)}` + (incomplete ? " · incomplete" : "");
      details.append(summary);

      addNote(details, explanation);

      if (cards.length) {
        const list = document.createElement("ul");

        for (const entry of cards) {
          const item = document.createElement("li");
          item.textContent =
            `${entry.quantity} × ${entry.name} — ` +
            `${entry.set_name} #${entry.collector_number} · ${entry.finish}` +
            (entry.is_proxy ? " · Proxy" : "");
          list.append(item);
        }

        details.append(list);
      } else {
        addNote(
          details,
          incomplete
            ? "No matches found among checked cards."
            : "No matches found.",
        );
      }

      panel.append(details);
    }

    const unknownGameChangers = active.filter(
      (entry) =>
        typeof entry.game_changer !== "boolean" || !entry.power_checked_at,
    );

    category(
      "Game Changers",
      active.filter((entry) => entry.game_changer === true),
      unknownGameChangers.length > 0,
      "Uses the saved Scryfall Game Changer flag.",
    );

    if (unknownGameChangers.length) {
      addNote(
        panel,
        `${unknownGameChangers.length} active card entries need Game Changer data. ` +
          "Refresh card data to complete this count.",
      );
    }

    const fastManaNames = new Set([
      "ancient tomb",
      "black lotus",
      "chrome mox",
      "city of traitors",
      "dark ritual",
      "grim monolith",
      "jeweled lotus",
      "lion's eye diamond",
      "lotus petal",
      "mana crypt",
      "mana vault",
      "mox amber",
      "mox diamond",
      "mox emerald",
      "mox jet",
      "mox opal",
      "mox pearl",
      "mox ruby",
      "mox sapphire",
      "sol ring",
    ]);

    const fastMana = active.filter((entry) =>
      fastManaNames.has(entry.name.trim().toLowerCase().replace(/[’‘]/g, "'")),
    );

    category(
      "Fast Mana · starter list",
      fastMana,
      false,
      "Matches an explicit, incomplete list of fast-mana cards. " +
        "Conditional sources and one-use mana are included. " +
        "Banned cards still count when present; legality warnings are separate. " +
        "This count does not assign a bracket.",
    );

    const missingRules = active.filter(
      (entry) => entry.oracle_text === null,
    ).length;

    function rulesText(entry: Entry) {
      return (entry.oracle_text ?? "")
        .replace(/\([^)]*\)/g, "")
        .replace(/\s+/g, " ")
        .toLowerCase();
    }

    const massLandDenialNames = new Set([
      "armageddon",
      "blood moon",
      "ruination",
      "sunder",
      "winter orb",
    ]);

    const massLandDenial = active.filter((entry) =>
      massLandDenialNames.has(entry.name.trim().toLowerCase()),
    );

    category(
      "Mass Land Denial · starter list",
      massLandDenial,
      false,
      "Matches five examples named in Wizards’ Commander bracket guidance: " +
        "Armageddon, Blood Moon, Ruination, Sunder, and Winter Orb. " +
        "This list is incomplete and includes restrictions on using lands, " +
        "not just land destruction. A count of zero does not rule out " +
        "other land-denial effects or combinations.",
    );

    const extraTurns = active.filter((entry) => {
      const text = rulesText(entry);
      const grants = text.matchAll(
        /\b(?:take|takes|taking|get|gets|gain|gains) (?:an?|one|two|three|four|five|x|that many) extra turns?\b/g,
      );

      for (const match of grants) {
        const before = text.slice(0, match.index);

        // Ignore replacement and prevention wording.
        if (
          /\b(?:would|can't|cannot|can not|don't|doesn't|do not|does not)\s*$/.test(
            before,
          )
        ) {
          continue;
        }

        return true;
      }

      return false;
    });

    category(
      "Extra Turns · text estimate",
      extraTurns,
      missingRules > 0,
      "Estimates effects that grant extra turns from common rules wording, " +
        "including conditional effects and turns granted to other players. " +
        "Filters out common prevention and replacement wording. " +
        "Unusual wording may be missed or misclassified; review the listed cards.",
    );

    function tutorSearches(entry: Entry): string[] {
      const text = rulesText(entry).replace(/[’‘]/g, "'");
      const searches = text.matchAll(
        /\bsearch (?:your library(?: and\/or (?:your )?graveyard)?|your graveyard and\/or (?:your )?library) for ([^.]+)/g,
      );

      const targets: string[] = [];

      for (const match of searches) {
        const before = text.slice(0, match.index);

        if (
          /\b(?:can't|cannot|can not|don't|doesn't|do not|does not)\s*$/.test(
            before,
          )
        ) {
          continue;
        }

        targets.push(match[1]);
      }

      return targets;
    }

    function isLandOnlySearch(target: string): boolean {
      const selection = target
        .split(",")[0]
        .replace(/\s+(?:and\s+)?(?:reveal|put|shuffle)\b.*$/, "")
        .trim();

      return /^(?:(?:a|an|one|two|three|four|five|six|seven|eight|nine|ten|\d+|x|up to (?:one|two|three|four|five|six|seven|eight|nine|ten|\d+|x)|any number of)\s+)?(?:basic\s+)?(?:land|plains|island|swamp|mountain|forest)(?:\s+(?:or|and|and\/or)\s+(?:basic\s+)?(?:land|plains|island|swamp|mountain|forest))*\s+cards?$/.test(
        selection,
      );
    }

    const tutors = active.filter((entry) => {
      const text = rulesText(entry);

      if (/\b(?:transmute|transfigure)\b/.test(text)) {
        return true;
      }

      return tutorSearches(entry).some((target) => !isLandOnlySearch(target));
    });

    const universalTutors = tutors.filter((entry) =>
      tutorSearches(entry).some((target) =>
        /^(?:a card|up to one card)(?=\s*[,.;]|$)/.test(target),
      ),
    );

    category(
      "Tutors · text estimate",
      tutors,
      missingRules > 0,
      "Estimates searches of your library, including combined library " +
        "and graveyard searches, plus Transmute and Transfigure. " +
        "Excludes common land-only searches. Other keyword abilities " +
        "and unusual wording may be missed or misclassified. Review the listed cards.",
    );

    category(
      "Universal Tutors · text estimate",
      universalTutors,
      missingRules > 0,
      "A subset of Tutors that explicitly searches for “a card” without " +
        "a type restriction in that phrase. Costs, conditions, and " +
        "where the card goes still vary. Review the listed cards.",
    );

    if (missingRules) {
      addNote(
        panel,
        `${missingRules} active card entries are missing rules text. ` +
          "Refresh card data to improve the tutor estimates.",
      );
    }

    addNote(
      panel,
      "Counts copies, so duplicate printings count together. Categories " +
        "can overlap. Refresh card data to update saved information.",
    );

    const comboVersion = version;
    renderDeckCombos(panel, entries, () => version === comboVersion);
  }

  function renderOverview(entries: Entry[]) {
    renderDeckOverview(entries, {
      overview: get("panel-overview"),
      value: get("panel-value"),
      mana: get("panel-mana"),
      sectionNames,
      sectionFor,
      openMissingPrices,
    });

    renderPowerIndicators(entries);
    get("refresh-deck-data").hidden = !owner;
  }

  const overviewTabs = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".overview-tabs [role='tab']"),
  );

  function activateOverviewTab(selected: HTMLButtonElement) {
    for (const tab of overviewTabs) {
      const active = tab === selected;
      tab.setAttribute("aria-selected", String(active));
      tab.tabIndex = active ? 0 : -1;
      get(tab.getAttribute("aria-controls")!).hidden = !active;
    }
  }

  overviewTabs.forEach((tab, index) => {
    tab.addEventListener("click", () => activateOverviewTab(tab));

    tab.addEventListener("keydown", (event) => {
      let next = index;

      if (event.key === "ArrowRight") next = (index + 1) % overviewTabs.length;
      else if (event.key === "ArrowLeft")
        next = (index - 1 + overviewTabs.length) % overviewTabs.length;
      else if (event.key === "Home") next = 0;
      else if (event.key === "End") next = overviewTabs.length - 1;
      else return;

      event.preventDefault();
      activateOverviewTab(overviewTabs[next]);
      overviewTabs[next].focus();
    });
  });

  let searchController: AbortController | undefined;
  const imageFor = (card: Card) =>
    card.image_uris?.normal ?? card.card_faces?.[0]?.image_uris?.normal;
  const message = (text: string) => {
    get("deck-status").textContent = text;
  };
  const errorText = (error: unknown) =>
    typeof error === "object" && error !== null && "message" in error
      ? String(error.message)
      : "Something went wrong. Please try again.";

  function controls() {
    document
      .querySelectorAll<
        | HTMLButtonElement
        | HTMLInputElement
        | HTMLSelectElement
        | HTMLTextAreaElement
      >(
        "#deck-settings input, #deck-settings textarea, #deck-settings select, #deck-settings button, #deck-add input, #deck-add button, .entry-actions button, .entry-actions input, .entry-actions select, #refresh-deck-data, #picker-add input, #picker-add select, #picker-save",
      )
      .forEach((element) => {
        element.disabled = busy || !owner;
      });
    document
      .querySelectorAll<HTMLInputElement | HTMLButtonElement>(
        "#missing-prices-list input, #missing-prices-list button",
      )
      .forEach((element) => {
        element.disabled = busy || !owner;
      });
    deckPicker.sync();
    deckImporter?.sync();
  }

  async function requireOwner(expectedVersion: number) {
    const {
      data: { session },
      error,
    } = await supabase.auth.getSession();
    if (error) throw error;
    if (
      expectedVersion !== version ||
      !deck ||
      session?.user.id !== deck.user_id
    )
      throw new Error("Your sign-in changed. Refresh the page.");
  }

  async function mutate(action: () => Promise<void>) {
    if (!owner || busy) return;
    const current = version;
    busy = true;
    controls();
    try {
      await requireOwner(current);
      await action();
    } catch (error) {
      if (current === version) {
        message(errorText(error));
        if (picker.open) get("picker-status").textContent = errorText(error);
        if (missingPrices.open) {
          get("missing-prices-status").textContent = errorText(error);
        }
      }
    } finally {
      busy = false;
      controls();
    }
  }

  function renderEntries(entries: Entry[]) {
    savedEntries = entries;

    const commanders = get("deck-commanders");
    const groups = get("deck-groups");
    commanders.replaceChildren();
    groups.replaceChildren();

    const active = entries.filter(
      (entry) => entry.card_role === "main" || entry.card_role === "commander",
    );

    get("deck-count").textContent =
      `${quantityOf(active)} / 100 cards · ${deck?.visibility ?? ""}`;

    const lists = new Map<string, HTMLElement>([["Commanders", commanders]]);

    for (const section of sectionNames) {
      const sectionEntries = entries.filter(
        (entry) => sectionFor(entry) === section,
      );

      if (
        !sectionEntries.length &&
        !["Sideboard", "Maybeboard"].includes(section)
      ) {
        continue;
      }

      const extra = section === "Sideboard" || section === "Maybeboard";
      const container = document.createElement("details");
      container.open = !extra;
      container.className = "panel";

      const heading = document.createElement("summary");
      heading.textContent = `${section} (${quantityOf(sectionEntries)})`;

      const list = document.createElement("ul");
      list.className = "card-grid";

      container.append(heading, list);
      groups.append(container);
      lists.set(section, list);
    }

    renderOverview(entries);
    const checks = checkDeck(entries);
    const checksTab = get("tab-checks");
    checksTab.replaceChildren(document.createTextNode("Deck checks"));

    if (checks.warnings.size) {
      const badge = document.createElement("span");
      badge.className = "deck-check-badge";
      badge.setAttribute("aria-hidden", "true");
      badge.textContent = `! ${checks.warnings.size}`;
      checksTab.append(badge);
    }

    checksTab.setAttribute(
      "aria-label",
      checks.warnings.size
        ? `Deck checks: ${checks.warnings.size} card entries need attention`
        : "Deck checks",
    );
    const checksPanel = get("panel-checks");
    checksPanel.replaceChildren();

    const checksHeading = document.createElement("h3");
    checksHeading.textContent = "Commander deck checks";
    checksPanel.append(checksHeading);

    for (const text of checks.notes) {
      const note = document.createElement("p");
      note.className = "muted";
      note.textContent = text;
      checksPanel.append(note);
    }

    if (checks.warnings.size) {
      const warningHeading = document.createElement("h3");
      warningHeading.textContent = `${checks.warnings.size} card entries need attention`;
      checksPanel.append(warningHeading);

      const warningList = document.createElement("ul");
      warningList.className = "deck-check-list";

      for (const entry of entries) {
        const messages = checks.warnings.get(entry.id);
        if (!messages) continue;

        const warning = document.createElement("li");
        warning.textContent =
          `${entry.name} (${entry.set_name} #${entry.collector_number}, ` +
          `${entry.finish}): ${messages.join(" ")}`;
        warningList.append(warning);
      }

      checksPanel.append(warningList);
    } else {
      const note = document.createElement("p");
      note.className = "muted";
      note.textContent =
        "No card warnings found by the checks currently available.";
      checksPanel.append(note);
    }
    for (const entry of entries) {
      const item = document.createElement("li");
      item.className = "entry";
      const imageUrl = safeCardImage(entry.image_url);

      if (imageUrl) {
        const art = document.createElement("div");
        art.className = "card-art";
        art.dataset.finish = entry.finish;

        const img = document.createElement("img");
        img.src = imageUrl;
        img.alt = entry.name;
        img.loading = "lazy";
        img.width = 488;
        img.height = 680;

        art.append(img);

        const previewButton = document.createElement("button");
        previewButton.type = "button";
        previewButton.className = "card-preview-trigger";
        previewButton.setAttribute("aria-label", `Enlarge ${entry.name}`);
        previewButton.setAttribute("aria-haspopup", "dialog");
        previewButton.addEventListener("click", () =>
          openCardPreview(entry, previewButton),
        );

        previewButton.append(art);
        item.append(previewButton);
      }
      const information = document.createElement("div");
      information.className = "entry-information";

      const heading = document.createElement("h3");
      heading.textContent = `${entry.quantity} × ${entry.name}`;

      const meta = document.createElement("p");
      meta.className = "entry-meta";
      meta.textContent = `${entry.set_name} #${entry.collector_number} · ${entry.finish}`;

      const manaCost = document.createElement("p");
      manaCost.className = "entry-mana";
      renderManaCost(manaCost, entry.mana_cost);

      information.append(heading, meta, manaCost);
      for (const text of checks.warnings.get(entry.id) ?? []) {
        const warning = document.createElement("p");
        warning.className = "deck-card-warning";

        const symbol = document.createElement("span");
        symbol.className = "deck-warning-symbol";
        symbol.setAttribute("aria-hidden", "true");
        symbol.textContent = "!";

        const label = document.createElement("span");
        label.textContent = `Deck warning: ${text}`;

        warning.append(symbol, label);
        information.append(warning);
      }
      item.append(information);
      const price = effectivePrice(entry);
      const priceLabel = document.createElement("p");
      priceLabel.className = "entry-price";

      priceLabel.textContent =
        price.amount === null
          ? "Price unavailable"
          : `${money(price.amount)} per copy · ${
              price.manual ? "Manual estimate" : "Scryfall"
            }`;

      information.append(priceLabel);

      const rules = document.createElement("div");
      rules.className = "entry-rules";

      const rulesText = document.createElement("p");
      rulesText.id = `rules-${entry.id}`;
      rulesText.className = "entry-rules-text";

      if (entry.oracle_text === null || entry.oracle_text === undefined) {
        rulesText.textContent = "Refresh card data to load abilities.";
      } else if (!entry.oracle_text.trim()) {
        rulesText.textContent = "No rules text.";
      } else {
        renderManaCost(rulesText, entry.oracle_text);
      }

      rules.append(rulesText);

      if ((entry.oracle_text?.length ?? 0) > 180) {
        rules.classList.add("is-collapsed");

        const more = document.createElement("button");
        more.type = "button";
        more.className = "rules-toggle";
        more.textContent = "Show more";
        more.setAttribute("aria-expanded", "false");
        more.setAttribute("aria-controls", rulesText.id);

        more.addEventListener("click", () => {
          const collapsed = rules.classList.toggle("is-collapsed");
          more.textContent = collapsed ? "Show more" : "Show less";
          more.setAttribute("aria-expanded", String(!collapsed));
        });

        rules.append(more);
      }

      information.append(rules);

      if (price.manual && entry.manual_price_updated_at) {
        addNote(
          information,
          `Estimate entered: ${new Date(
            entry.manual_price_updated_at,
          ).toLocaleDateString()}`,
        );
      }
      if (entry.is_proxy) {
        const badge = document.createElement("span");
        badge.className = "proxy-badge";
        badge.textContent = "Proxy";
        information.append(badge);
      }
      if (owner) {
        item.append(
          createDeckEntryEditor(entry, {
            deckId: deckId!,
            isBusy: () => busy,
            mutate,
            loadEntries,
            message,
            changePrinting: () => void changeEntryPrinting(entry),
          }),
        );
      }
      lists.get(sectionFor(entry))?.append(item);
    }
    for (const group of lists.values()) {
      if (!group.children.length) {
        const empty = document.createElement("li");
        empty.textContent = "No cards added yet.";
        group.append(empty);
      }
    }
    controls();
  }

  async function loadEntries() {
    const current = version;

    const entries = await loadAllPages<Entry>(
      async (from, to) => {
        const { data, error } = await supabase
          .from("deck_cards")
          .select(
            "id, scryfall_id, name, set_name, collector_number, finish, quantity, card_role, image_url, is_proxy, type_line, mana_cost, mana_value, colors, color_identity, price_usd, price_checked_at, manual_price_usd, manual_price_updated_at, oracle_text, card_faces, commander_legality, legality_checked_at, game_changer, power_checked_at",
          )
          .eq("deck_id", deckId!)
          .order("name", { ascending: true })
          .order("id", { ascending: true })
          .range(from, to);

        return { data: data as Entry[] | null, error };
      },
      { isCurrent: () => current === version },
    );

    if (entries === null || current !== version) return;
    renderEntries(entries);
  }

  async function load() {
    resetDeckCombos();
    editingPrintingEntry = null;
    deckImporter?.reset();
    if (missingPrices.open) missingPrices.close();
    missingPriceIds.clear();
    const current = ++version;
    owner = false;
    deck = null;
    deckPicker.reset();
    searchController?.abort();
    settings.hidden = true;
    get("deck-add").hidden = true;
    get("deck-results").replaceChildren();
    get("deck-commanders").replaceChildren();
    get("deck-groups").replaceChildren();
    savedEntries = [];
    get("panel-overview").replaceChildren();
    get("panel-value").replaceChildren();
    get("panel-mana").replaceChildren();
    get("refresh-deck-data").hidden = true;
    get("deck-data-status").textContent = "";
    get("deck-count").textContent = "";
    get("deck-heading").textContent = "Commander deck";
    controls();
    message("Loading deck…");
    if (
      !deckId ||
      !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(
        deckId,
      )
    ) {
      message("Open a deck from Your decks first.");
      return;
    }
    try {
      const {
        data: { session },
        error: sessionError,
      } = await supabase.auth.getSession();
      if (sessionError) throw sessionError;
      const { data, error } = await supabase
        .from("decks")
        .select("id, user_id, name, description, visibility")
        .eq("id", deckId)
        .maybeSingle();
      if (current !== version) return;
      if (error) throw error;
      if (!data) {
        message(
          "Deck unavailable. It may be private, removed, or require signing in.",
        );
        return;
      }
      deck = data as Deck;
      owner = session?.user.id === deck.user_id;
      get("deck-heading").textContent = deck.name;
      (settings.elements.namedItem("name") as HTMLInputElement).value =
        deck.name;
      (
        settings.elements.namedItem("description") as HTMLTextAreaElement
      ).value = deck.description;
      (settings.elements.namedItem("visibility") as HTMLSelectElement).value =
        deck.visibility;
      settings.hidden = !owner;
      get("deck-add").hidden = !owner;
      await loadEntries();
      if (current === version)
        message(
          owner ? "Your changes save to this deck." : "Viewing a shared deck.",
        );
    } catch (error) {
      if (current === version) message(errorText(error));
    } finally {
      if (current === version) controls();
    }
  }

  get<HTMLButtonElement>("delete-deck").addEventListener("click", () => {
    if (!owner || busy || !deck) return;

    const targetId = deck.id;
    const targetUser = deck.user_id;
    const targetName = deck.name;
    const expectedVersion = version;

    const entered = window.prompt(
      `Permanently delete “${targetName}”?` +
        "\n\nThis deletes the entire deck, all its cards, and chase entries " +
        "linked to those cards. Standalone chase entries remain." +
        "\n\nThis cannot be undone." +
        "\n\nType the deck name exactly to delete it:",
    );

    if (entered === null) return;

    if (entered !== targetName) {
      message("Deck name did not match. Nothing was deleted.");
      return;
    }

    void mutate(async () => {
      await requireOwner(expectedVersion);

      if (deck?.id !== targetId || deck.user_id !== targetUser) {
        throw new Error("The deck changed. Refresh and try again.");
      }

      const { data, error } = await supabase
        .from("decks")
        .delete()
        .eq("id", targetId)
        .eq("user_id", targetUser)
        .select("id");

      if (error) throw error;

      if (!data?.some((item) => item.id === targetId)) {
        throw new Error("Deck was not deleted. Refresh and try again.");
      }

      window.location.assign("/mtg/decks");
    });
  });

  settings.addEventListener("submit", (event) => {
    event.preventDefault();
    const values = new FormData(settings);
    const name = String(values.get("name") ?? "").trim();
    if (!name) return;
    const description = String(values.get("description") ?? "");
    const visibility = String(values.get("visibility"));
    void mutate(async () => {
      const { data, error } = await supabase
        .from("decks")
        .update({ name, description, visibility })
        .eq("id", deckId!)
        .eq("user_id", deck!.user_id)
        .select("id");
      if (error) throw error;
      if (!data?.length)
        throw new Error("Details were not saved. Refresh and try again.");
      deck = { ...deck!, name, description, visibility };
      get("deck-heading").textContent = name;
      await loadEntries();
      message("Deck details saved.");
    });
  });

  const deckPicker = createDeckPicker<Card>({
    dialog: picker,
    printing,
    finish,
    role,
    quantity,
    proxy,
    image,
    art: pickerArt,
    save,
    status: get("picker-status"),
    canEdit: () => owner && !busy,
    getVersion: () => version,
    imageFor,
    errorText,
  });

  async function changeEntryPrinting(entry: Entry) {
    if (!owner || busy) return;

    const expectedVersion = version;
    let sourceCard: Card | null = null;

    await mutate(async () => {
      message(`Loading printings for ${entry.name}…`);

      const controller = new AbortController();
      const timer = window.setTimeout(() => controller.abort(), 15000);

      try {
        const response = await fetch(
          `https://api.scryfall.com/cards/${encodeURIComponent(entry.scryfall_id)}`,
          {
            signal: controller.signal,
            headers: { Accept: "application/json" },
          },
        );

        if (!response.ok) {
          throw new Error("Couldn’t load this card. Try again shortly.");
        }

        const card = (await response.json()) as Card;

        if (card.id !== entry.scryfall_id) {
          throw new Error("The returned printing did not match.");
        }

        await requireOwner(expectedVersion);
        sourceCard = card;
      } finally {
        window.clearTimeout(timer);
      }
    });

    if (!sourceCard || expectedVersion !== version || !owner || busy) {
      return;
    }

    editingPrintingEntry = entry;

    await deckPicker.choose(sourceCard, {
      printingId: entry.scryfall_id,
      finish: entry.finish,
      quantity: entry.quantity,
      role: entry.card_role,
      isProxy: entry.is_proxy,
    });
  }

  search.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (busy || !owner) return;
    const query = get<HTMLInputElement>("deck-query").value.trim();
    if (!query) return;
    const current = version;
    searchController?.abort();
    const controller = new AbortController();
    searchController = controller;
    const results = get("deck-results");
    results.replaceChildren();
    get("deck-search-status").textContent = "Searching…";
    try {
      const endpoint = new URL("https://api.scryfall.com/cards/search");
      endpoint.searchParams.set("q", `(${query}) game:paper`);
      endpoint.searchParams.set("unique", "cards");
      endpoint.searchParams.set("order", "name");
      const response = await fetch(endpoint, {
        signal: controller.signal,
        headers: { Accept: "application/json" },
      });
      if (current !== version || controller.signal.aborted) return;
      if (response.status === 404) {
        get("deck-search-status").textContent =
          "No cards found. Try another name.";
        return;
      }
      if (!response.ok)
        throw new Error("Search unavailable. Try again shortly.");
      const page: Page = await response.json();
      if (current !== version || controller.signal.aborted) return;
      for (const card of page.data.slice(0, 20)) {
        const li = document.createElement("li");
        li.className = "entry";
        const url = imageFor(card);
        if (url) {
          const img = document.createElement("img");
          img.src = url;
          img.alt = card.name;
          img.loading = "lazy";
          img.width = 488;
          img.height = 680;
          li.append(img);
        }
        const name = document.createElement("h3");
        name.textContent = card.name;
        const button = document.createElement("button");
        button.type = "button";
        button.textContent = "Choose printing";
        button.setAttribute("aria-haspopup", "dialog");
        button.addEventListener("click", () => void deckPicker.choose(card));
        li.append(name, button);
        results.append(li);
      }
      get("deck-search-status").textContent =
        `Showing ${Math.min(20, page.data.length)} results. Choose a printing to add a card.${page.has_more || page.data.length > 20 ? " Narrow your search for other matches." : ""}`;
      controls();
    } catch (error) {
      if (!controller.signal.aborted && current === version)
        get("deck-search-status").textContent = errorText(error);
    }
  });

  get<HTMLFormElement>("picker-add").addEventListener("submit", (event) => {
    event.preventDefault();
    const card = deckPicker.selectedCard();
    const target = editingPrintingEntry;

    if (target) {
      if (!card || !card.finishes.includes(finish.value)) return;

      const selectedFinish = finish.value;
      const expectedVersion = version;

      void mutate(async () => {
        const { data, error } = await supabase.rpc(
          "change_deck_card_printing",
          {
            p_entry_id: target.id,
            p_expected_scryfall_id: target.scryfall_id,
            p_expected_finish: target.finish,
            p_printing: {
              scryfall_id: card.id,
              oracle_id: card.oracle_id ?? null,
              name: card.name,
              set_name: card.set_name,
              collector_number: card.collector_number,
              finish: selectedFinish,
              image_url: imageFor(card) ?? null,
              scryfall_uri: card.scryfall_uri,
              ...cardData(card, selectedFinish),
            },
          },
        );

        if (error?.code === "23505") {
          throw new Error(
            "That printing and finish already exists in this section. No cards were changed.",
          );
        }

        if (error) throw error;
        if (data !== target.id) {
          throw new Error(
            "Couldn’t confirm the saved printing. Reload the deck.",
          );
        }

        if (expectedVersion !== version) return;

        editingPrintingEntry = null;
        picker.close();

        try {
          await loadEntries();
          if (expectedVersion === version) {
            message(`Printing updated for ${target.name}.`);
          }
        } catch {
          if (expectedVersion === version) {
            message(
              "Printing saved, but the deck could not refresh. Reload the page.",
            );
          }
        }
      });

      return;
    }
    const amount = Number(quantity.value);
    if (
      !card ||
      !card.finishes.includes(finish.value) ||
      !Number.isInteger(amount) ||
      amount < 1 ||
      amount > 1000
    )
      return;
    const selectedFinish = finish.value;
    const selectedRole = role.value;
    const selectedProxy = proxy.checked;
    void mutate(async () => {
      const { data, error } = await supabase
        .from("deck_cards")
        .insert({
          deck_id: deckId,
          scryfall_id: card.id,
          oracle_id: card.oracle_id ?? null,
          name: card.name,
          set_name: card.set_name,
          collector_number: card.collector_number,
          finish: selectedFinish,
          quantity: amount,
          card_role: selectedRole,
          is_proxy: selectedProxy,
          ...cardData(card, selectedFinish),
          image_url: imageFor(card) ?? null,
          scryfall_uri: card.scryfall_uri,
        })
        .select("id")
        .single();
      if (error?.code === "23505") {
        const { data: updatedId, error: quantityError } = await supabase.rpc(
          "add_deck_card_copies",
          {
            p_deck_id: deckId,
            p_scryfall_id: card.id,
            p_finish: selectedFinish,
            p_card_role: selectedRole,
            p_quantity: amount,
            p_is_proxy: selectedProxy,
          },
        );

        if (quantityError) throw quantityError;
        if (!updatedId)
          throw new Error("Couldn’t confirm the quantity update.");
      } else {
        if (error) throw error;
        if (!data) throw new Error("Card was not added.");
      }
      picker.close();
      searchController?.abort();
      search.reset();
      get("deck-results").replaceChildren();
      get("deck-search-status").textContent = "";
      try {
        await loadEntries();
        message(
          `Added ${amount} ${amount === 1 ? "copy" : "copies"} of ${card.name}.`,
        );
      } catch {
        message(
          "Copies saved, but the deck could not refresh. Reload the page before adding again.",
        );
      }
    });
  });

  get("refresh-deck-data").addEventListener("click", () => {
    const entries = [...savedEntries];
    const expectedVersion = version;

    void mutate(async () => {
      const cache = new Map<string, Card>();
      let updated = 0;
      let failure = "";

      try {
        for (const entry of entries) {
          await requireOwner(expectedVersion);

          get("deck-data-status").textContent =
            `Updating ${updated + 1} of ${entries.length}: ${entry.name}…`;

          let card = cache.get(entry.scryfall_id);

          if (!card) {
            const controller = new AbortController();
            const timer = window.setTimeout(() => controller.abort(), 15000);

            try {
              const response = await fetch(
                `https://api.scryfall.com/cards/${encodeURIComponent(entry.scryfall_id)}`,
                {
                  signal: controller.signal,
                  headers: { Accept: "application/json" },
                },
              );

              if (!response.ok) {
                throw new Error(
                  response.status === 429
                    ? "Scryfall asked us to slow down. Try again later."
                    : `Couldn’t retrieve ${entry.name}. Try again later.`,
                );
              }

              card = (await response.json()) as Card;

              if (card.id !== entry.scryfall_id) {
                throw new Error("The returned printing did not match.");
              }

              cache.set(entry.scryfall_id, card);
            } finally {
              window.clearTimeout(timer);
            }

            await new Promise((resolve) => window.setTimeout(resolve, 150));
          }

          await requireOwner(expectedVersion);

          const { data, error } = await supabase
            .from("deck_cards")
            .update(cardData(card, entry.finish))
            .eq("id", entry.id)
            .eq("deck_id", deckId!)
            .eq("scryfall_id", entry.scryfall_id)
            .eq("finish", entry.finish)
            .select("id");

          if (error) throw error;
          if (!data?.length) {
            throw new Error(
              "A card changed or was removed. Refresh and try again.",
            );
          }

          updated++;
        }
      } catch (error) {
        failure = errorText(error);
      }

      if (expectedVersion !== version) return;

      await loadEntries();
      get("deck-data-status").textContent =
        `Updated ${updated} of ${entries.length} entries.${
          failure ? ` ${failure}` : " Card data and prices are current."
        }`;
    });
  });

  const accountChanged = createAccountChangeGuard();

  supabase.auth.onAuthStateChange((event, session) => {
    if (!accountChanged(event, session)) return;

    window.setTimeout(() => void load(), 0);
  });

  deckImporter = setupDeckImport({
    canEdit: () => owner && !busy,

    existing: () => savedEntries,

    save: async (reviewed) => {
      if (!owner || busy) {
        throw new Error("Wait for the current action to finish.");
      }

      const expectedVersion = version;
      busy = true;
      controls();

      try {
        await requireOwner(expectedVersion);

        const payload = reviewed.map((item) => ({
          deck_id: deckId,
          scryfall_id: item.card.id,
          oracle_id: item.card.oracle_id ?? null,
          name: item.card.name,
          set_name: item.card.set_name,
          collector_number: item.card.collector_number,
          finish: item.finish,
          quantity: item.quantity,
          card_role: item.role,
          is_proxy: item.isProxy,
          image_url: imageFor(item.card) ?? null,
          scryfall_uri: item.card.scryfall_uri,
          ...cardData(item.card, item.finish),
        }));

        const { error } = await supabase.from("deck_cards").insert(payload);

        if (error?.code === "23505") {
          throw new Error(
            "A selected printing, finish, and role already exists in this deck. " +
              "Nothing from this import was added. Refresh and review duplicates.",
          );
        }

        if (error) throw error;

        if (expectedVersion !== version) {
          throw new Error(
            "Your sign-in changed. Reopen the deck to check the saved import.",
          );
        }

        try {
          await loadEntries();
        } catch {
          // The insert succeeded. Don’t encourage submitting it twice.
          message(
            "Cards were saved, but the deck could not refresh. Reload the page.",
          );
        }
      } finally {
        busy = false;
        controls();
      }
    },
  });
  void load();
</script>

