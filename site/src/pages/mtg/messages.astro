---
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="BinderLink Messages"
  description="Private conversations about Magic: The Gathering sale listings."
>
  <section class="px-6 py-16 sm:py-24">
    <div class="mx-auto max-w-5xl">
      <a
        href="/mtg"
        class="font-semibold text-pyroduck-plasma hover:text-pyroduck-lime"
      >
        ← Back to BinderLink
      </a>

      <h1 class="mt-10 text-4xl font-bold text-brand-text">
        Your <span class="text-pyroduck-plasma">Messages.</span>
      </h1>

      <p class="mt-4 text-brand-muted">
        Ask about cards, discuss shipping, and make offers directly with other
        players.
      </p>

      <div class="messages-app mt-8">
        <div class="inbox-toolbar">
          <h2>Your conversations</h2>
          <button type="button" class="inbox-refresh">Refresh inbox</button>
        </div>

        <p class="inbox-status" role="status" aria-live="polite">
          Checking your sign-in…
        </p>

        <div class="messages-layout">
          <nav aria-label="Conversations">
            <ul class="conversation-list"></ul>
          </nav>

          <section class="conversation-panel" hidden>
            <h2 class="conversation-title"></h2>
            <p class="conversation-details"></p>

            <div class="conversation-actions">
              <button type="button" class="conversation-hide">
                Delete conversation for me
              </button>

              <button type="button" class="thread-refresh">
                Check for replies
              </button>
            </div>

            <p class="thread-status" role="status" aria-live="polite"></p>
            <ol class="message-list" aria-label="Messages"></ol>

            <form class="message-form">
              <label for="sale-message-body">Your message</label>
              <textarea
                id="sale-message-body"
                rows="4"
                maxlength="4000"
                required
                placeholder="Ask about the card or make an offer…"></textarea>
              <button type="submit" class="message-send">Send message</button>
              <p class="send-status" role="status" aria-live="polite"></p>
            </form>
          </section>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { supabase } from "@/lib/supabase";
  import { loadAllPages } from "@/lib/paginate";
  import { createAccountChangeGuard } from "@/lib/authAccountGuard";

  interface Conversation {
    id: string;
    kind: "sale" | "friend";
    can_send: boolean;
    card_name: string;
    set_name: string;
    collector_number: string;
    finish: string;
    other_username: string | null;
    created_at: string;
  }

  interface FriendConversation {
    id: string;
    other_username: string | null;
    created_at: string;
    can_send: boolean;
  }

  interface SaleMessage {
    id: string;
    sender_id: string;
    body: string;
    created_at: string;
  }

  const root = document.querySelector<HTMLElement>(".messages-app");

  if (root) {
    const inboxStatus = root.querySelector<HTMLElement>(".inbox-status")!;
    const inboxRefresh =
      root.querySelector<HTMLButtonElement>(".inbox-refresh")!;
    const conversations =
      root.querySelector<HTMLUListElement>(".conversation-list")!;
    const panel = root.querySelector<HTMLElement>(".conversation-panel")!;
    const title = root.querySelector<HTMLElement>(".conversation-title")!;
    const details = root.querySelector<HTMLElement>(".conversation-details")!;
    const hideConversation =
      root.querySelector<HTMLButtonElement>(".conversation-hide")!;
    const threadRefresh =
      root.querySelector<HTMLButtonElement>(".thread-refresh")!;
    const threadStatus = root.querySelector<HTMLElement>(".thread-status")!;
    const messages = root.querySelector<HTMLOListElement>(".message-list")!;
    const form = root.querySelector<HTMLFormElement>(".message-form")!;
    const body = root.querySelector<HTMLTextAreaElement>("textarea")!;
    const send = root.querySelector<HTMLButtonElement>(".message-send")!;
    const sendStatus = root.querySelector<HTMLElement>(".send-status")!;

    let viewer: string | null = null;
    let selected: Conversation | null = null;
    let inboxVersion = 0;
    let threadVersion = 0;
    let sending = false;
    let authTimer: number | undefined;

    function errorMessage(error: unknown) {
      return error &&
        typeof error === "object" &&
        "message" in error &&
        typeof error.message === "string"
        ? error.message
        : "Please try again.";
    }

    function otherName(conversation: Conversation) {
      return conversation.other_username
        ? `@${conversation.other_username}`
        : "Other player";
    }

    function clearThread() {
      threadVersion++;
      selected = null;
      panel.hidden = true;
      messages.replaceChildren();
      body.value = "";
      threadStatus.textContent = "";
      sendStatus.textContent = "";
    }

    async function loadInbox() {
      const active = ++inboxVersion;
      const previous = selected?.id;
      inboxRefresh.disabled = true;
      conversations.replaceChildren();
      clearThread();
      inboxStatus.textContent = "Loading conversations…";

      try {
        const { data: auth, error: authError } =
          await supabase.auth.getSession();

        if (active !== inboxVersion) return;
        if (authError) throw authError;

        const nextViewer = auth.session?.user.id ?? null;
        const sameViewer = viewer === nextViewer;
        viewer = nextViewer;

        if (!viewer) {
          inboxStatus.textContent =
            "Sign in using the account menu above to read your messages.";
          return;
        }

        const [saleResult, friendResult, hiddenResult, unreadResult] =
          await Promise.all([
            supabase.rpc("get_my_sale_conversations"),
            supabase.rpc("get_my_friend_conversations"),
            supabase.rpc("get_my_hidden_conversations"),
            supabase.rpc("get_my_unread_conversations"),
          ]);

        if (active !== inboxVersion) return;
        if (saleResult.error) throw saleResult.error;
        if (friendResult.error) throw friendResult.error;
        if (hiddenResult.error) throw hiddenResult.error;
        if (unreadResult.error) throw unreadResult.error;

        const saleRows = (
          (saleResult.data ?? []) as Omit<Conversation, "kind" | "can_send">[]
        ).map((conversation): Conversation => ({
          ...conversation,
          kind: "sale",
          can_send: true,
        }));

        const friendRows = (
          (friendResult.data ?? []) as FriendConversation[]
        ).map((conversation): Conversation => ({
          ...conversation,
          kind: "friend",
          card_name: "",
          set_name: "",
          collector_number: "",
          finish: "",
        }));

        const hidden = new Set(
          (hiddenResult.data ?? []).map(
            (item: { conversation_kind: string; conversation_id: string }) =>
              `${item.conversation_kind}:${item.conversation_id}`,
          ),
        );

        const requestedConversation = new URL(
          window.location.href,
        ).searchParams.get("conversation");

        const rows = [...saleRows, ...friendRows]
          .filter((conversation) => {
            return (
              conversation.id === requestedConversation ||
              !hidden.has(`${conversation.kind}:${conversation.id}`)
            );
          })
          .sort((a, b) => Date.parse(b.created_at) - Date.parse(a.created_at));

        inboxStatus.textContent = rows.length
          ? "Choose a conversation. Use Check for replies to load new messages."
          : "No conversations yet. Message a friend or ask about a sale listing.";

        const unreadCounts = new Map<string, number>(
          (unreadResult.data ?? []).map(
            (item: {
              conversation_kind: string;
              conversation_id: string;
              unread_count: number | string;
            }) => [
              `${item.conversation_kind}:${item.conversation_id}`,
              Number(item.unread_count),
            ],
          ),
        );

        for (const conversation of rows) {
          const item = document.createElement("li");
          const button = document.createElement("button");
          button.type = "button";
          button.dataset.conversation = conversation.id;
          const label =
            conversation.kind === "friend"
              ? `Friend · ${otherName(conversation)}`
              : `${conversation.card_name} · ${otherName(conversation)}`;

          const unread =
            unreadCounts.get(`${conversation.kind}:${conversation.id}`) ?? 0;

          button.dataset.baseLabel = label;
          button.textContent = unread ? `${label} · ${unread} unread` : label;
          button.addEventListener("click", () => {
            void openConversation(conversation);
          });
          item.append(button);
          conversations.append(item);
        }

        const requested = new URL(window.location.href).searchParams.get(
          "conversation",
        );
        const target = rows.find(
          (row) => row.id === (sameViewer && previous ? previous : requested),
        );

        if (target) {
          await openConversation(target);
        } else if (requested && !rows.length) {
          inboxStatus.textContent =
            "This conversation is unavailable for your account.";
        }
      } catch (error) {
        if (active === inboxVersion) {
          inboxStatus.textContent = `Couldn’t load conversations: ${errorMessage(error)}`;
        }
      } finally {
        if (active === inboxVersion) inboxRefresh.disabled = false;
      }
    }

    async function openConversation(conversation: Conversation) {
      if (!viewer || sending) return;

      selected = conversation;
      panel.hidden = false;
      title.textContent =
        conversation.kind === "friend"
          ? `Conversation with ${otherName(conversation)}`
          : `${conversation.card_name} · ${otherName(conversation)}`;

      details.textContent =
        conversation.kind === "friend"
          ? conversation.can_send
            ? "Direct message"
            : "You can read this conversation, but you must be friends to send new messages."
          : `${conversation.set_name} #${conversation.collector_number} · ${conversation.finish}`;

      body.disabled = !conversation.can_send;
      send.disabled = !conversation.can_send;
      body.placeholder =
        conversation.kind === "friend"
          ? "Write a message to your friend…"
          : "Ask about the card or make an offer…";
      body.value = "";
      sendStatus.textContent = "";

      root!
        .querySelectorAll<HTMLButtonElement>("[data-conversation]")
        .forEach((button) => {
          button.setAttribute(
            "aria-pressed",
            String(button.dataset.conversation === conversation.id),
          );
        });

      const url = new URL(window.location.href);
      url.searchParams.set("conversation", conversation.id);
      window.history.replaceState(null, "", url);

      await loadThread();
    }

    async function loadThread() {
      if (!viewer || !selected) return;

      const active = ++threadVersion;
      const user = viewer;
      const conversation = selected;
      threadRefresh.disabled = true;
      threadStatus.textContent = "Loading messages…";

      try {
        const isCurrent = () =>
          active === threadVersion &&
          viewer === user &&
          selected?.id === conversation.id;

        const rows = await loadAllPages<SaleMessage>(
          async (from, to) => {
            const { data, error } = await supabase
              .from(
                conversation.kind === "friend"
                  ? "friend_messages"
                  : "sale_messages",
              )
              .select("id, sender_id, body, created_at")
              .eq("conversation_id", conversation.id)
              .order("created_at", { ascending: true })
              .order("id", { ascending: true })
              .range(from, to);

            return { data: data as SaleMessage[] | null, error };
          },
          { isCurrent },
        );

        if (rows === null || !isCurrent()) return;

        messages.replaceChildren();

        for (const message of rows) {
          const item = document.createElement("li");
          item.className =
            message.sender_id === user ? "message-own" : "message-other";

          const heading = document.createElement("p");
          heading.className = "message-meta";
          heading.textContent =
            `${message.sender_id === user ? "You" : otherName(conversation)} · ` +
            new Date(message.created_at).toLocaleString();

          const text = document.createElement("p");
          text.className = "message-body";
          text.textContent = message.body;

          item.append(heading, text);
          messages.append(item);
        }

        if (rows.length) {
          const lastMessage = rows[rows.length - 1];

          const { error: readError } = await supabase.rpc(
            "mark_conversation_read",
            {
              p_kind: conversation.kind,
              p_conversation_id: conversation.id,
              p_message_id: lastMessage.id,
            },
          );

          if (!isCurrent()) return;

          if (readError) {
            threadStatus.textContent =
              "Messages loaded, but their read status couldn’t be saved.";
            return;
          }

          const conversationButton = Array.from(
            conversations.querySelectorAll<HTMLButtonElement>(
              "[data-conversation]",
            ),
          ).find((button) => button.dataset.conversation === conversation.id);

          if (conversationButton?.dataset.baseLabel) {
            conversationButton.textContent =
              conversationButton.dataset.baseLabel;
          }

          window.dispatchEvent(new Event("messages-read"));
        }

        threadStatus.textContent = rows.length
          ? "Messages are up to date."
          : "No messages yet. Introduce yourself below.";
      } catch (error) {
        if (active === threadVersion) {
          threadStatus.textContent = `Couldn’t load messages: ${errorMessage(error)}`;
        }
      } finally {
        if (active === threadVersion) threadRefresh.disabled = false;
      }
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!viewer || !selected || sending) return;

      const text = body.value.trim();
      if (!text) {
        sendStatus.textContent = "Write a message first.";
        return;
      }

      const user = viewer;
      const conversation = selected;
      if (!conversation.can_send) return;
      const conversationId = selected.id;
      const active = inboxVersion;

      sending = true;
      send.disabled = true;
      inboxRefresh.disabled = true;
      sendStatus.textContent = "Sending…";

      try {
        const { data: auth, error: authError } =
          await supabase.auth.getSession();

        if (
          active !== inboxVersion ||
          viewer !== user ||
          selected?.id !== conversationId
        )
          return;

        if (authError) throw authError;
        if (auth.session?.user.id !== user) {
          throw new Error("Please sign in again.");
        }

        const { error } = await supabase
          .from(
            conversation.kind === "friend"
              ? "friend_messages"
              : "sale_messages",
          )
          .insert({
            conversation_id: conversationId,
            sender_id: user,
            body: text,
          });

        if (error) throw error;

        if (
          active !== inboxVersion ||
          viewer !== user ||
          selected?.id !== conversationId
        )
          return;

        body.value = "";
        sendStatus.textContent = "Message sent.";
        await loadThread();
      } catch (error) {
        if (
          active === inboxVersion &&
          viewer === user &&
          selected?.id === conversationId
        ) {
          sendStatus.textContent = `Couldn’t confirm the message was sent: ${errorMessage(error)} Check for replies before retrying.`;
        }
      } finally {
        sending = false;
        send.disabled = selected ? !selected.can_send : false;
        inboxRefresh.disabled = false;
      }
    });

    hideConversation.addEventListener("click", async () => {
      if (!viewer || !selected || sending || hideConversation.disabled) return;

      const conversation = selected;
      const user = viewer;
      const active = inboxVersion;

      const confirmed = window.confirm(
        "Remove this conversation from your inbox? " +
          "The other person will still have it. It can return if they send a new message.",
      );

      if (!confirmed) return;

      hideConversation.disabled = true;
      sendStatus.textContent = "Removing conversation from your inbox…";

      try {
        const { error } = await supabase.rpc("hide_my_conversation", {
          p_kind: conversation.kind,
          p_conversation_id: conversation.id,
        });

        if (active !== inboxVersion || viewer !== user) return;
        if (error) throw error;

        const url = new URL(window.location.href);
        url.searchParams.delete("conversation");
        window.history.replaceState(null, "", url);

        await loadInbox();
      } catch (error) {
        if (active === inboxVersion && viewer === user) {
          sendStatus.textContent = `Couldn’t remove the conversation: ${errorMessage(error)}`;
        }
      } finally {
        hideConversation.disabled = false;
      }
    });

    inboxRefresh.addEventListener("click", () => {
      if (!sending) void loadInbox();
    });

    threadRefresh.addEventListener("click", () => void loadThread());

    const accountChanged = createAccountChangeGuard();

    supabase.auth.onAuthStateChange((event, session) => {
      if (!accountChanged(event, session)) return;

      inboxVersion++;
      viewer = null;
      conversations.replaceChildren();
      clearThread();
      inboxStatus.textContent = "Checking your sign-in…";

      window.clearTimeout(authTimer);
      authTimer = window.setTimeout(() => void loadInbox(), 80);
    });

    void loadInbox();
  }
</script>

<style>
  .conversation-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .messages-app {
    padding: 1.25rem;
    border: 1px solid var(--color-pyroduck-plasma);
    border-radius: 1rem;
    background: var(--color-pyroduck-afterdark);
    color: var(--color-brand-text);
  }

  .inbox-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .messages-app h2 {
    font-size: 1.125rem;
    font-weight: 700;
  }

  .inbox-status,
  .thread-status,
  .send-status,
  .conversation-details {
    margin-block: 0.75rem;
    color: var(--color-brand-muted);
    line-height: 1.6;
  }

  .messages-layout {
    display: grid;
    gap: 1.5rem;
    margin-top: 1rem;
  }

  .conversation-list,
  .message-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .messages-app :global(button) {
    min-height: 44px;
    padding: 0.65rem 0.9rem;
    border: 1px solid var(--color-pyroduck-plasma);
    border-radius: 0.5rem;
    background: var(--color-pyroduck-void);
    color: var(--color-pyroduck-plasma);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .conversation-list :global(button) {
    width: 100%;
    text-align: left;
    overflow-wrap: anywhere;
  }

  .messages-app :global(button[aria-pressed="true"]) {
    border-color: var(--color-pyroduck-lime);
    color: var(--color-pyroduck-lime);
  }

  .messages-app :global(button:disabled) {
    opacity: 0.5;
    cursor: default;
  }

  .messages-app :global(button:focus-visible),
  textarea:focus-visible {
    outline: 2px solid var(--color-pyroduck-lime);
    outline-offset: 3px;
  }

  .message-list {
    max-height: 32rem;
    overflow-y: auto;
    margin-block: 1rem;
  }

  .message-list :global(li) {
    padding: 1rem;
    border: 1px solid var(--color-pyroduck-plasma);
    border-radius: 0.75rem;
    background: var(--color-pyroduck-void);
  }

  .message-list :global(.message-own) {
    border-color: var(--color-pyroduck-lime);
  }

  .message-list :global(.message-meta) {
    margin-bottom: 0.5rem;
    font-size: 0.8rem;
    color: var(--color-brand-muted);
  }

  .message-list :global(.message-body) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    line-height: 1.6;
  }

  .message-form {
    display: grid;
    gap: 0.75rem;
  }

  .message-form label {
    font-weight: 600;
  }

  textarea {
    width: 100%;
    resize: vertical;
    padding: 0.75rem;
    border: 1px solid var(--color-pyroduck-plasma);
    border-radius: 0.5rem;
    background: var(--color-pyroduck-void);
    color: var(--color-brand-text);
    font: inherit;
  }

  .messages-app :global([hidden]) {
    display: none !important;
  }

  @media (min-width: 768px) {
    .messages-layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    }
  }
</style>
