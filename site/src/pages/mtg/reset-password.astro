---
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Reset Password | BinderLink"
  description="Choose a new password for your BinderLink account."
>
  <section class="px-6 py-16 sm:py-24">
    <div class="reset-card mx-auto max-w-lg">
      <a href="/mtg" class="reset-link">← Back to BinderLink</a>

      <h1 class="mt-8 text-3xl font-bold text-brand-text">
        Choose a new password.
      </h1>

      <p class="mt-4 text-brand-muted">
        Use the link in your password reset email to access this form.
      </p>

      <p class="reset-status" role="status" aria-live="polite">
        Checking your reset link…
      </p>

      <form class="reset-form" hidden>
        <label>
          New password
          <input
            name="password"
            type="password"
            required
            minlength="12"
            autocomplete="new-password"
          />
        </label>

        <label>
          Confirm new password
          <input
            name="confirmation"
            type="password"
            required
            minlength="12"
            autocomplete="new-password"
          />
        </label>

        <p class="text-sm text-brand-muted">
          Use at least 12 characters. A long, unique password is best.
        </p>

        <button type="button" class="reset-toggle" aria-pressed="false">
          Show passwords
        </button>

        <button type="submit" class="reset-save"> Save new password </button>
      </form>

      <a href="/mtg" class="reset-link reset-return" hidden>
        Return to BinderLink →
      </a>
    </div>
  </section>
</Layout>

<script>
  import { supabase } from "@/lib/supabase";

  const root = document.querySelector<HTMLElement>(".reset-card");

  if (root) {
    const form = root.querySelector<HTMLFormElement>(".reset-form")!;
    const status = root.querySelector<HTMLElement>(".reset-status")!;
    const password = root.querySelector<HTMLInputElement>('[name="password"]')!;
    const confirmation = root.querySelector<HTMLInputElement>(
      '[name="confirmation"]',
    )!;
    const toggle = root.querySelector<HTMLButtonElement>(".reset-toggle")!;
    const save = root.querySelector<HTMLButtonElement>(".reset-save")!;
    const returnLink = root.querySelector<HTMLAnchorElement>(".reset-return")!;

    let ready = false;
    let busy = false;
    let completed = false;
    let checkVersion = 0;

    function message(error: unknown) {
      return error &&
        typeof error === "object" &&
        "message" in error &&
        typeof error.message === "string"
        ? error.message
        : "Please request a fresh password reset link.";
    }

    function conceal() {
      password.type = "password";
      confirmation.type = "password";
      toggle.textContent = "Show passwords";
      toggle.setAttribute("aria-pressed", "false");
    }

    async function checkSession() {
      const active = ++checkVersion;

      try {
        const { data, error } = await supabase.auth.getSession();

        if (active !== checkVersion || completed) return;
        if (error) throw error;

        if (!data.session) {
          ready = false;
          form.hidden = true;
          status.textContent =
            "This reset link is missing or has expired. Return to BinderLink and choose Forgot password to request a new one.";
          return;
        }

        const { data: verified, error: verificationError } =
          await supabase.auth.getUser();

        if (active !== checkVersion || completed) return;
        if (verificationError) throw verificationError;
        if (!verified.user) throw new Error("Please request a new reset link.");

        ready = true;
        form.hidden = false;
        status.textContent = "You can now choose your new password.";
      } catch (error) {
        if (active !== checkVersion || completed) return;

        ready = false;
        form.hidden = true;
        status.textContent = `Couldn’t verify your session: ${message(error)}`;
      }
    }

    toggle.addEventListener("click", () => {
      const show = password.type === "password";
      password.type = show ? "text" : "password";
      confirmation.type = show ? "text" : "password";
      toggle.textContent = show ? "Hide passwords" : "Show passwords";
      toggle.setAttribute("aria-pressed", String(show));
    });

    confirmation.addEventListener("input", () => {
      confirmation.setCustomValidity("");
    });

    password.addEventListener("input", () => {
      confirmation.setCustomValidity("");
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!ready || busy || completed) return;

      if (password.value !== confirmation.value) {
        confirmation.setCustomValidity("Your passwords don’t match.");
        confirmation.reportValidity();
        return;
      }

      busy = true;
      save.disabled = true;
      toggle.disabled = true;
      password.readOnly = true;
      confirmation.readOnly = true;
      status.textContent = "Saving your new password…";

      try {
        const { error } = await supabase.auth.updateUser({
          password: password.value,
        });

        if (error) throw error;

        completed = true;
        ready = false;
        checkVersion++;
        form.reset();
        conceal();
        form.hidden = true;
        returnLink.hidden = false;
        status.textContent =
          "Your password has been updated. Use your new password the next time you log in.";

        window.history.replaceState(null, "", window.location.pathname);
      } catch (error) {
        status.textContent = `Couldn’t update your password: ${message(error)}`;
      } finally {
        busy = false;
        save.disabled = false;
        toggle.disabled = false;
        password.readOnly = false;
        confirmation.readOnly = false;
      }
    });

    supabase.auth.onAuthStateChange((event) => {
      if (event === "SIGNED_OUT") {
        checkVersion++;
        ready = false;
        form.hidden = true;
        form.reset();
        conceal();

        if (!completed) {
          status.textContent =
            "Your session ended. Please request a new password reset link.";
        }
      }

      if (event === "PASSWORD_RECOVERY") {
        window.setTimeout(() => void checkSession(), 0);
      }
    });

    void checkSession();
  }
</script>

<style>
  .reset-card {
    padding: 1.5rem;
    border: 1px solid var(--color-pyroduck-plasma);
    border-radius: 1rem;
    background: var(--color-pyroduck-afterdark);
  }

  .reset-link {
    color: var(--color-pyroduck-plasma);
    font-weight: 600;
  }

  .reset-link:hover {
    color: var(--color-pyroduck-lime);
  }

  .reset-status {
    margin-block: 1.25rem;
    color: var(--color-pyroduck-lime);
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .reset-form,
  .reset-form label {
    display: grid;
    gap: 0.6rem;
  }

  .reset-form {
    gap: 1rem;
  }

  .reset-form label {
    color: var(--color-brand-text);
    font-weight: 600;
  }

  input {
    width: 100%;
    min-width: 0;
    min-height: 44px;
    padding: 0.75rem;
    border: 1px solid var(--color-pyroduck-plasma);
    border-radius: 0.5rem;
    background: var(--color-pyroduck-void);
    color: var(--color-brand-text);
    font: inherit;
  }

  button {
    min-height: 44px;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-pyroduck-plasma);
    border-radius: 0.5rem;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .reset-toggle {
    background: transparent;
    color: var(--color-pyroduck-plasma);
  }

  .reset-save {
    background: var(--color-pyroduck-plasma);
    color: var(--color-pyroduck-void);
  }

  button:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  input:focus-visible,
  button:focus-visible,
  a:focus-visible {
    outline: 2px solid var(--color-pyroduck-lime);
    outline-offset: 3px;
  }

  [hidden] {
    display: none !important;
  }
</style>
