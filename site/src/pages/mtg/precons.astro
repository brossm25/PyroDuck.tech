---
import Layout from "@/layouts/Layout.astro";
import { readFile } from "node:fs/promises";

interface Precon {
  id: string;
  name: string;
  setCode: string;
  setName: string;
  releaseDate: string;
  commanders: {
    name: string;
    scryfallId: string | null;
    colors: string[];
  }[];
}

const catalog = JSON.parse(
  await readFile(
    new URL("../../../public/data/precons/index.json", import.meta.url),
    "utf8",
  ),
) as { decks: Precon[] };

const years = [
  ...new Set(catalog.decks.map((deck) => deck.releaseDate.slice(0, 4))),
]
  .sort()
  .reverse();

function commanderImage(id: string | null) {
  if (
    !id ||
    !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id)
  ) {
    return null;
  }

  return `https://cards.scryfall.io/normal/front/${id[0]}/${id[1]}/${id}.jpg`;
}
---

<Layout
  title="Commander Precons | BinderLink"
  description="Browse Commander precons by commander and choose one to goldfish."
>
  <section class="precons-page px-6 py-12 sm:py-16">
    <div class="mx-auto max-w-7xl">
      <a href="/mtg/decks">← Your decks</a>

      <h1 class="mt-8 text-4xl font-bold">Goldfish a Commander precon</h1>

      <p class="intro">
        Recognize the commander? Browse the images below, or search for a
        commander, deck, or set. These are original precon lists.
      </p>

      <p class="intro">
        Add a private, editable copy to Concept decks for planning, or My decks
        for your regular collection. Cards are marked as real rather than
        proxies. Finishes default to nonfoil where available; review them
        against your physical cards.
      </p>

      <div class="precon-filters">
        <label>
          Search
          <input
            id="precon-query"
            type="search"
            placeholder="Commander, deck, or set…"
            autocomplete="off"
            aria-controls="precon-list"
          />
        </label>

        <label>
          Release year
          <select id="precon-year" aria-controls="precon-list">
            <option value="">All years</option>
            {years.map((year) => <option value={year}>{year}</option>)}
          </select>
        </label>

        <button id="precon-clear" type="button">Clear filters</button>
      </div>

      <p id="precon-count" role="status" aria-live="polite">
        {catalog.decks.length} precons · newest releases first
      </p>

      <ul id="precon-list" class="precon-grid">
        {
          catalog.decks.map((deck) => (
            <li
              class="precon-card"
              data-precon
              data-year={deck.releaseDate.slice(0, 4)}
              data-search={[
                deck.name,
                deck.setName,
                deck.setCode,
                ...deck.commanders.map((commander) => commander.name),
              ]
                .join(" ")
                .toLowerCase()}
            >
              <a
                class="precon-art"
                href={`/mtg/goldfish?precon=${encodeURIComponent(deck.id)}`}
                aria-label={`Goldfish ${deck.name}, led by ${deck.commanders.map((card) => card.name).join(" and ")}`}
              >
                {deck.commanders.map((commander) => {
                  const image = commanderImage(commander.scryfallId);

                  return image ? (
                    <img
                      src={image}
                      alt={commander.name}
                      width="488"
                      height="680"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <span class="art-fallback">{commander.name}</span>
                  );
                })}
              </a>

              <div class="precon-info">
                <h2>{deck.name}</h2>

                <p class="commander-name">
                  {deck.commanders.map((card) => card.name).join(" · ")}
                </p>

                <p class="release">
                  {deck.setName} · {deck.releaseDate.slice(0, 4)}
                </p>

                <a
                  class="goldfish-link"
                  href={`/mtg/goldfish?precon=${encodeURIComponent(deck.id)}`}
                >
                  Goldfish this precon →
                </a>

                <label>
                  Add to
                  <select class="precon-destination">
                    <option value="concept">Concept decks</option>
                    <option value="regular">My decks</option>
                  </select>
                </label>

                <button
                  type="button"
                  class="add-precon"
                  data-precon-id={deck.id}
                  data-precon-name={deck.name}
                >
                  Add deck.
                </button>
                <p class="precon-save-status" role="status" />
              </div>
            </li>
          ))
        }
      </ul>

      <p id="precon-empty" hidden>
        No precons match those filters. Try a different search or clear the
        filters.
      </p>

      <p class="credits">
        Decklist data from
        <a href="https://mtgjson.com" target="_blank" rel="noopener noreferrer">
          MTGJSON
        </a>. Card images from
        <a
          href="https://scryfall.com"
          target="_blank"
          rel="noopener noreferrer"
        >
          Scryfall
        </a>. Reissues and collector editions appear separately.
      </p>
    </div>
  </section>
</Layout>

<script>
  import { supabase } from "@/lib/supabase";
  import { preparePrecon } from "@/lib/preconDeck";

  const query = document.getElementById("precon-query") as HTMLInputElement;
  const year = document.getElementById("precon-year") as HTMLSelectElement;
  const count = document.getElementById("precon-count")!;
  const empty = document.getElementById("precon-empty")!;
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>("[data-precon]"),
  );

  function filterPrecons() {
    const terms = query.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
    let visible = 0;

    for (const card of cards) {
      const matches =
        (!year.value || card.dataset.year === year.value) &&
        terms.every((term) => card.dataset.search?.includes(term));

      card.hidden = !matches;
      if (matches) visible++;
    }

    count.textContent = `${visible} of ${cards.length} precons · newest releases first`;
    empty.hidden = visible !== 0;
  }

  let addingPrecon = false;

  const attempts = new Map<string, { requestId: string; userId: string }>();

  document
    .querySelectorAll<HTMLButtonElement>(".add-precon")
    .forEach((button) => {
      button.addEventListener("click", async () => {
        if (addingPrecon) return;

        const id = button.dataset.preconId;
        const message = button.parentElement?.querySelector<HTMLElement>(
          ".precon-save-status",
        );
        if (!id || !message) return;

        const destination =
          button.parentElement?.querySelector<HTMLSelectElement>(
            ".precon-destination",
          );
        if (!destination) return;

        const isConcept = destination.value === "concept";
        const attemptKey = `${id}:${isConcept}`;

        addingPrecon = true;
        const buttons =
          document.querySelectorAll<HTMLButtonElement>(".add-precon");
        buttons.forEach((item) => {
          item.disabled = true;
        });

        const controller = new AbortController();

        try {
          const {
            data: { session },
            error,
          } = await supabase.auth.getSession();

          if (error || !session) {
            throw new Error("Sign in using the account menu, then try again.");
          }

          const userId = session.user.id;
          let attempt = attempts.get(attemptKey);

          if (!attempt || attempt.userId !== userId) {
            attempt = { requestId: crypto.randomUUID(), userId };
            attempts.set(attemptKey, attempt);
          }

          const prepared = await preparePrecon(
            id,
            controller.signal,
            (text) => {
              message.textContent = text;
            },
          );

          const {
            data: { session: latest },
            error: sessionError,
          } = await supabase.auth.getSession();

          if (sessionError || latest?.user.id !== userId) {
            throw new Error("Your sign-in changed. Please try again.");
          }

          message.textContent = "Saving your private deck…";

          const { data: deckId, error: saveError } = await supabase.rpc(
            "save_precon_deck_to_category",
            {
              p_request_id: attempt.requestId,
              p_name: prepared.name,
              p_cards: prepared.cards,
              p_is_concept: isConcept,
            },
          );

          if (saveError) throw saveError;
          if (typeof deckId !== "string") {
            throw new Error("Couldn’t confirm the saved deck. Please retry.");
          }

          const {
            data: { session: finalSession },
          } = await supabase.auth.getSession();

          if (finalSession?.user.id !== userId) {
            throw new Error(
              "Sign-in changed. Check Your decks after signing back in.",
            );
          }

          window.location.assign(`/mtg/deck?id=${encodeURIComponent(deckId)}`);
        } catch (error) {
          message.textContent =
            error instanceof Error
              ? error.message
              : "Couldn’t save this precon. Please retry.";
        } finally {
          addingPrecon = false;
          buttons.forEach((item) => {
            item.disabled = false;
          });
        }
      });
    });

  query.addEventListener("input", filterPrecons);
  year.addEventListener("change", filterPrecons);

  document.getElementById("precon-clear")!.addEventListener("click", () => {
    query.value = "";
    year.value = "";
    filterPrecons();
    query.focus();
  });
</script>

<style>
  .intro,
  .credits {
    margin-block: 1rem;
    color: var(--color-brand-muted, #d6c9e5);
  }

  .precon-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 1rem;
    margin-block: 1.5rem;
  }

  .precon-filters label {
    display: grid;
    gap: 0.4rem;
  }

  .precon-filters label:first-child {
    flex: 1 1 16rem;
  }

  input,
  select,
  button {
    min-height: 44px;
    padding: 0.6rem 0.8rem;
    border: 1px solid #a444fc;
    border-radius: 0.5rem;
    background: #000;
    color: #f7f3ff;
    font: inherit;
  }

  button {
    cursor: pointer;
  }

  a:focus-visible,
  button:focus-visible,
  input:focus-visible,
  select:focus-visible {
    outline: 2px solid #b5fb14;
    outline-offset: 3px;
  }

  .precon-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr));
    gap: 1.25rem;
    margin-block: 1.25rem;
    padding: 0;
    list-style: none;
  }

  .precon-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid #a444fc;
    border-radius: 0.8rem;
    background: #10071b;
  }

  .precon-card[hidden] {
    display: none;
  }

  .precon-art {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.75rem;
    background: #000;
  }

  .precon-art img {
    width: 100%;
    min-width: 0;
    height: auto;
    aspect-ratio: 488 / 680;
    object-fit: contain;
    border-radius: 0.5rem;
    flex: 1 1 0;
  }

  .art-fallback {
    display: grid;
    place-items: center;
    min-height: 220px;
    padding: 1rem;
    color: #b5fb14;
  }

  .precon-info {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1rem;
  }

  h2 {
    font-size: 1.15rem;
    font-weight: 700;
  }

  .commander-name,
  .release {
    color: #d6c9e5;
    font-size: 0.9rem;
  }

  .goldfish-link {
    display: block;
    margin-top: auto;
    padding: 0.65rem;
    border-radius: 0.5rem;
    background: #a444fc;
    color: #000;
    text-align: center;
    font-weight: 700;
  }

  .goldfish-link:hover {
    background: #b5fb14;
  }

  .credits {
    font-size: 0.85rem;
  }

  .precon-info > label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .precon-destination {
    flex: 1;
    min-width: 0;
  }
</style>
