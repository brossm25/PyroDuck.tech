---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="My Commander Decks">
  <section class="px-6 py-12 sm:py-16" aria-labelledby="decks-heading">
    <div class="mx-auto max-w-5xl">
      <a href="/mtg" class="deck-back">← BinderLink</a>

      <p
        class="mt-8 text-sm font-semibold uppercase tracking-widest text-pyroduck-lime"
      >
        Build. Play. Share.
      </p>

      <h1
        id="decks-heading"
        class="mt-3 text-4xl font-bold text-brand-text sm:text-5xl"
      >
        Your Commander decks.
      </h1>

      <p class="mt-5 max-w-2xl text-lg text-brand-muted">
        Give your next deck a name. Decks start private, and you can choose who
        sees them as you build.
      </p>

      <form class="deck-create mt-8">
        <label for="deck-name">Deck name</label>

        <div class="deck-create-row">
          <input
            id="deck-name"
            name="name"
            type="text"
            required
            maxlength="100"
            placeholder="Give your deck a name"
            disabled
          />
          <button type="submit" disabled>Create deck</button>
        </div>
      </form>

      <p class="deck-status mt-5 text-brand-muted" role="status"></p>

      <ul class="deck-list mt-8"></ul>
    </div>
  </section>
</Layout>

<script>
  import { supabase } from "@/lib/supabase";

  interface Deck {
    id: string;
    name: string;
    visibility: "private" | "friends" | "public";
    created_at: string;
  }

  const form = document.querySelector<HTMLFormElement>(".deck-create");
  const input = document.querySelector<HTMLInputElement>("#deck-name");
  const button = form?.querySelector<HTMLButtonElement>("button");
  const status = document.querySelector<HTMLElement>(".deck-status");
  const list = document.querySelector<HTMLUListElement>(".deck-list");

  let userId: string | null = null;
  let loading = false;
  let saving = false;
  let requestId = 0;

  function setStatus(message: string) {
    if (status) status.textContent = message;
  }

  function syncControls() {
    const disabled = !userId || loading || saving;
    if (input) input.disabled = disabled;
    if (button) {
      button.disabled = disabled;
      button.textContent = saving ? "Creating…" : "Create deck";
    }
  }

  interface PreviewCard {
    id: string;
    name: string;
    card_role: string;
    quantity: number;
    is_proxy: boolean;
    image_url: string | null;
    color_identity: string[] | null;
    price_usd: number | string | null;
    manual_price_usd: number | string | null;
  }

  interface DeckPreview {
    cards: PreviewCard[];
    unavailable: boolean;
  }

  const previews = new Map<string, DeckPreview>();

  const money = (value: number) =>
    new Intl.NumberFormat("en-US", {
      style: "currency",
      currency: "USD",
    }).format(value);

  function parsePrice(value: number | string | null) {
    if (value === null || value === undefined || value === "") return null;
    const price = Number(value);
    return Number.isFinite(price) && price >= 0 ? price : null;
  }

  async function loadPreview(deckId: string, expectedRequest: number) {
    const cards: PreviewCard[] = [];
    let offset = 0;

    try {
      while (true) {
        const { data, error } = await supabase
          .from("deck_cards")
          .select(
            "id, name, card_role, quantity, is_proxy, image_url, color_identity, price_usd, manual_price_usd",
          )
          .eq("deck_id", deckId)
          .in("card_role", ["main", "commander"])
          .order("id", { ascending: true })
          .range(offset, offset + 99);

        if (expectedRequest !== requestId) return;
        if (error) throw error;

        const page = (data ?? []) as PreviewCard[];
        cards.push(...page);

        if (!page.length) break;
        offset += page.length;
      }

      previews.set(deckId, { cards, unavailable: false });
    } catch {
      if (expectedRequest === requestId) {
        previews.set(deckId, { cards: [], unavailable: true });
      }
    }
  }

  function renderDecks(decks: Deck[]) {
    list?.replaceChildren();

    const colors = [
      { code: "W", name: "White", color: "#f8edcf" },
      { code: "U", name: "Blue", color: "#74b9e6" },
      { code: "B", name: "Black", color: "#b2a3bf" },
      { code: "R", name: "Red", color: "#ef8b77" },
      { code: "G", name: "Green", color: "#8fc895" },
    ];

    for (const deck of decks) {
      const preview = previews.get(deck.id);
      const cards = preview?.cards ?? [];
      const commanders = cards
        .filter((card) => card.card_role === "commander")
        .sort((a, b) => a.name.localeCompare(b.name));

      const item = document.createElement("li");
      item.className = "deck-card";

      const artwork = document.createElement("div");
      artwork.className = "deck-artwork";

      for (const commander of commanders) {
        if (!commander.image_url) continue;

        try {
          const url = new URL(commander.image_url);
          if (
            url.protocol !== "https:" ||
            url.hostname !== "cards.scryfall.io"
          ) {
            continue;
          }

          const image = document.createElement("img");
          image.src = url.href;
          image.alt = commander.name;
          image.width = 488;
          image.height = 680;
          image.loading = "lazy";
          artwork.append(image);
        } catch {
          // Leave invalid image URLs out of the preview.
        }
      }

      if (!artwork.children.length) {
        const placeholder = document.createElement("span");
        placeholder.textContent = preview?.unavailable
          ? "Preview unavailable"
          : commanders.length
            ? "Commander"
            : "Choose a commander";
        artwork.append(placeholder);
      }

      const information = document.createElement("div");
      information.className = "deck-information";

      const heading = document.createElement("h2");
      const link = document.createElement("a");
      link.href = `/mtg/deck?id=${encodeURIComponent(deck.id)}`;
      link.textContent = deck.name;
      heading.append(link);

      const detail = document.createElement("p");
      const visibility =
        deck.visibility.charAt(0).toUpperCase() + deck.visibility.slice(1);
      detail.textContent = `Commander · ${visibility}`;

      information.append(heading, detail);

      if (commanders.length) {
        const names = document.createElement("p");
        names.className = "deck-commanders";
        names.textContent = commanders.map((card) => card.name).join(" + ");
        information.append(names);

        const identityKnown = commanders.every((card) =>
          Array.isArray(card.color_identity),
        );

        if (identityKnown) {
          const identity = new Set(
            commanders.flatMap((card) => card.color_identity ?? []),
          );
          const pips = document.createElement("div");
          pips.className = "deck-colors";

          for (const color of colors) {
            if (!identity.has(color.code)) continue;

            const pip = document.createElement("span");
            pip.className = "deck-pip";
            pip.style.backgroundColor = color.color;
            pip.textContent = color.code;
            pip.setAttribute("aria-label", color.name);
            pip.title = color.name;
            pips.append(pip);
          }

          if (!identity.size) {
            const pip = document.createElement("span");
            pip.className = "deck-pip";
            pip.textContent = "◇";
            pip.setAttribute("aria-label", "Colorless");
            pip.title = "Colorless";
            pips.append(pip);
          }

          information.append(pips);
        }
      }

      const summary = document.createElement("div");
      summary.className = "deck-preview-summary";

      function stat(label: string, value: string) {
        const row = document.createElement("div");
        const name = document.createElement("span");
        name.textContent = label;
        const amount = document.createElement("strong");
        amount.textContent = value;
        row.append(name, amount);
        summary.append(row);
      }

      if (!preview || preview.unavailable) {
        stat("Summary", "Unavailable");
      } else {
        let count = 0;
        let proxies = 0;
        let total = 0;
        let missing = 0;
        let estimated = 0;

        for (const card of cards) {
          count += card.quantity;
          if (card.is_proxy) proxies += card.quantity;

          const scryfall = parsePrice(card.price_usd);
          const manual = parsePrice(card.manual_price_usd);
          const price = scryfall ?? manual;

          if (price === null) {
            missing += card.quantity;
          } else {
            total += price * card.quantity;
            if (scryfall === null) estimated += card.quantity;
          }
        }

        stat("Deck cards", `${count} / 100`);
        stat("Proxies", String(proxies));
        stat(
          "Full deck estimate",
          count && missing === count
            ? "Unavailable"
            : `${money(total)}${missing ? " · partial" : ""}`,
        );

        if (missing || estimated) {
          const note = document.createElement("p");
          note.className = "deck-preview-note";
          note.textContent = [
            missing ? `${missing} unpriced` : "",
            estimated ? `${estimated} using manual estimates` : "",
          ]
            .filter(Boolean)
            .join(" · ");
          summary.append(note);
        }
      }

      const open = document.createElement("a");
      open.href = link.href;
      open.className = "deck-open";
      open.textContent = "Open deck →";
      open.setAttribute("aria-label", `Open ${deck.name}`);
      summary.append(open);

      item.append(artwork, information, summary);
      list?.append(item);
    }
  }

  async function loadDecks() {
    const currentRequest = ++requestId;
    loading = true;
    userId = null;
    list?.replaceChildren();
    previews.clear();
    syncControls();
    setStatus("Loading your decks…");

    try {
      const {
        data: { session },
        error: sessionError,
      } = await supabase.auth.getSession();

      if (currentRequest !== requestId) return;
      if (sessionError) throw sessionError;

      if (!session) {
        setStatus(
          "Sign in using the account menu to create and see your decks.",
        );
        return;
      }

      userId = session.user.id;

      const decks: Deck[] = [];
      const pageSize = 100;
      let offset = 0;

      while (true) {
        const { data, error } = await supabase
          .from("decks")
          .select("id, name, visibility, created_at")
          .eq("user_id", userId)
          .order("name", { ascending: true })
          .order("id", { ascending: true })
          .range(offset, offset + pageSize - 1);

        if (currentRequest !== requestId) return;
        if (error) throw error;

        const page = (data ?? []) as Deck[];
        decks.push(...page);

        if (page.length === 0) break;

        offset += page.length;
      }
      for (const deck of decks) {
        await loadPreview(deck.id, currentRequest);
        if (currentRequest !== requestId) return;
      }
      renderDecks(decks);
      setStatus(
        decks.length
          ? `${decks.length} ${decks.length === 1 ? "deck" : "decks"}.`
          : "No decks yet. Create your first one above.",
      );
    } catch {
      if (currentRequest === requestId) {
        setStatus("Couldn’t load your decks. Refresh the page to try again.");
      }
    } finally {
      if (currentRequest === requestId) {
        loading = false;
        syncControls();
      }
    }
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!input || !userId || loading || saving) return;

    const name = input.value.trim();
    if (!name) {
      setStatus("Enter a name for your deck.");
      input.focus();
      return;
    }

    const currentRequest = requestId;
    const currentUserId = userId;
    saving = true;
    syncControls();
    setStatus("Creating your private deck…");

    try {
      const {
        data: { session },
        error: sessionError,
      } = await supabase.auth.getSession();

      if (currentRequest !== requestId) return;
      if (sessionError || session?.user.id !== currentUserId) {
        throw new Error(
          "Your sign-in changed. Refresh the page and try again.",
        );
      }

      const { data, error } = await supabase
        .from("decks")
        .insert({ name })
        .select("id")
        .single();

      if (currentRequest !== requestId) return;
      if (error) throw error;
      if (!data) throw new Error("The deck could not be created.");

      input.value = "";
      await loadDecks();

      if (userId === currentUserId) {
        setStatus(`Created “${name}”. Its visibility is Private.`);
      }
    } catch (error) {
      if (currentRequest === requestId) {
        setStatus(
          error instanceof Error
            ? error.message
            : "Couldn’t create your deck. Please try again.",
        );
      }
    } finally {
      saving = false;
      syncControls();
    }
  });

  supabase.auth.onAuthStateChange((event) => {
    if (event === "SIGNED_IN" || event === "SIGNED_OUT") {
      window.setTimeout(() => void loadDecks(), 0);
    }
  });

  void loadDecks();
</script>

<style>
  .deck-back {
    color: var(--color-pyroduck-plasma);
    font-weight: 600;
  }

  .deck-back:hover {
    color: var(--color-pyroduck-lime);
  }

  .deck-create {
    padding: 1.25rem;
    border: 1px solid
      color-mix(in srgb, var(--color-pyroduck-plasma) 30%, transparent);
    border-radius: 1rem;
    background: var(--color-pyroduck-afterdark);
  }

  .deck-create label {
    display: block;
    margin-bottom: 0.75rem;
    color: var(--color-brand-text);
    font-weight: 600;
  }

  .deck-create-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .deck-create input {
    flex: 1 1 15rem;
    min-width: 0;
    min-height: 44px;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-pyroduck-plasma);
    border-radius: 0.5rem;
    background: var(--color-pyroduck-void);
    color: var(--color-brand-text);
    font: inherit;
  }

  .deck-create button {
    min-height: 44px;
    padding: 0.75rem 1.25rem;
    border-radius: 0.5rem;
    background: var(--color-pyroduck-plasma);
    color: var(--color-pyroduck-void);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .deck-create button:hover:not(:disabled) {
    background: var(--color-pyroduck-lime);
  }

  .deck-create button:disabled,
  .deck-create input:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .deck-back:focus-visible,
  .deck-create input:focus-visible,
  .deck-create button:focus-visible {
    outline: 2px solid var(--color-pyroduck-lime);
    outline-offset: 4px;
  }

  .deck-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    padding: 0;
    list-style: none;
  }

  .deck-list :global(.deck-card) {
    padding: 1.25rem;
    border: 1px solid
      color-mix(in srgb, var(--color-pyroduck-plasma) 30%, transparent);
    border-radius: 1rem;
    background: var(--color-pyroduck-afterdark);
    overflow-wrap: anywhere;
  }

  .deck-list :global(h2) {
    margin: 0;
    color: var(--color-brand-text);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .deck-list :global(p) {
    margin: 0.75rem 0 0;
    color: var(--color-pyroduck-lime);
    font-size: 0.875rem;
  }

  .deck-list :global(.deck-card) {
    display: grid;
    grid-template-columns: 90px minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .deck-list :global(.deck-artwork) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    min-width: 0;
  }

  .deck-list :global(.deck-artwork img) {
    display: block;
    width: 90px;
    height: auto;
    border-radius: 0.5rem;
  }

  .deck-list :global(.deck-artwork > span) {
    display: grid;
    place-items: center;
    width: 90px;
    min-height: 125px;
    padding: 0.5rem;
    border: 1px dashed var(--color-pyroduck-plasma);
    border-radius: 0.5rem;
    color: var(--color-brand-muted);
    font-size: 0.75rem;
    text-align: center;
  }

  .deck-list :global(.deck-information) {
    min-width: 0;
  }

  .deck-list :global(.deck-commanders),
  .deck-list :global(.deck-preview-note) {
    color: var(--color-brand-muted);
  }

  .deck-list :global(.deck-colors) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }

  .deck-list :global(.deck-pip) {
    display: inline-grid;
    place-items: center;
    width: 1.65rem;
    height: 1.65rem;
    border-radius: 50%;
    background: #c9c9c9;
    color: #10071b;
    font-size: 0.8rem;
    font-weight: 800;
  }

  .deck-list :global(.deck-preview-summary) {
    grid-column: 1 / -1;
    min-width: 0;
  }

  .deck-list :global(.deck-preview-summary > div) {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
    color: var(--color-brand-muted);
    font-size: 0.875rem;
  }

  .deck-list :global(.deck-preview-summary strong) {
    color: var(--color-pyroduck-lime);
    text-align: right;
  }

  .deck-list :global(.deck-open) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 0.5rem;
    color: var(--color-pyroduck-plasma);
    font-weight: 600;
  }

  .deck-list :global(a:hover) {
    color: var(--color-pyroduck-lime);
  }

  .deck-list :global(a:focus-visible) {
    outline: 2px solid var(--color-pyroduck-lime);
    outline-offset: 4px;
  }

  @media (min-width: 768px) {
    .deck-list :global(.deck-card) {
      grid-template-columns: 100px minmax(0, 1fr) minmax(210px, 260px);
      gap: 1.25rem;
    }

    .deck-list :global(.deck-preview-summary) {
      grid-column: auto;
    }
  }
</style>
