---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="My Commander Decks">
  <section class="px-6 py-12 sm:py-16" aria-labelledby="decks-heading">
    <div class="mx-auto max-w-5xl">
      <a href="/mtg" class="deck-back">← BinderLink</a>

      <p
        class="mt-8 text-sm font-semibold uppercase tracking-widest text-pyroduck-lime"
      >
        Build. Play. Share.
      </p>

      <h1
        id="decks-heading"
        class="mt-3 text-4xl font-bold text-brand-text sm:text-5xl"
      >
        Your Commander decks.
      </h1>

      <p class="mt-5 max-w-2xl text-lg text-brand-muted">
        Give your next deck a name. Decks start private, and you can choose who
        sees them as you build.
      </p>

      <form class="deck-create mt-8">
        <label for="deck-name">Deck name</label>

        <div class="deck-create-row">
          <input
            id="deck-name"
            name="name"
            type="text"
            required
            maxlength="100"
            placeholder="Give your deck a name"
            disabled
          />
          <button type="submit" disabled>Create deck</button>
        </div>
      </form>

      <p class="deck-status mt-5 text-brand-muted" role="status"></p>

      <ul class="deck-list mt-8"></ul>

      <section
        id="collection-summary"
        class="collection-summary"
        aria-labelledby="collection-summary-heading"
        hidden
      >
        <div class="collection-summary-heading">
          <h2 id="collection-summary-heading">My deck collection</h2>
          <span>Only shown to you</span>
        </div>

        <dl id="collection-summary-stats"></dl>

        <button id="find-proxies" type="button" aria-haspopup="dialog">
          Find my proxies
        </button>

        <p id="collection-summary-status" role="status"></p>

        <p class="collection-summary-note">
          Includes commanders and main decks across all your decks. Sideboards
          and maybeboards are excluded. Copies count separately in each deck,
          including cards shared between decks.
        </p>

        <p class="collection-summary-note">
          USD estimates use each card’s selected printing and finish. Saved
          Scryfall prices take priority over manual estimates. Refresh card data
          inside a deck to update its prices.
        </p>
      </section>
    </div>
  </section>
  <dialog id="proxy-finder" aria-labelledby="proxy-finder-heading">
    <form method="dialog" class="proxy-finder-close">
      <button>Close ×</button>
    </form>

    <h2 id="proxy-finder-heading">Find my proxies</h2>

    <label for="proxy-query">Search card, deck, set, or finish</label>
    <input
      id="proxy-query"
      type="search"
      placeholder="Try Old Gnawbone"
      autocomplete="off"
      autofocus
    />

    <p id="proxy-finder-status" role="status"></p>
    <p id="proxy-chase-status" role="status"></p>
    <ul id="proxy-finder-results"></ul>
  </dialog>
</Layout>

<script>
  import { supabase } from "@/lib/supabase";
  import { loadAllPages } from "@/lib/paginate";
  import { createAccountChangeGuard } from "@/lib/authAccountGuard";
  import {
    money,
    parsePrice,
    quantityOf,
    safeCardImage,
  } from "@/lib/mtgFormat";

  interface Deck {
    id: string;
    name: string;
    visibility: "private" | "friends" | "public";
    created_at: string;
  }

  const form = document.querySelector<HTMLFormElement>(".deck-create");
  const input = document.querySelector<HTMLInputElement>("#deck-name");
  const button = form?.querySelector<HTMLButtonElement>("button");
  const status = document.querySelector<HTMLElement>(".deck-status");
  const list = document.querySelector<HTMLUListElement>(".deck-list");

  let userId: string | null = null;
  let loading = false;
  let saving = false;
  let requestId = 0;

  function setStatus(message: string) {
    if (status) status.textContent = message;
  }

  function syncControls() {
    const disabled = !userId || loading || saving;
    if (input) input.disabled = disabled;
    if (button) {
      button.disabled = disabled;
      button.textContent = saving ? "Creating…" : "Create deck";
    }
  }

  interface PreviewCard {
    id: string;
    name: string;
    set_name: string;
    collector_number: string;
    finish: string;
    card_role: string;
    quantity: number;
    is_proxy: boolean;
    image_url: string | null;
    color_identity: string[] | null;
    price_usd: number | string | null;
    manual_price_usd: number | string | null;
  }

  interface DeckPreview {
    cards: PreviewCard[];
    unavailable: boolean;
  }

  const previews = new Map<string, DeckPreview>();

  const collectionSummary = document.querySelector<HTMLElement>(
    "#collection-summary",
  );
  const collectionStats = document.querySelector<HTMLElement>(
    "#collection-summary-stats",
  );
  const collectionStatus = document.querySelector<HTMLElement>(
    "#collection-summary-status",
  );

  const proxyFinder =
    document.querySelector<HTMLDialogElement>("#proxy-finder")!;
  const proxyQuery = document.querySelector<HTMLInputElement>("#proxy-query")!;
  const proxyResults = document.querySelector<HTMLUListElement>(
    "#proxy-finder-results",
  )!;
  const proxyStatus = document.querySelector<HTMLElement>(
    "#proxy-finder-status",
  )!;

  let collectionDecks: Deck[] = [];
  let addingProxyToChase = false;
  const chasedDeckCardIds = new Set<string>();
  let chaseStateReady = false;
  let chaseStateRequest = 0;

  async function loadProxyChaseState() {
    const stateRequest = ++chaseStateRequest;
    const expectedRequest = requestId;
    const expectedUser = userId;
    chaseStateReady = false;
    chasedDeckCardIds.clear();
    renderProxyFinder();

    const actionStatus = document.querySelector<HTMLElement>(
      "#proxy-chase-status",
    )!;
    actionStatus.textContent = "Checking your chase list…";

    const isCurrent = () =>
      stateRequest === chaseStateRequest &&
      expectedRequest === requestId &&
      expectedUser === userId;

    try {
      if (!expectedUser) return;

      const rows = await loadAllPages<{
        id: string;
        source_deck_card_id: string | null;
      }>(
        async (from, to) => {
          const { data, error } = await supabase
            .from("chase_cards")
            .select("id, source_deck_card_id")
            .eq("user_id", expectedUser)
            .not("source_deck_card_id", "is", null)
            .order("id", { ascending: true })
            .range(from, to);

          return { data, error };
        },
        { isCurrent },
      );

      if (rows === null || !isCurrent()) return;

      for (const row of rows) {
        if (row.source_deck_card_id) {
          chasedDeckCardIds.add(row.source_deck_card_id);
        }
      }

      chaseStateReady = true;
      actionStatus.textContent = "";
      renderProxyFinder();
    } catch {
      if (!isCurrent()) return;
      actionStatus.textContent =
        "Couldn’t check your chase list. Close and reopen this window to retry.";
      renderProxyFinder();
    }
  }

  async function addProxyToChase(
    deck: Deck,
    card: PreviewCard,
    button: HTMLButtonElement,
  ) {
    if (
      !userId ||
      loading ||
      addingProxyToChase ||
      !chaseStateReady ||
      chasedDeckCardIds.has(card.id)
    )
      return;

    const expectedRequest = requestId;
    const expectedUser = userId;
    const actionStatus = document.querySelector<HTMLElement>(
      "#proxy-chase-status",
    )!;

    addingProxyToChase = true;
    button.disabled = true;
    button.textContent = "Adding…";
    actionStatus.textContent = `Adding ${card.name} for ${deck.name}…`;

    try {
      const {
        data: { session },
        error: sessionError,
      } = await supabase.auth.getSession();

      if (expectedRequest !== requestId) return;
      if (sessionError) throw sessionError;

      if (session?.user.id !== expectedUser) {
        throw new Error("Your sign-in changed. Refresh and try again.");
      }

      const { data, error } = await supabase.rpc("add_deck_proxy_to_chase", {
        p_deck_card_id: card.id,
      });

      if (expectedRequest !== requestId || userId !== expectedUser) return;
      if (error) throw error;

      if (data !== "added" && data !== "already_exists") {
        throw new Error("Couldn’t confirm the chase entry. Try again.");
      }

      chasedDeckCardIds.add(card.id);
      button.textContent = "On chase list";
      button.dataset.added = "true";

      actionStatus.textContent =
        data === "added"
          ? `Added ${card.name} for ${deck.name} to your chase list.`
          : `${card.name} is already on your chase list for ${deck.name}.`;
    } catch (error) {
      if (expectedRequest === requestId && userId === expectedUser) {
        actionStatus.textContent =
          typeof error === "object" && error !== null && "message" in error
            ? String(error.message)
            : "Couldn’t add this card. Please try again.";

        button.textContent = "Add to chase list";
      }
    } finally {
      addingProxyToChase = false;
      if (expectedRequest === requestId && userId === expectedUser) {
        renderProxyFinder();
      }

      if (button.isConnected) {
        button.disabled = button.dataset.added === "true";
      }
    }
  }

  function renderProxyFinder() {
    proxyResults.replaceChildren();
    const query = proxyQuery.value.trim().toLocaleLowerCase();

    const unavailable = collectionDecks.filter((deck) => {
      const preview = previews.get(deck.id);
      return !preview || preview.unavailable;
    }).length;

    const matches = collectionDecks
      .flatMap((deck) =>
        (previews.get(deck.id)?.cards ?? [])
          .filter((card) => card.is_proxy)
          .map((card) => ({ deck, card })),
      )
      .filter(({ deck, card }) =>
        [
          card.name,
          deck.name,
          card.set_name,
          card.collector_number,
          card.finish,
        ]
          .join(" ")
          .toLocaleLowerCase()
          .includes(query),
      )
      .sort(
        (a, b) =>
          a.card.name.localeCompare(b.card.name) ||
          a.deck.name.localeCompare(b.deck.name),
      );

    const copies = matches.reduce(
      (total, { card }) => total + card.quantity,
      0,
    );

    proxyStatus.textContent =
      (matches.length
        ? `${copies} proxy copies in ${matches.length} deck entries.`
        : query
          ? "No matching proxies in your loaded decks."
          : "No proxies in your loaded decks.") +
      (unavailable
        ? ` Results are incomplete: ${unavailable} decks could not load.`
        : "");

    for (const { deck, card } of matches) {
      const item = document.createElement("li");

      const imageUrl = safeCardImage(card.image_url);

      if (imageUrl) {
        const image = document.createElement("img");
        image.src = imageUrl;
        image.alt = card.name;
        image.width = 488;
        image.height = 680;
        image.loading = "lazy";
        item.append(image);
      }

      const information = document.createElement("div");
      const name = document.createElement("h3");
      name.textContent = `${card.quantity} × ${card.name}`;

      const printing = document.createElement("p");
      printing.textContent = `${card.set_name} #${card.collector_number} · ${card.finish}`;

      const price = parsePrice(card.price_usd);
      const manual = parsePrice(card.manual_price_usd);
      const amount = price ?? manual;

      const value = document.createElement("p");
      value.textContent =
        amount === null
          ? "Replacement value unavailable"
          : `${money(amount)} per copy · ` +
            `${money(amount * card.quantity)} total` +
            (price === null ? " · manual estimate" : "");

      const link = document.createElement("a");
      link.href = `/mtg/deck?id=${encodeURIComponent(deck.id)}`;
      link.textContent = `Open ${deck.name} →`;

      const chaseButton = document.createElement("button");
      chaseButton.type = "button";
      chaseButton.className = "proxy-chase-button";
      const alreadyChased = chasedDeckCardIds.has(card.id);

      chaseButton.textContent = alreadyChased
        ? "On chase list"
        : chaseStateReady
          ? "Add to chase list"
          : "Checking chase list…";

      chaseButton.disabled =
        alreadyChased || !chaseStateReady || addingProxyToChase;

      if (alreadyChased) {
        chaseButton.dataset.added = "true";
      }
      chaseButton.addEventListener("click", () => {
        void addProxyToChase(deck, card, chaseButton);
      });

      information.append(name, printing, value, link, chaseButton);
      item.append(information);
      proxyResults.append(item);
    }
  }

  document.querySelector("#find-proxies")?.addEventListener("click", () => {
    if (!userId || loading || addingProxyToChase) return;
    proxyQuery.value = "";
    proxyFinder.showModal();
    void loadProxyChaseState();
  });

  proxyQuery.addEventListener("input", renderProxyFinder);

  function clearCollectionSummary() {
    chaseStateRequest++;
    chaseStateReady = false;
    chasedDeckCardIds.clear();
    if (proxyFinder.open) proxyFinder.close();
    collectionDecks = [];
    proxyQuery.value = "";
    document.querySelector("#proxy-chase-status")!.textContent = "";
    proxyResults.replaceChildren();
    proxyStatus.textContent = "";
    if (collectionSummary) collectionSummary.hidden = true;
    collectionStats?.replaceChildren();
    if (collectionStatus) collectionStatus.textContent = "";
  }

  function renderCollectionSummary(decks: Deck[]) {
    if (
      !collectionSummary ||
      !collectionStats ||
      !collectionStatus ||
      !userId
    ) {
      return;
    }

    collectionStats.replaceChildren();

    function stat(label: string, value: string, note?: string) {
      const item = document.createElement("div");

      const term = document.createElement("dt");
      term.textContent = label;

      const amount = document.createElement("dd");
      amount.textContent = value;

      item.append(term, amount);

      if (note) {
        const detail = document.createElement("p");
        detail.textContent = note;
        item.append(detail);
      }

      collectionStats!.append(item);
    }

    stat("Total decks", String(decks.length));

    const unavailable = decks.filter((deck) => {
      const preview = previews.get(deck.id);
      return !preview || preview.unavailable;
    }).length;

    if (unavailable) {
      for (const label of [
        "Real cards",
        "Proxy cards",
        "Full deck value",
        "Real-card value",
        "Proxy replacement value",
      ]) {
        stat(label, "Unavailable");
      }

      collectionStatus.textContent =
        `Card data could not be loaded for ${unavailable} ` +
        `${unavailable === 1 ? "deck" : "decks"}. ` +
        "Refresh this page to try again.";

      collectionSummary.hidden = false;
      return;
    }

    const cards = decks.flatMap((deck) => previews.get(deck.id)?.cards ?? []);

    const real = cards.filter((card) => !card.is_proxy);
    const proxies = cards.filter((card) => card.is_proxy);

    stat("Real cards", String(quantityOf(real)));
    stat("Proxy cards", String(quantityOf(proxies)));

    function valueStat(label: string, entries: PreviewCard[]) {
      let total = 0;
      let priced = 0;
      let missing = 0;
      let estimated = 0;

      for (const card of entries) {
        const scryfall = parsePrice(card.price_usd);
        const price = scryfall ?? parsePrice(card.manual_price_usd);

        if (price === null) {
          missing += card.quantity;
        } else {
          total += price * card.quantity;
          priced += card.quantity;

          if (scryfall === null) {
            estimated += card.quantity;
          }
        }
      }

      const notes = [
        missing
          ? `${missing} ${missing === 1 ? "copy" : "copies"} unpriced`
          : "",
        estimated
          ? `${estimated} ${estimated === 1 ? "copy uses" : "copies use"} manual estimates`
          : "",
      ].filter(Boolean);

      stat(
        label,
        entries.length && !priced
          ? "Unavailable"
          : `${money(total)}${missing ? " · partial" : ""}`,
        notes.join(" · "),
      );
    }

    valueStat("Full deck value", cards);
    valueStat("Real-card value", real);
    valueStat("Proxy replacement value", proxies);

    collectionStatus.textContent = `${quantityOf(cards)} total card copies across your decks.`;

    collectionSummary.hidden = false;
  }

  async function loadPreview(deckId: string, expectedRequest: number) {
    try {
      const cards = await loadAllPages<PreviewCard>(
        async (from, to) => {
          const { data, error } = await supabase
            .from("deck_cards")
            .select(
              "id, name, set_name, collector_number, finish, card_role, quantity, is_proxy, image_url, color_identity, price_usd, manual_price_usd",
            )
            .eq("deck_id", deckId)
            .in("card_role", ["main", "commander"])
            .order("id", { ascending: true })
            .range(from, to);

          return { data: data as PreviewCard[] | null, error };
        },
        { isCurrent: () => expectedRequest === requestId },
      );

      if (cards === null || expectedRequest !== requestId) return;
      previews.set(deckId, { cards, unavailable: false });
    } catch {
      if (expectedRequest === requestId) {
        previews.set(deckId, { cards: [], unavailable: true });
      }
    }
  }

  function renderDecks(decks: Deck[]) {
    list?.replaceChildren();

    const colors = [
      { code: "W", name: "White", color: "#f8edcf" },
      { code: "U", name: "Blue", color: "#74b9e6" },
      { code: "B", name: "Black", color: "#b2a3bf" },
      { code: "R", name: "Red", color: "#ef8b77" },
      { code: "G", name: "Green", color: "#8fc895" },
    ];

    for (const deck of decks) {
      const preview = previews.get(deck.id);
      const cards = preview?.cards ?? [];
      const commanders = cards
        .filter((card) => card.card_role === "commander")
        .sort((a, b) => a.name.localeCompare(b.name));

      const item = document.createElement("li");
      item.className = "deck-card";

      const artwork = document.createElement("div");
      artwork.className = "deck-artwork";

      for (const commander of commanders) {
        const imageUrl = safeCardImage(commander.image_url);
        if (!imageUrl) continue;

        const image = document.createElement("img");
        image.src = imageUrl;
        image.alt = commander.name;
        image.width = 488;
        image.height = 680;
        image.loading = "lazy";
        artwork.append(image);
      }

      if (!artwork.children.length) {
        const placeholder = document.createElement("span");
        placeholder.textContent = preview?.unavailable
          ? "Preview unavailable"
          : commanders.length
            ? "Commander"
            : "Choose a commander";
        artwork.append(placeholder);
      }

      const information = document.createElement("div");
      information.className = "deck-information";

      const heading = document.createElement("h2");
      const link = document.createElement("a");
      link.href = `/mtg/deck?id=${encodeURIComponent(deck.id)}`;
      link.textContent = deck.name;
      heading.append(link);

      const detail = document.createElement("p");
      const visibility =
        deck.visibility.charAt(0).toUpperCase() + deck.visibility.slice(1);
      detail.textContent = `Commander · ${visibility}`;

      information.append(heading, detail);

      if (commanders.length) {
        const names = document.createElement("p");
        names.className = "deck-commanders";
        names.textContent = commanders.map((card) => card.name).join(" + ");
        information.append(names);

        const identityKnown = commanders.every((card) =>
          Array.isArray(card.color_identity),
        );

        if (identityKnown) {
          const identity = new Set(
            commanders.flatMap((card) => card.color_identity ?? []),
          );
          const pips = document.createElement("div");
          pips.className = "deck-colors";

          for (const color of colors) {
            if (!identity.has(color.code)) continue;

            const pip = document.createElement("span");
            pip.className = "deck-pip";
            pip.style.backgroundColor = color.color;
            pip.textContent = color.code;
            pip.setAttribute("aria-label", color.name);
            pip.title = color.name;
            pips.append(pip);
          }

          if (!identity.size) {
            const pip = document.createElement("span");
            pip.className = "deck-pip";
            pip.textContent = "◇";
            pip.setAttribute("aria-label", "Colorless");
            pip.title = "Colorless";
            pips.append(pip);
          }

          information.append(pips);
        }
      }

      const summary = document.createElement("div");
      summary.className = "deck-preview-summary";

      function stat(label: string, value: string) {
        const row = document.createElement("div");
        const name = document.createElement("span");
        name.textContent = label;
        const amount = document.createElement("strong");
        amount.textContent = value;
        row.append(name, amount);
        summary.append(row);
      }

      if (!preview || preview.unavailable) {
        stat("Summary", "Unavailable");
      } else {
        let count = 0;
        let proxies = 0;
        let total = 0;
        let missing = 0;
        let estimated = 0;

        for (const card of cards) {
          count += card.quantity;
          if (card.is_proxy) proxies += card.quantity;

          const scryfall = parsePrice(card.price_usd);
          const manual = parsePrice(card.manual_price_usd);
          const price = scryfall ?? manual;

          if (price === null) {
            missing += card.quantity;
          } else {
            total += price * card.quantity;
            if (scryfall === null) estimated += card.quantity;
          }
        }

        stat("Deck cards", `${count} / 100`);
        stat("Proxies", String(proxies));
        stat(
          "Full deck estimate",
          count && missing === count
            ? "Unavailable"
            : `${money(total)}${missing ? " · partial" : ""}`,
        );

        if (missing || estimated) {
          const note = document.createElement("p");
          note.className = "deck-preview-note";
          note.textContent = [
            missing ? `${missing} unpriced` : "",
            estimated ? `${estimated} using manual estimates` : "",
          ]
            .filter(Boolean)
            .join(" · ");
          summary.append(note);
        }
      }

      const open = document.createElement("a");
      open.href = link.href;
      open.className = "deck-open";
      open.textContent = "Open deck →";
      open.setAttribute("aria-label", `Open ${deck.name}`);
      summary.append(open);

      item.append(artwork, information, summary);
      list?.append(item);
    }
  }

  async function loadDecks() {
    const currentRequest = ++requestId;
    loading = true;
    userId = null;
    list?.replaceChildren();
    previews.clear();
    clearCollectionSummary();
    syncControls();
    setStatus("Loading your decks…");

    try {
      const {
        data: { session },
        error: sessionError,
      } = await supabase.auth.getSession();

      if (currentRequest !== requestId) return;
      if (sessionError) throw sessionError;

      if (!session) {
        setStatus(
          "Sign in using the account menu to create and see your decks.",
        );
        return;
      }

      userId = session.user.id;

      const decks = await loadAllPages<Deck>(
        async (from, to) => {
          const { data, error } = await supabase
            .from("decks")
            .select("id, name, visibility, created_at")
            .eq("user_id", userId!)
            .order("name", { ascending: true })
            .order("id", { ascending: true })
            .range(from, to);

          return { data: data as Deck[] | null, error };
        },
        { isCurrent: () => currentRequest === requestId },
      );

      if (decks === null || currentRequest !== requestId) return;

      for (const deck of decks) {
        await loadPreview(deck.id, currentRequest);
        if (currentRequest !== requestId) return;
      }
      renderDecks(decks);
      collectionDecks = decks;
      renderCollectionSummary(decks);
      setStatus(
        decks.length
          ? `${decks.length} ${decks.length === 1 ? "deck" : "decks"}.`
          : "No decks yet. Create your first one above.",
      );
    } catch {
      if (currentRequest === requestId) {
        setStatus("Couldn’t load your decks. Refresh the page to try again.");
      }
    } finally {
      if (currentRequest === requestId) {
        loading = false;
        syncControls();
      }
    }
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!input || !userId || loading || saving) return;

    const name = input.value.trim();
    if (!name) {
      setStatus("Enter a name for your deck.");
      input.focus();
      return;
    }

    const currentRequest = requestId;
    const currentUserId = userId;
    saving = true;
    syncControls();
    setStatus("Creating your private deck…");

    try {
      const {
        data: { session },
        error: sessionError,
      } = await supabase.auth.getSession();

      if (currentRequest !== requestId) return;
      if (sessionError || session?.user.id !== currentUserId) {
        throw new Error(
          "Your sign-in changed. Refresh the page and try again.",
        );
      }

      const { data, error } = await supabase
        .from("decks")
        .insert({ name })
        .select("id")
        .single();

      if (currentRequest !== requestId) return;
      if (error) throw error;
      if (!data) throw new Error("The deck could not be created.");

      input.value = "";
      await loadDecks();

      if (userId === currentUserId) {
        setStatus(`Created “${name}”. Its visibility is Private.`);
      }
    } catch (error) {
      if (currentRequest === requestId) {
        setStatus(
          error instanceof Error
            ? error.message
            : "Couldn’t create your deck. Please try again.",
        );
      }
    } finally {
      saving = false;
      syncControls();
    }
  });

  const accountChanged = createAccountChangeGuard();

  supabase.auth.onAuthStateChange((event, session) => {
    if (!accountChanged(event, session)) return;

    if (event === "SIGNED_IN" || event === "SIGNED_OUT") {
      window.setTimeout(() => void loadDecks(), 0);
    }
  });

  void loadDecks();
</script>

