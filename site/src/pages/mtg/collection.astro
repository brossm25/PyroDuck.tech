---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="My Collection">
  <section class="px-6 py-12 sm:py-16" aria-labelledby="collection-heading">
    <div class="mx-auto max-w-5xl text-brand-text">
      <a
        href="/mtg"
        class="front-semibold text-pyroduck-plasma hover:text-pyroduck-lime"
      >
        ← BinderLink
      </a>

      <h1 id="collection-heading" class="mt-8 text-4xl font-bold">
        Your collection.
      </h1>

      <p class="mt-4 max-w-2xl text-brand-muted">
        Keep track of cards in your boxes, folders, and binders. Name each
        location to match how you store your cards.
      </p>

      <p id="collection-status" class="mt-6 text-brand-muted" role="status">
        Checking your sign-in.
      </p>

      <div id="collection-content" hidden>
        <section class="storage-panel" aria-labelledby="location-heading">
          <h2 id="locations-heading">Storage locations</h2>

          <p class="text-brand-muted">
            Start with a Dump box for unsorted cards, then add locationssuch as
            Creature foil, X-creatures, or Lands.
          </p>

          <button id="create-dump-box" type="button" disabled>
            Create Dump Box
          </button>

          <form id="create-location">
            <label for="location-name">New location name</label>
            <div class="storage-row">
              <input
                id="location-name"
                name="name"
                required
                maxlength="100"
                placeholder="For example: X-creatures"
                disabled
              />
              <button type="submit" disabled>Add location</button>
            </div>
          </form>

          <ul id="storage-locations"></ul>
        </section>
        <section
          id="location-cards-panel"
          class="storage-panel"
          aria-labelledby="location-cards-heading"
          hidden
        >
          <h2 id="location-cards-heading">Stored cards</h2>
          <p id="location-cards-status" role="status"></p>
          <form id="collection-search">
            <label for="collection-query">Find a card to add</label>
            <div class="storage-row">
              <input
                id="collection-query"
                type="search"
                placeholder="Try Sol Ring"
                required
              />
              <button type="submit">Search</button>
            </div>
          </form>

          <p id="collection-search-status" role="status"></p>
          <ul id="collection-search-results"></ul>
          <ul id="location-cards"></ul>
        </section>
      </div>
    </div>
  </section>
  <dialog id="collection-picker" aria-labelledby="collection-picker-heading">
    <form method="dialog">
      <button type="submit">Close ×</button>
    </form>

    <h2 id="collection-picker-heading">Choose printing</h2>
    <p id="collection-picker-status" role="status"></p>

    <label for="collection-printing">Printing</label>
    <select id="collection-printing"></select>

    <img id="collection-card-image" alt="" width="488" height="680" hidden />

    <label for="collection-finish">Finish</label>
    <select id="collection-finish"></select>

    <label for="collection-quantity">Quantity</label>
    <input
      id="collection-quantity"
      type="number"
      min="1"
      max="1000000"
      step="1"
      value="1"
      required
    />

    <button id="collection-save" type="button" disabled>
      Add to location
    </button>
  </dialog>
</Layout>

<script>
  import { supabase } from "@/lib/supabase";
  import { loadAllPages } from "@/lib/paginate";
  import { createAccountChangeGuard } from "@/lib/authAccountGuard";
  import { fetchImportCard } from "@/lib/cardImportMatch";
  import type { DeckCard } from "@/lib/deckCardData";
  import { loadDeckPrintings } from "@/lib/deckPrintings";

  interface StorageLocation {
    id: string;
    name: string;
    is_dump_box: boolean;
  }

  const get = <T extends HTMLElement>(id: string) =>
    document.getElementById(id) as T;

  const content = get("collection-content");
  const status = get("collection-status");
  const list = get<HTMLUListElement>("storage-locations");
  const form = get<HTMLFormElement>("create-location");
  const nameInput = get<HTMLInputElement>("location-name");
  const addButton = form.querySelector<HTMLButtonElement>(
    'button[type="submit"]',
  )!;
  const dumpButton = get<HTMLButtonElement>("create-dump-box");
  interface StoredCard {
    id: string;
    name: string;
    set_name: string;
    collector_number: string;
    finish: string;
    quantity: number;
  }

  const cardsPanel = get("location-cards-panel");
  const cardsHeading = get("location-cards-heading");
  const cardsStatus = get("location-cards-status");
  const cardsList = get<HTMLUListElement>("location-cards");

  let locationRequest = 0;
  let selectedLocation: StorageLocation | null = null;

  const searchForm = get<HTMLFormElement>("collection-search");
  const searchQuery = get<HTMLInputElement>("collection-query");
  const searchStatus = get("collection-search-status");
  const searchResults = get<HTMLUListElement>("collection-search-results");
  let searchController: AbortController | undefined;

  const cardPicker = get<HTMLDialogElement>("collection-picker");
  const printingSelect = get<HTMLSelectElement>("collection-printing");
  const finishSelect = get<HTMLSelectElement>("collection-finish");
  const cardImage = get<HTMLImageElement>("collection-card-image");
  const pickerStatus = get("collection-picker-status");
  const cardQuantity = get<HTMLInputElement>("collection-quantity");
  const saveCard = get<HTMLButtonElement>("collection-save");

  function syncCardSave() {
    const card = cardPrintings[Number(printingSelect.value)];
    saveCard.disabled =
      !userId ||
      loading ||
      saving ||
      !selectedLocation ||
      !card ||
      !["nonfoil", "foil", "etched"].includes(finishSelect.value) ||
      !card.finishes.includes(finishSelect.value);

    printingSelect.disabled = saving;
    finishSelect.disabled = saving;
    cardQuantity.disabled = saving;
  }

  let cardPrintings: DeckCard[] = [];
  let printingController: AbortController | undefined;

  function previewCollectionPrinting() {
    saveCard.disabled = true;
    const card = cardPrintings[Number(printingSelect.value)];
    finishSelect.replaceChildren();
    cardImage.hidden = true;
    cardImage.removeAttribute("src");

    if (!card) {
      syncCardSave();
      return;
    }

    for (const finish of card.finishes) {
      if (!["nonfoil", "foil", "etched"].includes(finish)) continue;

      finishSelect.add(
        new Option(
          finish === "nonfoil"
            ? "Nonfoil"
            : finish === "etched"
              ? "Etched foil"
              : "Foil",
          finish,
        ),
      );
    }

    if (card.finishes.includes("nonfoil")) {
      finishSelect.value = "nonfoil";
    }

    const url =
      card.image_uris?.normal ?? card.card_faces?.[0]?.image_uris?.normal;

    if (url) {
      try {
        const imageUrl = new URL(url);
        if (
          imageUrl.protocol === "https:" &&
          imageUrl.hostname === "cards.scryfall.io"
        ) {
          cardImage.src = imageUrl.href;
          cardImage.alt = card.name;
          cardImage.hidden = false;
        }
      } catch {
        // The printing can still be selected without an image.
      }
    }
  }

  async function chooseCollectionPrinting(card: DeckCard) {
    if (!userId || loading || saving) return;

    printingController?.abort();
    const controller = new AbortController();
    printingController = controller;
    const current = version;
    const location = locationRequest;

    cardPrintings = [];
    saveCard.disabled = true;
    printingSelect.replaceChildren();
    finishSelect.replaceChildren();
    cardImage.hidden = true;
    cardQuantity.value = "1";

    get("collection-picker-heading").textContent =
      `Choose printing · ${card.name}`;
    pickerStatus.textContent = "Loading printings…";
    cardPicker.showModal();

    try {
      const printings = await loadDeckPrintings<DeckCard>(
        card.prints_search_uri,
        controller.signal,
      );

      if (
        controller.signal.aborted ||
        current !== version ||
        location !== locationRequest
      )
        return;

      cardPrintings = printings;

      printings.forEach((printing, index) => {
        printingSelect.add(
          new Option(
            `${printing.set_name} — #${printing.collector_number}`,
            String(index),
          ),
        );
      });

      previewCollectionPrinting();
      syncCardSave();
      pickerStatus.textContent = printings.length
        ? "Choose the printing and finish that match your card."
        : "No paper printings found.";
    } catch {
      if (
        !controller.signal.aborted &&
        current === version &&
        location === locationRequest
      ) {
        pickerStatus.textContent =
          "Couldn’t load printings. Close this window and try again.";
      }
    }
  }

  saveCard.addEventListener("click", async () => {
    if (!userId || loading || saving || !selectedLocation) return;

    const card = cardPrintings[Number(printingSelect.value)];
    const finish = finishSelect.value;
    const quantity = Number(cardQuantity.value);

    if (
      !card ||
      !["nonfoil", "foil", "etched"].includes(finish) ||
      !card.finishes.includes(finish)
    ) {
      pickerStatus.textContent = "Choose a valid printing and finish.";
      return;
    }

    if (
      !cardQuantity.reportValidity() ||
      !Number.isSafeInteger(quantity) ||
      quantity < 1 ||
      quantity > 1000000
    ) {
      pickerStatus.textContent =
        "Enter a whole-number quantity between 1 and 1,000,000.";
      return;
    }

    const current = version;
    const targetUser = userId;
    const location = selectedLocation;
    const request = locationRequest;
    const isCurrent = () =>
      current === version &&
      targetUser === userId &&
      request === locationRequest;

    let saved = false;
    saving = true;
    controls();
    pickerStatus.textContent = `Adding to ${location.name}…`;

    try {
      const {
        data: { session },
        error: sessionError,
      } = await supabase.auth.getSession();

      if (!isCurrent()) return;
      if (sessionError || session?.user.id !== targetUser) {
        throw new Error("Your sign-in changed. Reload before adding cards.");
      }

      const cardToAdd = {
        scryfall_id: card.id,
        oracle_id: card.oracle_id ?? null,
        name: card.name,
        set_code: (card as DeckCard & { set: string }).set,
        set_name: card.set_name,
        collector_number: card.collector_number,
        finish,
        quantity,
      };

      // Keep the request ID if the result is uncertain.
      // Retrying the same addition in this tab reuses that ID,
      // including after a page reload.
      const retryKey =
        "binderlink:collection-add:" +
        JSON.stringify({
          userId: targetUser,
          locationId: location.id,
          card: cardToAdd,
        });

      let requestId = sessionStorage.getItem(retryKey);

      if (!requestId) {
        requestId = crypto.randomUUID();
        sessionStorage.setItem(retryKey, requestId);
      }

      const { data, error } = await supabase.rpc("add_collection_card_copies", {
        p_request_id: requestId,
        p_location_id: location.id,
        p_card: cardToAdd,
      });

      if (!isCurrent()) return;

      if (error) {
        throw new Error(
          `${error.message} Retry with the same printing, finish, and quantity to avoid counting this addition twice.`,
        );
      }

      if (typeof data !== "string") {
        throw new Error(
          "Couldn’t confirm the save. Retry with the same printing, finish, and quantity.",
        );
      }

      // A confirmed save completes this addition.
      // Adding more copies afterward gets a new request ID.
      sessionStorage.removeItem(retryKey);
      saved = true;
      cardPicker.close();
    } catch (error) {
      if (isCurrent()) {
        pickerStatus.textContent =
          error instanceof Error
            ? error.message
            : "Couldn’t confirm the save. Check this location before trying again.";
      }
    } finally {
      if (current === version) {
        saving = false;
        controls();
      }
    }

    if (saved && isCurrent()) {
      await openLocation(location);
      if (current === version && selectedLocation?.id === location.id) {
        status.textContent = `Added ${quantity} × ${card.name} to ${location.name}.`;
      }
    }
  });

  printingSelect.addEventListener("change", () => {
    previewCollectionPrinting();
    syncCardSave();
  });
  finishSelect.addEventListener("change", syncCardSave);
  cardPicker.addEventListener("close", () => printingController?.abort());

  function resetCardSearch() {
    searchController?.abort();
    searchForm.reset();
    searchStatus.textContent = "";
    searchResults.replaceChildren();
    printingController?.abort();
    cardPicker.close();
    cardPrintings = [];
    saveCard.disabled = true;
  }

  searchForm.addEventListener("submit", async (event) => {
    event.preventDefault();
    const query = searchQuery.value.trim();
    if (!query || !userId || loading || saving) return;

    searchController?.abort();
    const controller = new AbortController();
    searchController = controller;

    const current = version;
    const location = locationRequest;
    const isCurrent = () =>
      !controller.signal.aborted &&
      current === version &&
      location === locationRequest;

    searchResults.replaceChildren();
    searchStatus.textContent = "Searching…";

    try {
      const endpoint = new URL("https://api.scryfall.com/cards/search");
      endpoint.searchParams.set("q", `(${query}) game:paper`);
      endpoint.searchParams.set("unique", "cards");
      endpoint.searchParams.set("order", "name");

      const response = await fetchImportCard(endpoint, controller.signal);
      if (!isCurrent()) return;

      if (response.status === 404) {
        searchStatus.textContent = "No cards found. Try another name.";
        return;
      }

      if (!response.ok) {
        throw new Error("Search unavailable. Please try again.");
      }

      const page = (await response.json()) as {
        data: DeckCard[];
        has_more?: boolean;
      };
      if (!isCurrent()) return;
      if (!Array.isArray(page.data)) {
        throw new Error("Search returned incomplete results. Please retry.");
      }

      for (const card of page.data.slice(0, 20)) {
        const item = document.createElement("li");
        const name = document.createElement("strong");
        const details = document.createElement("p");

        name.textContent = card.name;
        details.textContent =
          card.type_line ?? card.card_faces?.[0]?.type_line ?? "";

        const choose = document.createElement("button");
        choose.type = "button";
        choose.textContent = "Choose printing";
        choose.setAttribute("aria-haspopup", "dialog");
        choose.addEventListener(
          "click",
          () => void chooseCollectionPrinting(card),
        );

        item.append(name, details, choose);
        searchResults.append(item);
      }

      searchStatus.textContent =
        `Showing ${Math.min(20, page.data.length)} matches.` +
        (page.has_more || page.data.length > 20
          ? " Narrow your search for other matches."
          : "");
    } catch (error) {
      if (isCurrent()) {
        searchStatus.textContent =
          error instanceof Error
            ? error.message
            : "Search failed. Please retry.";
      }
    }
  });

  async function saveStoredQuantity(card: StoredCard, quantity: number) {
    if (!userId || loading || saving || !selectedLocation) return;

    if (!Number.isSafeInteger(quantity) || quantity < 1 || quantity > 1000000) {
      cardsStatus.textContent =
        "Enter a whole-number quantity between 1 and 1,000,000.";
      return;
    }

    const current = version;
    const request = locationRequest;
    const targetUser = userId;
    const location = selectedLocation;
    const isCurrent = () =>
      current === version &&
      request === locationRequest &&
      userId === targetUser;

    let saved = false;
    saving = true;
    controls();
    cardsStatus.textContent = `Saving quantity for ${card.name}…`;

    try {
      const {
        data: { session },
        error: sessionError,
      } = await supabase.auth.getSession();

      if (!isCurrent()) return;
      if (sessionError || session?.user.id !== targetUser) {
        throw new Error("Your sign-in changed. Reload before editing cards.");
      }

      const { data, error } = await supabase
        .from("collection_cards")
        .update({ quantity })
        .eq("id", card.id)
        .eq("user_id", targetUser)
        .eq("location_id", location.id)
        .eq("quantity", card.quantity)
        .select("id")
        .maybeSingle();

      if (!isCurrent()) return;

      if (error) {
        throw new Error(
          "Couldn’t confirm the quantity change. Reopen this location to check before retrying.",
        );
      }

      if (!data) {
        throw new Error(
          "This card changed since it loaded. Reopen this location before editing its quantity.",
        );
      }

      saved = true;
    } catch (error) {
      if (isCurrent()) {
        cardsStatus.textContent =
          error instanceof Error
            ? error.message
            : "Couldn’t save the quantity.";
      }
    } finally {
      if (current === version) {
        saving = false;
        controls();
      }
    }

    if (saved && isCurrent()) {
      await openLocation(location);
    }
  }

  async function moveStoredCopies(
    card: StoredCard,
    destinationId: string,
    quantity: number,
  ) {
    if (!userId || loading || saving || !selectedLocation) return;

    const source = selectedLocation;
    const destination = locations.find((item) => item.id === destinationId);

    if (
      !destination ||
      destination.id === source.id ||
      !Number.isSafeInteger(quantity) ||
      quantity < 1 ||
      quantity > card.quantity
    ) {
      cardsStatus.textContent =
        "Choose another location and a quantity within the stored total.";
      return;
    }

    const current = version;
    const request = locationRequest;
    const targetUser = userId;
    const isCurrent = () =>
      current === version &&
      request === locationRequest &&
      userId === targetUser;

    let moved = false;
    saving = true;
    controls();
    cardsStatus.textContent = `Moving ${quantity} × ${card.name}…`;

    try {
      const {
        data: { session },
        error: sessionError,
      } = await supabase.auth.getSession();

      if (!isCurrent()) return;
      if (sessionError || session?.user.id !== targetUser) {
        throw new Error("Your sign-in changed. Reload before moving cards.");
      }

      const payload = {
        p_entry_id: card.id,
        p_source_location_id: source.id,
        p_destination_location_id: destination.id,
        p_expected_quantity: card.quantity,
        p_quantity: quantity,
      };

      const retryKey =
        "binderlink:collection-move:" +
        JSON.stringify({
          userId: targetUser,
          ...payload,
        });

      let requestId = sessionStorage.getItem(retryKey);
      if (!requestId) {
        requestId = crypto.randomUUID();
        sessionStorage.setItem(retryKey, requestId);
      }

      const { data, error } = await supabase.rpc(
        "move_collection_card_copies",
        {
          p_request_id: requestId,
          ...payload,
        },
      );

      if (!isCurrent()) return;
      if (error) throw new Error(error.message);
      if (typeof data !== "string") {
        throw new Error("The server did not confirm the move.");
      }

      sessionStorage.removeItem(retryKey);
      moved = true;
    } catch (error) {
      if (isCurrent()) {
        const detail = error instanceof Error ? error.message : "Move failed.";
        cardsStatus.textContent = `${detail} Check both locations before starting a different move.`;
      }
    } finally {
      if (current === version) {
        saving = false;
        controls();
      }
    }

    if (moved && isCurrent()) {
      await openLocation(source);
      if (current === version && selectedLocation?.id === source.id) {
        status.textContent = `Moved ${quantity} × ${card.name} to ${destination.name}.`;
      }
    }
  }

  async function openLocation(location: StorageLocation) {
    if (!userId || loading || saving) return;

    const request = ++locationRequest;
    selectedLocation = location;
    resetCardSearch();
    const current = version;
    const targetUser = userId;
    const isCurrent = () =>
      request === locationRequest &&
      current === version &&
      userId === targetUser;

    cardsPanel.hidden = false;
    cardsHeading.textContent = location.name;
    cardsList.replaceChildren();
    cardsStatus.textContent = "Loading stored cards…";

    try {
      const cards = await loadAllPages<StoredCard>(
        async (from, to) => {
          const result = await supabase
            .from("collection_cards")
            .select("id, name, set_name, collector_number, finish, quantity")
            .eq("user_id", targetUser)
            .eq("location_id", location.id)
            .order("name")
            .order("id")
            .range(from, to);

          return {
            data: result.data as StoredCard[] | null,
            error: result.error,
          };
        },
        { isCurrent },
      );

      if (!isCurrent() || cards === null) return;

      for (const card of cards) {
        const item = document.createElement("li");
        const name = document.createElement("strong");
        const details = document.createElement("p");

        name.textContent = `${card.quantity} × ${card.name}`;
        details.textContent = `${card.set_name} #${card.collector_number} · ${card.finish}`;

        const edit = document.createElement("button");
        edit.type = "button";
        edit.textContent = "Edit quantity";
        edit.setAttribute("aria-expanded", "false");

        const quantityForm = document.createElement("form");
        quantityForm.className = "stored-quantity-form";
        quantityForm.hidden = true;

        const label = document.createElement("label");
        label.textContent = "Total copies stored here";

        const input = document.createElement("input");
        input.type = "number";
        input.min = "1";
        input.max = "1000000";
        input.step = "1";
        input.required = true;
        input.value = String(card.quantity);
        label.append(input);

        const save = document.createElement("button");
        save.type = "submit";
        save.textContent = "Save quantity";

        const cancel = document.createElement("button");
        cancel.type = "button";
        cancel.textContent = "Cancel";

        edit.addEventListener("click", () => {
          if (!isCurrent() || saving) return;
          quantityForm.hidden = !quantityForm.hidden;
          edit.setAttribute("aria-expanded", String(!quantityForm.hidden));
          if (!quantityForm.hidden) {
            input.value = String(card.quantity);
            input.focus();
          }
        });

        cancel.addEventListener("click", () => {
          quantityForm.hidden = true;
          edit.setAttribute("aria-expanded", "false");
          edit.focus();
        });

        quantityForm.addEventListener("submit", async (event) => {
          event.preventDefault();
          if (!isCurrent() || saving || !input.reportValidity()) return;

          save.disabled = true;
          try {
            await saveStoredQuantity(card, Number(input.value));
          } finally {
            save.disabled = false;
          }
        });

        quantityForm.append(label, save, cancel);

        const move = document.createElement("button");
        move.type = "button";
        move.textContent = "Move cards";
        move.setAttribute("aria-expanded", "false");

        const moveForm = document.createElement("form");
        moveForm.className = "stored-quantity-form stored-move-form";
        moveForm.hidden = true;

        const destinationLabel = document.createElement("label");
        destinationLabel.textContent = "Move to";

        const destinationSelect = document.createElement("select");
        destinationSelect.required = true;
        destinationSelect.add(new Option("Choose a location", ""));

        for (const destination of [...locations].sort((a, b) =>
          a.name.localeCompare(b.name),
        )) {
          if (destination.id === location.id) continue;
          destinationSelect.add(new Option(destination.name, destination.id));
        }

        destinationLabel.append(destinationSelect);
        move.disabled = destinationSelect.options.length < 2;

        const amountLabel = document.createElement("label");
        amountLabel.textContent = "Copies to move";

        const amount = document.createElement("input");
        amount.type = "number";
        amount.min = "1";
        amount.max = String(card.quantity);
        amount.step = "1";
        amount.required = true;
        amount.value = "1";
        amountLabel.append(amount);

        const moveSave = document.createElement("button");
        moveSave.type = "submit";
        moveSave.textContent = "Move copies";

        const moveCancel = document.createElement("button");
        moveCancel.type = "button";
        moveCancel.textContent = "Cancel";

        move.addEventListener("click", () => {
          if (!isCurrent() || saving) return;

          moveForm.hidden = !moveForm.hidden;
          move.setAttribute("aria-expanded", String(!moveForm.hidden));

          if (!moveForm.hidden) {
            quantityForm.hidden = true;
            edit.setAttribute("aria-expanded", "false");
            destinationSelect.focus();
          }
        });

        moveCancel.addEventListener("click", () => {
          moveForm.hidden = true;
          move.setAttribute("aria-expanded", "false");
          move.focus();
        });

        edit.addEventListener("click", () => {
          if (!isCurrent() || saving) return;
          moveForm.hidden = true;
          move.setAttribute("aria-expanded", "false");
        });

        moveForm.addEventListener("submit", async (event) => {
          event.preventDefault();
          if (!isCurrent() || saving || !moveForm.reportValidity()) return;

          const destinationId = destinationSelect.value;
          const quantity = Number(amount.value);
          moveSave.disabled = true;
          destinationSelect.disabled = true;
          amount.disabled = true;

          try {
            await moveStoredCopies(card, destinationId, quantity);
          } finally {
            moveSave.disabled = false;
            destinationSelect.disabled = false;
            amount.disabled = false;
          }
        });

        moveForm.append(destinationLabel, amountLabel, moveSave, moveCancel);

        item.append(name, details, edit, move, quantityForm, moveForm);
        cardsList.append(item);
      }

      const copies = cards.reduce((sum, card) => sum + card.quantity, 0);
      cardsStatus.textContent = cards.length
        ? `${copies} card copies across ${cards.length} printing and finish entries.`
        : "No cards stored here yet.";
    } catch {
      if (isCurrent()) {
        cardsStatus.textContent =
          "Couldn’t load these cards. Click the location to try again.";
      }
    }
  }

  let locations: StorageLocation[] = [];
  let userId: string | null = null;
  let version = 0;
  let loading = true;
  let saving = false;

  function controls() {
    const disabled = !userId || loading || saving;
    nameInput.disabled = disabled;
    addButton.disabled = disabled;
    dumpButton.disabled =
      disabled || locations.some((location) => location.is_dump_box);
    dumpButton.textContent = locations.some((location) => location.is_dump_box)
      ? "Dump box created"
      : "Create Dump box";

    syncCardSave();
  }

  function renderLocations() {
    list.replaceChildren();

    for (const location of [...locations].sort(
      (a, b) =>
        Number(b.is_dump_box) - Number(a.is_dump_box) ||
        a.name.localeCompare(b.name),
    )) {
      const item = document.createElement("li");
      const button = document.createElement("button");
      button.type = "button";
      button.textContent = location.name;
      button.addEventListener("click", () => void openLocation(location));
      item.append(button);

      if (location.is_dump_box) {
        const note = document.createElement("span");
        note.textContent = " · Unsorted cards";
        item.append(note);
      }

      list.append(item);
    }
  }

  async function loadLocations() {
    const current = ++version;
    loading = true;
    content.hidden = true;
    locations = [];
    list.replaceChildren();
    controls();

    try {
      const {
        data: { session },
        error: sessionError,
      } = await supabase.auth.getSession();

      if (current !== version) return;
      if (sessionError) throw sessionError;

      userId = session?.user.id ?? null;
      if (!userId) {
        status.textContent = "Sign in on BinderLink to manage your collection.";
        return;
      }

      const targetUser = userId;
      status.textContent = "Loading your storage locations…";

      const data = await loadAllPages<StorageLocation>(
        async (from, to) => {
          const result = await supabase
            .from("collection_locations")
            .select("id, name, is_dump_box")
            .eq("user_id", targetUser)
            .order("id")
            .range(from, to);

          return {
            data: result.data as StorageLocation[] | null,
            error: result.error,
          };
        },
        { isCurrent: () => current === version },
      );

      if (current !== version || data === null) return;

      locations = data;
      renderLocations();
      content.hidden = false;
      status.textContent = locations.length
        ? "Your storage locations are private."
        : "Create a Dump box or your first named location.";
    } catch {
      if (current !== version) return;
      status.textContent =
        "Couldn’t load your locations. Refresh to try again.";
    } finally {
      if (current === version) {
        loading = false;
        controls();
      }
    }
  }

  async function createLocation(name: string, isDumpBox: boolean) {
    if (!userId || loading || saving) return;

    const trimmed = name.trim();
    if (!trimmed || trimmed.length > 100) {
      status.textContent =
        "Enter a location name between 1 and 100 characters.";
      return;
    }

    const current = version;
    const targetUser = userId;
    saving = true;
    controls();
    status.textContent = "Creating location…";

    try {
      const {
        data: { session },
        error: sessionError,
      } = await supabase.auth.getSession();

      if (current !== version) return;
      if (sessionError || session?.user.id !== targetUser) {
        status.textContent =
          "Your sign-in changed. Refresh before trying again.";
        return;
      }

      const { data, error } = await supabase
        .from("collection_locations")
        .insert({ name: trimmed, is_dump_box: isDumpBox })
        .select("id, name, is_dump_box")
        .single();

      if (current !== version) return;

      if (error) {
        status.textContent =
          error.code === "23505"
            ? "That location name or Dump box already exists. Refresh your list."
            : "Couldn’t create the location. Please try again.";
        return;
      }

      locations.push(data as StorageLocation);
      renderLocations();
      if (!isDumpBox) form.reset();
      status.textContent = `Created “${trimmed}”.`;
    } catch {
      if (current === version) {
        status.textContent = "Couldn’t create the location. Please try again.";
      }
    } finally {
      if (current === version) {
        saving = false;
        controls();
      }
    }
  }

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    void createLocation(nameInput.value, false);
  });

  dumpButton.addEventListener("click", () => {
    void createLocation("Dump box", true);
  });

  const accountChanged = createAccountChangeGuard(true);
  let authTimer: number | undefined;

  supabase.auth.onAuthStateChange((event, session) => {
    if (!accountChanged(event, session)) return;

    version++;
    locationRequest++;
    selectedLocation = null;
    resetCardSearch();
    cardsList.replaceChildren();
    cardsPanel.hidden = true;
    cardsHeading.textContent = "Stored cards";
    cardsStatus.textContent = "";
    userId = session?.user.id ?? null;
    loading = true;
    saving = false;
    locations = [];
    list.replaceChildren();
    form.reset();
    content.hidden = true;
    status.textContent = userId
      ? "Loading your collection…"
      : "Sign in on BinderLink to manage your collection.";
    controls();

    window.clearTimeout(authTimer);
    authTimer = window.setTimeout(() => void loadLocations(), 0);
  });
</script>

