<div class="account-root">
  <details class="account-guest">
    <summary class="account-login-trigger">Log in</summary>

    <div class="account-panel">
      <p class="account-panel-heading">Chase list account</p>

      <form class="account-form">
        <label>
          Email
          <input name="email" type="email" required autocomplete="email" />
        </label>

        <label>
          Password
          <input
            name="password"
            type="password"
            required
            minlength="6"
            autocomplete="current-password"
          />
        </label>

        <div class="account-actions">
          <button
            type="submit"
            data-account-action="login"
            class="account-primary"
          >
            Log in
          </button>

          <button
            type="submit"
            data-account-action="signup"
            class="account-secondary"
          >
            Sign up
          </button>
        </div>

        <p class="account-form-status" role="status"></p>
      </form>
    </div>
  </details>

  <details class="account-signed-in" hidden>
    <summary class="account-name-trigger">
      <span class="account-name">My account</span>
      <span class="account-role-badge" hidden></span>
      <span class="account-chevron" aria-hidden="true">⌄</span>
    </summary>

    <div class="account-panel account-options">
      <div class="account-identity">
        <p class="account-profile-name">My account</p>
        <p class="account-profile-username"></p>
        <p class="account-access-label"></p>
      </div>

      <button type="button" class="account-edit"> Edit profile </button>

      <button type="button" class="account-sign-out"> Log out </button>

      <p class="account-member-status" role="status"></p>
    </div>
  </details>
</div>

<script>
  import { supabase } from "@/lib/supabase";

  type AccountRole = "owner" | "contributor" | "member";
  type AccessLevel = "free" | "paid" | "complimentary";

  const guests =
    document.querySelectorAll<HTMLDetailsElement>(".account-guest");

  const members =
    document.querySelectorAll<HTMLDetailsElement>(".account-signed-in");

  const names = document.querySelectorAll<HTMLElement>(".account-name");

  const profileNames = document.querySelectorAll<HTMLElement>(
    ".account-profile-name",
  );

  const profileUsernames = document.querySelectorAll<HTMLElement>(
    ".account-profile-username",
  );

  const badges = document.querySelectorAll<HTMLElement>(".account-role-badge");

  const accessLabels = document.querySelectorAll<HTMLElement>(
    ".account-access-label",
  );

  const formStatuses = document.querySelectorAll<HTMLElement>(
    ".account-form-status",
  );

  const memberStatuses = document.querySelectorAll<HTMLElement>(
    ".account-member-status",
  );

  const forms = document.querySelectorAll<HTMLFormElement>(".account-form");

  const signOutButtons =
    document.querySelectorAll<HTMLButtonElement>(".account-sign-out");

  let busy = false;
  let requestId = 0;
  let displayedUserId: string | null = null;

  function setFormStatus(message: string) {
    formStatuses.forEach((node) => {
      node.textContent = message;
    });
  }

  function setMemberStatus(message: string) {
    memberStatuses.forEach((node) => {
      node.textContent = message;
    });
  }

  function setName(name: string, username?: string) {
    names.forEach((node) => {
      node.textContent = name;
      node.title = username ? `${name} · @${username}` : name;
    });

    profileNames.forEach((node) => {
      node.textContent = name;
    });

    profileUsernames.forEach((node) => {
      node.textContent = username ? `@${username}` : "";
    });
  }

  function clearAccess() {
    badges.forEach((badge) => {
      badge.hidden = true;
      badge.textContent = "";
      delete badge.dataset.role;
    });

    accessLabels.forEach((node) => {
      node.textContent = "";
    });
  }

  function showAccess(role: AccountRole, access: AccessLevel) {
    const roleLabels: Record<AccountRole, string> = {
      owner: "Owner",
      contributor: "Contributor",
      member: "Member",
    };

    const planLabels: Record<AccessLevel, string> = {
      free: "Free access",
      paid: "Paid access",
      complimentary: "Complimentary access",
    };

    badges.forEach((badge) => {
      badge.textContent = roleLabels[role];
      badge.dataset.role = role;
      badge.hidden = false;
    });

    accessLabels.forEach((node) => {
      node.textContent = planLabels[access];
    });
  }

  function showSession(signedIn: boolean) {
    guests.forEach((panel) => {
      panel.hidden = signedIn;
      if (signedIn) panel.open = false;
    });

    members.forEach((panel) => {
      panel.hidden = !signedIn;
      if (!signedIn) panel.open = false;
    });

    if (!signedIn) {
      displayedUserId = null;
      setName("My account");
      clearAccess();
    }
  }

  function setBusy(value: boolean) {
    busy = value;

    document
      .querySelectorAll<HTMLButtonElement>(".account-root button")
      .forEach((button) => {
        button.disabled = value;
      });
  }

  function errorMessage(error: unknown) {
    if (
      typeof error === "object" &&
      error !== null &&
      "message" in error &&
      typeof error.message === "string"
    ) {
      return error.message;
    }

    return "Something went wrong. Please try again.";
  }

  async function refreshSession() {
    const currentRequest = ++requestId;

    try {
      const { data, error } = await supabase.auth.getSession();

      if (currentRequest !== requestId) return;

      if (error) {
        setFormStatus(error.message);
        setMemberStatus(error.message);
        return;
      }

      const session = data.session;

      if (!session) {
        showSession(false);
        return;
      }

      const userId = session.user.id;

      if (displayedUserId !== userId) {
        displayedUserId = userId;
        setName("My account");
        clearAccess();
      }

      showSession(true);

      const [profileResult, accessResult] = await Promise.all([
        supabase
          .from("profiles")
          .select("username, display_name")
          .eq("id", userId)
          .maybeSingle(),

        supabase
          .from("account_access")
          .select("role, access_level")
          .eq("user_id", userId)
          .maybeSingle(),
      ]);

      if (currentRequest !== requestId) return;

      const messages: string[] = [];

      if (profileResult.error) {
        setName("My account");
        messages.push("Couldn’t load your display name.");
      } else if (profileResult.data) {
        setName(profileResult.data.display_name, profileResult.data.username);
      } else {
        setName("My account");
      }

      const account = accessResult.data;

      if (accessResult.error || !account) {
        clearAccess();
        messages.push("Couldn’t load your account level.");
      } else {
        const validRole =
          account.role === "owner" ||
          account.role === "contributor" ||
          account.role === "member";

        const validAccess =
          account.access_level === "free" ||
          account.access_level === "paid" ||
          account.access_level === "complimentary";

        if (validRole && validAccess) {
          showAccess(
            account.role as AccountRole,
            account.access_level as AccessLevel,
          );
        } else {
          clearAccess();
          messages.push("Your account level couldn’t be recognized.");
        }
      }

      setMemberStatus(
        messages.length ? `${messages.join(" ")} Try refreshing.` : "",
      );
    } catch (error) {
      if (currentRequest === requestId) {
        clearAccess();

        const message = errorMessage(error);
        setFormStatus(message);
        setMemberStatus(message);
      }
    }
  }

  forms.forEach((form) => {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (busy) return;

      const action =
        event.submitter instanceof HTMLButtonElement &&
        event.submitter.dataset.accountAction === "signup"
          ? "signup"
          : "login";

      const values = new FormData(form);
      const email = String(values.get("email") ?? "").trim();
      const password = String(values.get("password") ?? "");

      if (!email || !password) {
        setFormStatus("Email and password are required.");
        return;
      }

      setBusy(true);
      setMemberStatus("");
      setFormStatus(action === "signup" ? "Creating account…" : "Logging in…");

      try {
        if (action === "signup") {
          const { data, error } = await supabase.auth.signUp({
            email,
            password,
          });

          if (error) throw error;

          setFormStatus(
            data.session
              ? ""
              : "Check your email to confirm your account before logging in.",
          );
        } else {
          const { error } = await supabase.auth.signInWithPassword({
            email,
            password,
          });

          if (error) throw error;
          setFormStatus("");
        }

        forms.forEach((accountForm) => accountForm.reset());

        await refreshSession();
        window.dispatchEvent(new Event("chase-cards-changed"));
      } catch (error) {
        setFormStatus(errorMessage(error));
      } finally {
        setBusy(false);
      }
    });
  });

  signOutButtons.forEach((button) => {
    button.addEventListener("click", async () => {
      if (busy) return;

      setBusy(true);
      setMemberStatus("Logging out…");

      try {
        const { error } = await supabase.auth.signOut();

        if (error) throw error;

        requestId++;
        showSession(false);
        setFormStatus("");
        setMemberStatus("");

        forms.forEach((form) => form.reset());
        window.dispatchEvent(new Event("chase-cards-changed"));
      } catch (error) {
        setMemberStatus(errorMessage(error));
      } finally {
        setBusy(false);
      }
    });
  });

  document
    .querySelectorAll<HTMLButtonElement>(".account-edit")
    .forEach((button) => {
      button.addEventListener("click", () => {
        if (busy) return;

        const mobileMenu =
          button.closest<HTMLDetailsElement>("[data-header-menu]");

        const accountMenu = button.closest("details");

        const opener = mobileMenu
          ? mobileMenu.querySelector<HTMLElement>("summary")
          : accountMenu?.querySelector<HTMLElement>("summary");

        document
          .querySelectorAll<HTMLDetailsElement>("header details")
          .forEach((panel) => {
            panel.open = false;
          });

        window.dispatchEvent(
          new CustomEvent("open-player-profile", {
            detail: { opener },
          }),
        );
      });
    });

  supabase.auth.onAuthStateChange((_event, session) => {
    if (!session) {
      requestId++;
      showSession(false);
    } else {
      if (displayedUserId !== session.user.id) {
        requestId++;
        displayedUserId = session.user.id;
        setName("My account");
        clearAccess();
      }

      showSession(true);
    }

    window.setTimeout(() => {
      void refreshSession();
    }, 0);
  });

  window.addEventListener("player-profile-changed", () => {
    void refreshSession();
  });

  void refreshSession();
</script>

<style>
  [hidden] {
    display: none !important;
  }

  .account-root {
    position: relative;
    min-width: 0;
  }

  summary {
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .account-login-trigger,
  .account-name-trigger {
    display: flex;
    min-height: 44px;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 0.85rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .account-login-trigger {
    border: 1px solid var(--color-pyroduck-plasma);
    color: var(--color-brand-text);
  }

  .account-name-trigger {
    flex-wrap: wrap;
    color: var(--color-pyroduck-lime);
  }

  .account-name {
    min-width: 0;
    max-width: 10rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .account-name-trigger:hover,
  .account-login-trigger:hover {
    background: var(--color-pyroduck-afterdark);
  }

  .account-chevron {
    flex-shrink: 0;
    margin-left: auto;
  }

  details[open] > summary .account-chevron {
    transform: rotate(180deg);
  }

  .account-role-badge {
    flex-shrink: 0;
    padding: 0.2rem 0.45rem;
    border: 1px solid var(--color-pyroduck-plasma);
    border-radius: 999px;
    color: var(--color-brand-muted);
    font-size: 0.65rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .account-role-badge[data-role="owner"] {
    border-color: var(--color-pyroduck-lime);
    background: var(--color-pyroduck-lime);
    color: var(--color-pyroduck-void);
  }

  .account-role-badge[data-role="contributor"] {
    border-color: var(--color-pyroduck-plasma);
    background: var(--color-pyroduck-royal);
    color: var(--color-brand-text);
  }

  .account-panel {
    box-sizing: border-box;
    margin-top: 0.5rem;
    padding: 1rem;
    border: 1px solid
      color-mix(in srgb, var(--color-pyroduck-plasma) 35%, transparent);
    border-radius: 0.75rem;
    background: var(--color-pyroduck-void);
    box-shadow: 0 12px 32px rgb(0 0 0 / 45%);
  }

  .account-panel-heading {
    margin: 0 0 1rem;
    color: var(--color-brand-text);
    font-weight: 600;
  }

  .account-form {
    display: grid;
    gap: 1rem;
  }

  label {
    display: grid;
    gap: 0.4rem;
    color: var(--color-brand-text);
    font-size: 0.875rem;
    font-weight: 600;
  }

  input {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    min-height: 44px;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--color-pyroduck-plasma);
    border-radius: 0.5rem;
    background: var(--color-pyroduck-afterdark);
    color: var(--color-brand-text);
    font: inherit;
  }

  .account-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  button {
    min-height: 44px;
    padding: 0.65rem 1rem;
    border-radius: 0.5rem;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .account-primary {
    border: 1px solid var(--color-pyroduck-plasma);
    background: var(--color-pyroduck-plasma);
    color: var(--color-pyroduck-void);
  }

  .account-primary:hover:not(:disabled) {
    background: var(--color-pyroduck-lime);
    border-color: var(--color-pyroduck-lime);
  }

  .account-secondary {
    border: 1px solid var(--color-pyroduck-plasma);
    background: transparent;
    color: var(--color-brand-text);
  }

  .account-options {
    display: grid;
    gap: 0.25rem;
    padding: 0.5rem;
  }

  .account-identity {
    padding: 0.65rem 1rem 1rem;
    margin-bottom: 0.25rem;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-pyroduck-plasma) 25%, transparent);
    overflow-wrap: anywhere;
  }

  .account-profile-name {
    margin: 0;
    color: var(--color-brand-text);
    font-weight: 600;
  }

  .account-profile-username,
  .account-access-label {
    margin: 0.35rem 0 0;
    color: var(--color-brand-muted);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .account-access-label {
    color: var(--color-pyroduck-lime);
  }

  .account-profile-username:empty,
  .account-access-label:empty {
    display: none;
  }

  .account-options button {
    width: 100%;
    border: 0;
    background: transparent;
    color: var(--color-brand-text);
    text-align: left;
  }

  .account-options button:hover:not(:disabled),
  .account-secondary:hover:not(:disabled) {
    background: var(--color-pyroduck-afterdark);
    color: var(--color-pyroduck-lime);
  }

  .account-form-status,
  .account-member-status {
    margin: 0;
    color: var(--color-brand-muted);
    font-size: 0.875rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .account-member-status:not(:empty) {
    padding: 0.5rem;
  }

  .account-form-status:empty,
  .account-member-status:empty {
    display: none;
  }

  summary:focus-visible,
  input:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--color-pyroduck-lime);
    outline-offset: 3px;
  }

  button:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  @media (min-width: 640px) {
    .account-panel {
      position: absolute;
      right: 0;
      top: 100%;
      z-index: 60;
      width: min(20rem, calc(100vw - 2rem));
    }

    .account-options {
      width: 15rem;
    }
  }
</style>
