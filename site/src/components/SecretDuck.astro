<div class="secret-duck">
  <button
    type="button"
    class="duck-trigger"
    aria-label="A little duck is hiding here"
    aria-haspopup="dialog"
  >
    <span aria-hidden="true">
      <svg viewBox="0 0 64 64" fill="none" class="rubber-duck">
        <path d="M45 26h13c3 0 4 4 1 6l-13 5" fill="#FF922B"></path>
        <path
          d="M29 34c-5-5-5-11-2-16 3-6 11-8 17-5 7 3 10 12 6 19l-4 7c7 1 11 5 10 10-1 8-11 12-25 12C15 61 6 54 7 42c0-5 2-9 5-12 2 7 8 10 17 4Z"
          fill="#FFD43B"></path>
        <path d="M19 43c5-3 13-3 19 0-1 7-13 10-19 0Z" fill="#F5B800"></path>
        <path
          d="M30 19c2-3 5-4 8-4"
          stroke="#FFF3A3"
          stroke-width="3"
          stroke-linecap="round"></path>
        <circle cx="43" cy="23" r="2.5" fill="#20152A"></circle>
        <circle cx="43.7" cy="22.3" r="0.8" fill="white"></circle>
      </svg>
    </span>
  </button>

  <dialog class="duck-dialog" aria-labelledby="duck-title">
    <button type="button" class="duck-close" aria-label="Close duck discovery">
      ✕
    </button>

    <div class="duck-confetti" aria-hidden="true"></div>

    <span class="duck-mascot" aria-hidden="true">
      <span aria-hidden="true">
        <svg viewBox="0 0 64 64" fill="none" class="rubber-duck">
          <path d="M45 26h13c3 0 4 4 1 6l-13 5" fill="#FF922B"></path>
          <path
            d="M29 34c-5-5-5-11-2-16 3-6 11-8 17-5 7 3 10 12 6 19l-4 7c7 1 11 5 10 10-1 8-11 12-25 12C15 61 6 54 7 42c0-5 2-9 5-12 2 7 8 10 17 4Z"
            fill="#FFD43B"></path>
          <path d="M19 43c5-3 13-3 19 0-1 7-13 10-19 0Z" fill="#F5B800"></path>
          <path
            d="M30 19c2-3 5-4 8-4"
            stroke="#FFF3A3"
            stroke-width="3"
            stroke-linecap="round"></path>
          <circle cx="43" cy="23" r="2.5" fill="#20152A"></circle>
          <circle cx="43.7" cy="22.3" r="0.8" fill="white"></circle>
        </svg>
      </span>
    </span>

    <p class="duck-eyebrow">Secret duck discovered</p>
    <h2 id="duck-title">Well, duck. You found me.</h2>
    <p class="duck-message">
      A little curiosity goes a long way. Thanks for exploring PyroDuck Tech.
    </p>

    <button type="button" class="duck-dismiss"> Keep exploring </button>
  </dialog>
</div>

<script>
  const trigger = document.querySelector<HTMLButtonElement>(".duck-trigger");
  const dialog = document.querySelector<HTMLDialogElement>(".duck-dialog");
  const title = document.querySelector<HTMLElement>("#duck-title");
  const message = document.querySelector<HTMLElement>(".duck-message");
  const confetti = document.querySelector<HTMLElement>(".duck-confetti");

  const storageKey = "pyroduck-secret-duck-found";
  let cleanupTimer: number | undefined;

  function celebrate() {
    if (!confetti) return;

    window.clearTimeout(cleanupTimer);
    confetti.replaceChildren();

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      return;
    }

    for (let index = 0; index < 28; index++) {
      const piece = document.createElement("span");
      piece.className = "duck-confetti-piece";
      piece.style.setProperty("--x", `${Math.random() * 100}%`);
      piece.style.setProperty("--drift", `${Math.random() * 160 - 80}px`);
      piece.style.setProperty("--delay", `${Math.random() * 0.3}s`);
      piece.style.setProperty("--rotation", `${Math.random() * 720 - 360}deg`);
      piece.style.setProperty(
        "--piece-color",
        index % 2 === 0
          ? "var(--color-pyroduck-plasma)"
          : "var(--color-pyroduck-lime)",
      );

      confetti.append(piece);
    }

    cleanupTimer = window.setTimeout(() => {
      confetti.replaceChildren();
    }, 2400);
  }

  trigger?.addEventListener("click", () => {
    if (!dialog || dialog.open) return;

    let foundBefore = false;

    try {
      foundBefore = localStorage.getItem(storageKey) === "yes";
      localStorage.setItem(storageKey, "yes");
    } catch {
      // The duck still works when browser storage is unavailable.
    }

    if (title) {
      title.textContent = foundBefore
        ? "Found you again."
        : "Well, duck. You found me.";
    }

    if (message) {
      message.textContent = foundBefore
        ? "Back for another quack? Your secret is safe with me."
        : "A little curiosity goes a long way. Thanks for exploring PyroDuck Tech.";
    }

    dialog.showModal();
    celebrate();
  });

  dialog
    ?.querySelectorAll<HTMLButtonElement>(".duck-close, .duck-dismiss")
    .forEach((button) => {
      button.addEventListener("click", () => dialog.close());
    });

  dialog?.addEventListener("close", () => {
    window.clearTimeout(cleanupTimer);
    confetti?.replaceChildren();
    trigger?.focus();
  });
</script>

<style>
  .secret-duck {
    position: relative;
    width: 100%;
    height: 0;
  }

  .duck-trigger {
    position: absolute;
    right: clamp(1rem, 4vw, 3rem);
    bottom: 0;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 0.75rem;
    background: transparent;
    cursor: pointer;
  }

  .duck-trigger span {
    display: block;
    font-size: 1.125rem;
    opacity: 0.45;
    transform: rotate(-16deg);
    transition:
      opacity 180ms ease,
      transform 180ms ease,
      filter 180ms ease;
  }

  .duck-trigger:hover span,
  .duck-trigger:focus-visible span {
    opacity: 1;
    transform: rotate(0deg) translateY(-3px);
    filter: drop-shadow(0 0 6px var(--color-pyroduck-lime));
  }

  .duck-trigger:focus-visible,
  .duck-close:focus-visible,
  .duck-dismiss:focus-visible {
    outline: 2px solid var(--color-pyroduck-lime);
    outline-offset: 4px;
  }

  .duck-dialog {
    box-sizing: border-box;
    width: min(28rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: 3rem 1.5rem 2rem;
    overflow: auto;
    border: 1px solid var(--color-pyroduck-plasma);
    border-radius: 1.5rem;
    background: var(--color-pyroduck-afterdark);
    color: var(--color-brand-text);
    text-align: center;
    box-shadow: 0 0 50px
      color-mix(in srgb, var(--color-pyroduck-plasma) 25%, transparent);
  }

  .duck-dialog::backdrop {
    background: rgb(0 0 0 / 85%);
  }

  .duck-close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 2;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 0.5rem;
    background: transparent;
    color: var(--color-brand-text);
    font: inherit;
    cursor: pointer;
  }

  .duck-close:hover {
    color: var(--color-pyroduck-lime);
  }

  .duck-mascot {
    position: relative;
    display: inline-block;
    font-size: 4rem;
    line-height: 1.2;
  }

  .duck-dialog[open] .duck-mascot {
    animation: duck-pop 450ms ease-out;
  }

  .duck-eyebrow {
    margin: 1.5rem 0 0.75rem;
    color: var(--color-pyroduck-lime);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  #duck-title {
    margin: 0;
    font-size: clamp(1.5rem, 5vw, 2rem);
    font-weight: 700;
    line-height: 1.2;
  }

  .duck-message {
    margin: 1rem 0 1.5rem;
    color: var(--color-brand-muted);
    line-height: 1.7;
  }

  .duck-dismiss {
    min-height: 44px;
    padding: 0.75rem 1.25rem;
    border: 0;
    border-radius: 0.5rem;
    background: var(--color-pyroduck-plasma);
    color: var(--color-pyroduck-void);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .duck-dismiss:hover {
    background: var(--color-pyroduck-lime);
  }

  .duck-confetti {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
  }

  .duck-confetti :global(.duck-confetti-piece) {
    position: absolute;
    top: -1rem;
    left: var(--x);
    width: 7px;
    height: 12px;
    border-radius: 2px;
    background: var(--piece-color);
    opacity: 0;
    animation: duck-confetti-fall 1.8s ease-in var(--delay) both;
  }

  @keyframes duck-pop {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.6);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes duck-confetti-fall {
    0% {
      opacity: 0;
      transform: translateY(0) rotate(0deg);
    }
    10% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate(var(--drift), 500px) rotate(var(--rotation));
    }
  }

  .rubber-duck {
    display: block;
    width: 100%;
    height: 100%;
  }

  .duck-trigger span {
    width: 16px;
    height: 16px;
    opacity: 0.18;
    filter: grayscale(1);
    transform: rotate(-22deg);
  }

  .duck-trigger:hover span,
  .duck-trigger:focus-visible span {
    opacity: 1;
    filter: drop-shadow(0 0 4px var(--color-pyroduck-lime));
    transform: rotate(0deg) translateY(-2px);
  }

  .duck-mascot {
    width: 80px;
    height: 80px;
  }

  @media (prefers-reduced-motion: reduce) {
    .duck-trigger span {
      transition: none;
    }

    .duck-dialog[open] .duck-mascot {
      animation: none;
    }
  }
</style>
