---
import { Image } from "astro:assets";
import type { Project } from "@/data/projects";

type Props = Project;

const { name, status, description, url, image, imageAlt } = Astro.props;
---

<article
  class="project-card rounded-2xl border border-pyroduck-plasma/30 bg-pyroduck-afterdark p-6 sm:p-8"
>
  {
    image && (
      <Image
        src={image}
        alt={imageAlt ?? `${name} website preview`}
        width={960}
        format="webp"
        loading="lazy"
        class="mb-6 h-auto w-full rounded-lg border border-pyroduck-plasma/20"
      />
    )
  }

  <p class="text-sm font-medium text-pyroduck-lime">{status}</p>

  <h3 class="mt-3 text-2xl font-bold text-brand-text">{name}</h3>

  <p class="mt-4 leading-relaxed text-brand-muted">{description}</p>

  {
    url && (
      <a
        href={url}
        class="mt-6 inline-flex rounded-sm font-semibold text-pyroduck-plasma transition-colors hover:text-pyroduck-lime focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-pyroduck-lime"
      >
        Visit Website{" "}
        <span aria-hidden="true" class="ml-2">
          ↗
        </span>
      </a>
    )
  }
</article>

<style>
  .project-card {
    position: relative;
    isolation: auto;
    top: 0;

    box-shadow:
      inset 0 1px 0
        color-mix(in srgb, var(--color-pyroduck-plasma) 15%, transparent),
      0 5px 0 var(--color-pyroduck-void),
      0 6px 0 color-mix(in srgb, var(--color-pyroduck-plasma) 25%, transparent),
      0 12px 18px rgb(0 0 0 / 45%);

    transition: top 180ms ease;
  }

  .project-card::before {
    content: "";
    position: absolute;
    left: 8%;
    right: 8%;
    bottom: -8px;
    height: 24px;
    z-index: -1;
    pointer-events: none;
    border-radius: 50%;
    background: var(--color-pyroduck-plasma);
    opacity: 0.45;
    filter: blur(20px);
  }

  @media (hover: hover) and (pointer: fine) {
    .project-card:hover {
      top: -3px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card {
      transition: none;
    }

    .project-card:hover {
      top: 0;
    }
  }
</style>
