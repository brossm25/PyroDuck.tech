---
import { site } from "@/data/site";
import CircuitLine from "@/components/CircuitLine.astro";

const navigation = [
  { label: "Work", href: "/#work" },
  { label: "About", href: "/#about" },
  { label: "Contact", href: "/#contact" },
];
---

<header class="sticky top-0 z-50 bg-pyroduck-void">
  <div
    class="relative grid w-full grid-cols-[1fr_auto_1fr] items-center gap-3 px-4 py-2 sm:flex sm:gap-4 sm:px-6 lg:px-8"
  >
    <!-- Logo -->
    <a
      href="/"
      class="col-start-1 row-start-1 justify-self-start rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-pyroduck-lime sm:shrink-0"
      aria-label={`${site.name} homepage`}
    >
      <img
        src="/images/pyroduck-logo-primary-web-safe.svg"
        alt={`${site.name} logo`}
        width="96"
        height="96"
        class="h-16 w-16 object-contain sm:h-20 sm:w-20 lg:h-24 lg:w-24"
      />
    </a>

    <!-- Site name -->
    <a
      href="/"
      class="col-start-2 row-start-1 rounded-lg text-center focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-pyroduck-lime"
    >
      <span
        class="bg-linear-to-r from-brand-text via-pyroduck-plasma to-pyroduck-lime bg-clip-text text-xl font-bold tracking-wide text-transparent sm:text-2xl"
      >
        {site.name}
      </span>
    </a>

    <!-- Mobile navigation -->
    <details
      class="group relative col-start-3 row-start-1 justify-self-end sm:hidden"
      data-header-menu
    >
      <summary
        class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-lg text-brand-text transition-colors hover:text-pyroduck-lime focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-pyroduck-lime [&::-webkit-details-marker]:hidden"
        aria-label="Main navigation menu"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          class="h-7 w-7"
          aria-hidden="true"
        >
          <path d="M4 6h16M4 12h16M4 18h16" class="group-open:hidden"></path>
          <path d="m6 6 12 12M18 6 6 18" class="hidden group-open:block"></path>
        </svg>
      </summary>

      <nav
        aria-label="Mobile navigation"
        class="absolute right-0 top-full mt-3 min-w-56 rounded-xl border border-pyroduck-plasma/30 bg-black p-2 shadow-xl"
      >
        {
          navigation.map(({ label, href }) => (
            <a
              href={href}
              class="block rounded-lg px-4 py-3 text-lg font-medium text-brand-text transition-colors hover:bg-pyroduck-plasma/10 hover:text-pyroduck-lime focus-visible:outline-2 focus-visible:outline-pyroduck-lime"
            >
              {label}
            </a>
          ))
        }

        <div class="mt-2 border-t border-pyroduck-plasma/20 px-2 pt-2">
          <div class="header-auth-signed-in hidden space-y-2">
            <p class="header-auth-email truncate px-2 text-sm text-pyroduck-lime font-semibold">
            </p>
            <button
              type="button"
              class="header-auth-sign-out w-full rounded-lg border border-pyroduck-plasma px-4 py-2.5 text-left text-base font-semibold text-brand-text transition-colors hover:bg-pyroduck-plasma/15 focus-visible:outline-2 focus-visible:outline-pyroduck-lime"
            >
              Log out
            </button>
          </div>

          <details class="header-auth-guest group/auth relative">
            <summary
              class="cursor-pointer list-none rounded-lg px-4 py-3 text-lg font-medium text-brand-text transition-colors hover:bg-pyroduck-plasma/10 hover:text-pyroduck-lime focus-visible:outline-2 focus-visible:outline-pyroduck-lime [&::-webkit-details-marker]:hidden"
            >
              Log in
            </summary>
            <div
              class="mt-2 rounded-lg border border-pyroduck-plasma/30 bg-pyroduck-afterdark p-3"
            >
              <p
                class="header-auth-status mb-3 text-sm text-pyroduck-lime font-semibold"
                role="status"
              >
              </p>
              <form class="header-auth-form flex flex-col gap-3">
                <div>
                  <label
                    for="header-auth-email-mobile"
                    class="mb-1 block text-sm font-semibold text-brand-text"
                  >
                    Email
                  </label>
                  <input
                    id="header-auth-email-mobile"
                    name="email"
                    type="email"
                    required
                    autocomplete="email"
                    class="w-full rounded-lg border border-pyroduck-plasma/40 bg-pyroduck-void px-3 py-2 text-brand-text focus-visible:outline-2 focus-visible:outline-pyroduck-lime"
                  />
                </div>
                <div>
                  <label
                    for="header-auth-password-mobile"
                    class="mb-1 block text-sm font-semibold text-brand-text"
                  >
                    Password
                  </label>
                  <input
                    id="header-auth-password-mobile"
                    name="password"
                    type="password"
                    required
                    minlength="6"
                    autocomplete="current-password"
                    class="w-full rounded-lg border border-pyroduck-plasma/40 bg-pyroduck-void px-3 py-2 text-brand-text focus-visible:outline-2 focus-visible:outline-pyroduck-lime"
                  />
                </div>
                <div class="flex flex-wrap gap-2">
                  <button
                    type="submit"
                    data-account-action="login"
                    class="rounded-lg bg-pyroduck-plasma px-4 py-2 text-sm font-semibold text-pyroduck-void transition-colors hover:bg-pyroduck-lime focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pyroduck-lime disabled:opacity-60"
                  >
                    Log in
                  </button>
                  <button
                    type="submit"
                    data-account-action="signup"
                    class="rounded-lg border border-pyroduck-plasma px-4 py-2 text-sm font-semibold text-brand-text transition-colors hover:bg-pyroduck-plasma/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pyroduck-lime disabled:opacity-60"
                  >
                    Sign up
                  </button>
                </div>
              </form>
            </div>
          </details>
        </div>
      </nav>
    </details>

    <!-- Desktop navigation -->
    <nav
      aria-label="Main navigation"
      class="ml-auto hidden items-center gap-1 sm:flex"
    >
      <ul class="flex items-center gap-1">
        {
          navigation.map(({ label, href }) => (
            <li>
              <a
                href={href}
                class="block rounded-lg px-3 py-2 text-lg font-medium text-brand-text transition-colors hover:text-pyroduck-lime focus-visible:outline-2 focus-visible:outline-pyroduck-lime lg:px-4 lg:text-xl"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="header-auth-signed-in ml-2 hidden items-center gap-2">
        <span
          class="header-auth-email max-w-[10rem] truncate text-sm text-pyroduck-lime font-semibold lg:max-w-[14rem]"
          title=""></span>
        <button
          type="button"
          class="header-auth-sign-out rounded-lg border border-pyroduck-plasma px-3 py-1.5 text-sm font-semibold text-brand-text transition-colors hover:bg-pyroduck-plasma/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pyroduck-lime lg:px-4"
        >
          Log out
        </button>
      </div>

      <details class="header-auth-guest relative ml-2">
        <summary
          class="cursor-pointer list-none rounded-lg border border-pyroduck-plasma px-3 py-1.5 text-sm font-semibold text-brand-text transition-colors hover:bg-pyroduck-plasma/15 hover:text-pyroduck-lime focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pyroduck-lime lg:px-4 [&::-webkit-details-marker]:hidden"
        >
          Log in
        </summary>
        <div
          class="absolute right-0 top-full z-50 mt-2 w-80 rounded-xl border border-pyroduck-plasma/30 bg-black p-4 shadow-xl"
        >
          <p class="mb-1 text-sm font-semibold text-brand-text">
            Chase list account
          </p>
          <p
            class="header-auth-status mb-3 text-sm text-pyroduck-lime font-semibold"
            role="status"
          >
          </p>
          <form class="header-auth-form flex flex-col gap-3">
            <div>
              <label
                for="header-auth-email-desktop"
                class="mb-1 block text-sm font-semibold text-brand-text"
              >
                Email
              </label>
              <input
                id="header-auth-email-desktop"
                name="email"
                type="email"
                required
                autocomplete="email"
                class="w-full rounded-lg border border-pyroduck-plasma/40 bg-pyroduck-void px-3 py-2 text-brand-text focus-visible:outline-2 focus-visible:outline-pyroduck-lime"
              />
            </div>
            <div>
              <label
                for="header-auth-password-desktop"
                class="mb-1 block text-sm font-semibold text-brand-text"
              >
                Password
              </label>
              <input
                id="header-auth-password-desktop"
                name="password"
                type="password"
                required
                minlength="6"
                autocomplete="current-password"
                class="w-full rounded-lg border border-pyroduck-plasma/40 bg-pyroduck-void px-3 py-2 text-brand-text focus-visible:outline-2 focus-visible:outline-pyroduck-lime"
              />
            </div>
            <div class="flex flex-wrap gap-2">
              <button
                type="submit"
                data-account-action="login"
                class="rounded-lg bg-pyroduck-plasma px-4 py-2 text-sm font-semibold text-pyroduck-void transition-colors hover:bg-pyroduck-lime focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pyroduck-lime disabled:opacity-60"
              >
                Log in
              </button>
              <button
                type="submit"
                data-account-action="signup"
                class="rounded-lg border border-pyroduck-plasma px-4 py-2 text-sm font-semibold text-brand-text transition-colors hover:bg-pyroduck-plasma/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pyroduck-lime disabled:opacity-60"
              >
                Sign up
              </button>
            </div>
          </form>
        </div>
      </details>
    </nav>
  </div>

  <CircuitLine />
</header>

<script>
  import { supabase } from "@/lib/supabase";

  const guestBlocks =
    document.querySelectorAll<HTMLElement>(".header-auth-guest");

  const signedInBlocks = document.querySelectorAll<HTMLElement>(
    ".header-auth-signed-in",
  );

  // Keep the existing markup classes, but display profile names here.
  const accountLabels =
    document.querySelectorAll<HTMLElement>(".header-auth-email");

  const statusNodes = document.querySelectorAll<HTMLElement>(
    ".header-auth-status",
  );

  const forms = document.querySelectorAll<HTMLFormElement>(".header-auth-form");

  const signOutButtons = document.querySelectorAll<HTMLButtonElement>(
    ".header-auth-sign-out",
  );

  let busy = false;
  let sessionRequest = 0;
  let displayedUserId: string | null = null;

  function setStatus(message: string) {
    statusNodes.forEach((node) => {
      node.textContent = message;
    });
  }

  function errorMessage(error: unknown) {
    if (
      typeof error === "object" &&
      error !== null &&
      "message" in error &&
      typeof error.message === "string"
    ) {
      return error.message;
    }

    return "Something went wrong. Please try again.";
  }

  function setBusy(value: boolean) {
    busy = value;

    forms.forEach((form) => {
      form.querySelectorAll<HTMLButtonElement>("button").forEach((button) => {
        button.disabled = value;
      });
    });

    signOutButtons.forEach((button) => {
      button.disabled = value;
    });
  }

  function setAccountLabel(name: string, username?: string) {
    accountLabels.forEach((label) => {
      label.textContent = name;
      label.title = username ? `${name} · @${username}` : name;
    });
  }

  function showSession(signedIn: boolean) {
    guestBlocks.forEach((block) => {
      block.classList.toggle("hidden", signedIn);

      if (signedIn && block instanceof HTMLDetailsElement) {
        block.open = false;
      }
    });

    signedInBlocks.forEach((block) => {
      block.classList.toggle("hidden", !signedIn);

      if (block.classList.contains("items-center")) {
        block.classList.toggle("flex", signedIn);
      }
    });

    if (!signedIn) {
      displayedUserId = null;
      setAccountLabel("");
    }
  }

  async function refreshSession() {
    const currentRequest = ++sessionRequest;

    try {
      const { data, error } = await supabase.auth.getSession();

      if (currentRequest !== sessionRequest) return;

      if (error) {
        showSession(false);
        setStatus(error.message);
        return;
      }

      const session = data.session;

      if (!session) {
        showSession(false);
        return;
      }

      const userId = session.user.id;

      if (displayedUserId !== userId) {
        displayedUserId = userId;
        setAccountLabel("My account");
      }

      showSession(true);

      const { data: profile, error: profileError } = await supabase
        .from("profiles")
        .select("username, display_name")
        .eq("id", userId)
        .maybeSingle();

      if (currentRequest !== sessionRequest) return;

      if (profileError || !profile) {
        setAccountLabel("My account");
        return;
      }

      setAccountLabel(profile.display_name, profile.username);
    } catch {
      if (currentRequest === sessionRequest) {
        setStatus("Couldn’t refresh your account. Please try again.");
      }
    }
  }

  forms.forEach((form) => {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (busy) return;

      const submitter = event.submitter;
      const action =
        submitter instanceof HTMLButtonElement &&
        submitter.dataset.accountAction === "signup"
          ? "signup"
          : "login";

      const formData = new FormData(form);
      const email = String(formData.get("email") ?? "").trim();
      const password = String(formData.get("password") ?? "");

      if (!email || !password) {
        setStatus("Email and password are required.");
        return;
      }

      setBusy(true);
      setStatus(action === "signup" ? "Creating account…" : "Logging in…");

      try {
        if (action === "signup") {
          const { data, error } = await supabase.auth.signUp({
            email,
            password,
          });

          if (error) throw error;

          setStatus(
            data.session
              ? "Account created. You’re signed in."
              : "Check your email to confirm your account before logging in.",
          );
        } else {
          const { error } = await supabase.auth.signInWithPassword({
            email,
            password,
          });

          if (error) throw error;
          setStatus("Logged in.");
        }

        form.reset();
        await refreshSession();
        window.dispatchEvent(new Event("chase-cards-changed"));
      } catch (error) {
        setStatus(errorMessage(error));
      } finally {
        setBusy(false);
      }
    });
  });

  signOutButtons.forEach((button) => {
    button.addEventListener("click", async () => {
      if (busy) return;

      setBusy(true);
      setStatus("Logging out…");

      try {
        const { error } = await supabase.auth.signOut();

        if (error) throw error;

        // Invalidate any unfinished profile lookup.
        sessionRequest++;
        showSession(false);
        setStatus("Logged out.");

        window.dispatchEvent(new Event("chase-cards-changed"));
      } catch (error) {
        setStatus(errorMessage(error));
      } finally {
        setBusy(false);
      }
    });
  });

  document
    .querySelectorAll<HTMLDetailsElement>("header details")
    .forEach((menu) => {
      menu.querySelectorAll<HTMLAnchorElement>("nav a").forEach((link) => {
        link.addEventListener("click", () => {
          menu.open = false;
        });
      });

      menu.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && menu.open) {
          event.stopPropagation();
          menu.open = false;
          menu.querySelector("summary")?.focus();
        }
      });
    });

  document.addEventListener("click", (event) => {
    const target = event.target;

    if (!(target instanceof Node)) return;

    document
      .querySelectorAll<HTMLDetailsElement>("nav details.header-auth-guest")
      .forEach((panel) => {
        if (panel.open && !panel.contains(target)) {
          panel.open = false;
        }
      });
  });

  supabase.auth.onAuthStateChange((_event, session) => {
    // Update visibility immediately without making database calls here.
    if (!session) {
      sessionRequest++;
      showSession(false);
    } else {
      if (displayedUserId !== session.user.id) {
        sessionRequest++;
        displayedUserId = session.user.id;
        setAccountLabel("My account");
      }

      showSession(true);
    }

    // Read the profile after the authentication callback finishes.
    window.setTimeout(() => {
      void refreshSession();
    }, 0);
  });

  window.addEventListener("player-profile-changed", () => {
    void refreshSession();
  });

  void refreshSession();
</script>
