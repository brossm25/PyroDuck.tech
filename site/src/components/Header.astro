---
import { site } from "@/data/site";
import CircuitLine from "@/components/CircuitLine.astro";
import AccountMenu from "@/components/AccountMenu.astro";
import UserProfile from "@/components/mtg/UserProfile.astro";
import PlayerSearch from "@/components/mtg/PlayerSearch.astro";
import FriendsMenu from "@/components/mtg/FriendsMenu.astro";

const pathname = Astro.url.pathname;
const isMtgPage = pathname === "/mtg" || pathname.startsWith("/mtg/");

const navigation = [
  { label: "Work", href: "/#work" },
  { label: "About", href: "/#about" },
  { label: "Contact", href: "/#contact" },
  { label: "Playbook", href: "/playbook" },
  ...(!isMtgPage ? [{ label: "BinderLink", href: "/mtg" }] : []),
];
---

<header class="sticky top-0 z-50 bg-pyroduck-void">
  <div
    class="relative grid w-full grid-cols-[1fr_auto_1fr] items-center gap-3 px-4 py-2 sm:px-6 xl:flex xl:gap-4 xl:px-8"
  >
    <!-- Logo -->
    <a
      href="/"
      class="col-start-1 row-start-1 justify-self-start rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-pyroduck-lime sm:shrink-0"
      aria-label={`${site.name} homepage`}
    >
      <img
        src="/images/pyroduck-logo-primary-web-safe.svg"
        alt={`${site.name} logo`}
        width="96"
        height="96"
        class="h-16 w-16 object-contain sm:h-20 sm:w-20 lg:h-24 lg:w-24"
      />
    </a>

    <!-- Site name -->
    <a
      href="/"
      class="col-start-2 row-start-1 rounded-lg text-center focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-pyroduck-lime"
    >
      <span
        class="bg-linear-to-r from-brand-text via-pyroduck-plasma to-pyroduck-lime bg-clip-text text-xl font-bold tracking-wide text-transparent sm:text-2xl"
      >
        {site.name}
      </span>
    </a>

    <!-- Mobile navigation -->
    <details
      class="group relative col-start-3 row-start-1 justify-self-end xl:hidden"
      data-header-menu
    >
      <summary
        class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-lg text-brand-text transition-colors hover:text-pyroduck-lime focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-pyroduck-lime [&::-webkit-details-marker]:hidden"
        aria-label="Main navigation menu"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          class="h-7 w-7"
          aria-hidden="true"
        >
          <path d="M4 6h16M4 12h16M4 18h16" class="group-open:hidden"></path>
          <path d="m6 6 12 12M18 6 6 18" class="hidden group-open:block"></path>
        </svg>
        <span
          class="message-unread-badge mobile-menu-unread-badge"
          aria-hidden="true"
          hidden></span>
      </summary>

      <nav
        aria-label="Mobile navigation"
        class="mobile-navigation absolute right-0 top-full mt-3 rounded-xl border border-pyroduck-plasma/30 bg-black p-2 shadow-xl"
      >
        {
          navigation.map(({ label, href }) => (
            <a href={href} class="header-link">
              {label}
            </a>
          ))
        }

        {
          isMtgPage && (
            <>
              <button
                type="button"
                class="header-link player-search-trigger"
                aria-haspopup="dialog"
                aria-controls="header-player-search"
              >
                Find a player
              </button>

              <FriendsMenu />

              <a
                href="/mtg/messages"
                class="header-link"
                aria-current={pathname === "/mtg/messages" ? "page" : undefined}
              >
                Messages
                <span class="message-unread-badge" hidden />
              </a>

              <div class="mt-2 border-t border-pyroduck-plasma/20 pt-2">
                <AccountMenu />
              </div>
            </>
          )
        }
      </nav>
    </details>

    <!-- Desktop navigation -->
    <nav
      aria-label="Main navigation"
      class="desktop-navigation ml-auto hidden items-center gap-1 xl:flex"
    >
      <ul class="flex items-center gap-1">
        {
          navigation.map(({ label, href }) => (
            <li>
              <a href={href} class="header-link">
                {label}
              </a>
            </li>
          ))
        }
      </ul>

      {
        isMtgPage && (
          <>
            <button
              type="button"
              class="header-link player-search-trigger"
              aria-haspopup="dialog"
              aria-controls="header-player-search"
            >
              Find a player
            </button>

            <FriendsMenu />

            <a
              href="/mtg/messages"
              class="header-link"
              aria-current={pathname === "/mtg/messages" ? "page" : undefined}
            >
              Messages
              <span class="message-unread-badge" hidden />
            </a>
            <AccountMenu />
          </>
        )
      }
    </nav>
  </div>

  <CircuitLine />
</header>

{
  isMtgPage && (
    <>
      <UserProfile />

      <dialog
        id="header-player-search"
        class="header-search-dialog"
        aria-labelledby="header-player-search-title"
      >
        <div class="search-dialog-controls">
          <h2 id="header-player-search-title" class="sr-only">
            Search for a player
          </h2>

          <button
            type="button"
            class="search-dialog-close"
            aria-label="Close player search"
            autofocus
          >
            ✕
          </button>
        </div>

        <PlayerSearch />
      </dialog>
    </>
  )
}

<script>
  import { supabase } from "@/lib/supabase";

  const headerMenus =
    document.querySelectorAll<HTMLDetailsElement>("header details");

  const searchDialog = document.querySelector<HTMLDialogElement>(
    "#header-player-search",
  );

  let searchReturnFocus: HTMLElement | null = null;

  const messageBadges = document.querySelectorAll<HTMLElement>(
    ".message-unread-badge",
  );

  let unreadRequest = 0;

  async function refreshUnreadBadge() {
    if (!messageBadges.length) return;

    const current = ++unreadRequest;

    const { data: auth, error: authError } = await supabase.auth.getSession();
    if (current !== unreadRequest) return;

    if (authError || !auth.session) {
      messageBadges.forEach((badge) => {
        badge.hidden = true;
        badge.textContent = "";
      });
      return;
    }

    const { data, error } = await supabase.rpc("get_my_unread_conversations");
    if (current !== unreadRequest || error) return;

    const count = (data ?? []).reduce(
      (total: number, item: { unread_count: number | string }) =>
        total + Number(item.unread_count),
      0,
    );

    messageBadges.forEach((badge) => {
      badge.hidden = count === 0;
      badge.textContent = count > 99 ? "99+" : String(count);
      badge.setAttribute(
        "aria-label",
        `${count} unread ${count === 1 ? "message" : "messages"}`,
      );
    });
  }

  if (messageBadges.length) {
    void refreshUnreadBadge();

    supabase.auth.onAuthStateChange(() => {
      unreadRequest++;
      messageBadges.forEach((badge) => {
        badge.hidden = true;
        badge.textContent = "";
      });
      window.setTimeout(() => void refreshUnreadBadge(), 0);
    });

    window.addEventListener("messages-read", () => void refreshUnreadBadge());

    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) void refreshUnreadBadge();
    });

    window.setInterval(() => {
      if (!document.hidden) void refreshUnreadBadge();
    }, 30_000);
  }

  function closeHeaderMenus() {
    headerMenus.forEach((menu) => {
      menu.open = false;
    });
  }

  headerMenus.forEach((menu) => {
    menu.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        event.stopPropagation();
        menu.open = false;
        menu.querySelector<HTMLElement>("summary")?.focus();
      }
    });
  });

  document
    .querySelectorAll<HTMLAnchorElement>("header nav a")
    .forEach((link) => {
      link.addEventListener("click", closeHeaderMenus);
    });

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Node)) return;

    const target = event.target;

    headerMenus.forEach((menu) => {
      if (menu.open && !menu.contains(target)) {
        menu.open = false;
      }
    });
  });

  document
    .querySelectorAll<HTMLButtonElement>(".player-search-trigger")
    .forEach((button) => {
      button.addEventListener("click", () => {
        if (!searchDialog || searchDialog.open) return;

        const mobileMenu =
          button.closest<HTMLDetailsElement>("[data-header-menu]");

        searchReturnFocus = mobileMenu
          ? mobileMenu.querySelector<HTMLElement>("summary")
          : button;

        closeHeaderMenus();
        searchDialog.showModal();
        searchDialog.querySelector<HTMLInputElement>("input")?.focus();
      });
    });

  document
    .querySelector<HTMLButtonElement>(".search-dialog-close")
    ?.addEventListener("click", () => {
      searchDialog?.close();
    });

  searchDialog?.addEventListener("close", () => {
    if (
      searchReturnFocus?.isConnected &&
      searchReturnFocus.getClientRects().length
    ) {
      searchReturnFocus.focus();
    }

    searchReturnFocus = null;
  });
</script>

<style>
  .message-unread-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.4rem;
    height: 1.4rem;
    margin-left: 0.35rem;
    padding: 0 0.3rem;
    border-radius: 999px;
    background: var(--color-pyroduck-lime);
    color: var(--color-pyroduck-void);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .message-unread-badge[hidden] {
    display: none;
  }

  .mobile-menu-unread-badge {
    position: absolute;
    top: 0;
    right: 0;
    margin: 0;
  }

  .mobile-navigation {
    width: min(20rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 7rem);
    overflow-y: auto;
  }

  .header-link {
    display: block;
    width: 100%;
    min-height: 44px;
    padding: 0.75rem 1rem;
    border: 0;
    border-radius: 0.5rem;
    background: transparent;
    color: var(--color-brand-text);
    font: inherit;
    font-size: 1.125rem;
    font-weight: 500;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }

  .header-link:hover {
    background: var(--color-pyroduck-afterdark);
    color: var(--color-pyroduck-lime);
  }

  .header-link:focus-visible,
  .search-dialog-close:focus-visible {
    outline: 2px solid var(--color-pyroduck-lime);
    outline-offset: 3px;
  }

  .header-search-dialog {
    box-sizing: border-box;
    width: min(44rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: 1rem;
    overflow-y: auto;
    border: 1px solid var(--color-pyroduck-plasma);
    border-radius: 1rem;
    background: var(--color-pyroduck-afterdark);
    color: var(--color-brand-text);
  }

  .header-search-dialog::backdrop {
    background: rgb(0 0 0 / 80%);
  }

  .search-dialog-controls {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 0.75rem;
  }

  .search-dialog-close {
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-pyroduck-plasma);
    border-radius: 0.5rem;
    background: transparent;
    color: var(--color-brand-text);
    font: inherit;
    cursor: pointer;
  }

  .search-dialog-close:hover {
    color: var(--color-pyroduck-lime);
  }

  @media (max-width: 1279px) {
    .mobile-navigation {
      max-height: calc(100dvh - 10rem);
      overscroll-behavior: contain;
      scrollbar-gutter: stable;
    }

    .mobile-navigation :global(.friends-panel),
    .mobile-navigation :global(.account-panel) {
      position: static;
      width: 100%;
      max-width: 100%;
      max-height: none;
      margin-top: 0.5rem;
      overflow: visible;
      box-shadow: none;
    }

    .mobile-navigation :global(.friends-trigger) {
      padding: 0.75rem 1rem;
      font-size: 1.125rem;
    }
  }

  @media (min-width: 1280px) {
    .desktop-navigation {
      flex-wrap: nowrap;
      justify-content: flex-end;
    }

    .desktop-navigation .header-link {
      width: auto;
      padding: 0.5rem 0.65rem;
      white-space: nowrap;
      font-size: 1rem;
    }
  }
</style>
