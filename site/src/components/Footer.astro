---
import { site } from "@/data/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-pyroduck-plasma/25 px-6 py-8">
  <div
    class="mx-auto grid max-w-5xl grid-cols-1 items-center justify-items-center gap-4 text-sm sm:grid-cols-3"
  >
    <p class="text-brand-muted sm:justify-self-start">
      &copy; {year}{" "}{site.name}
    </p>

    <a
      href="https://www.youtube.com/@pyroducktech"
      aria-label="PyroDuck Tech on YouTube"
      class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-pyroduck-plasma transition-colors hover:text-pyroduck-lime focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-pyroduck-lime"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        class="h-7 w-7"
        aria-hidden="true"
      >
        <path
          d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z"
        ></path>
      </svg>
    </a>

    <a
      href="#top"
      class="rounded-sm font-semibold text-pyroduck-plasma transition-colors hover:text-pyroduck-lime focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-pyroduck-lime sm:justify-self-end"
    >
      Back to top <span aria-hidden="true">↑</span>
    </a>
  </div>
</footer>
