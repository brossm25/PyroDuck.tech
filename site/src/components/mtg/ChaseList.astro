<section
  aria-labelledby="chase-list-heading"
  class="rounded-2xl border border-pyroduck-plasma/30 bg-pyroduck-afterdark p-6 sm:p-8"
>
  <div class="flex flex-wrap items-center justify-between gap-4">
    <h2
      id="chase-list-heading"
      tabindex="-1"
      class="text-2xl font-bold text-brand-text sm:text-3xl"
    >
      Your chase list.
    </h2>

    <button
      type="button"
      class="chase-refresh"
      disabled
    >
      Refresh prices
    </button>
  </div>

  <p class="mt-3 max-w-2xl text-brand-muted">
    Your saved printings and finishes. Price estimates refresh when you open
    this list if their last check was more than 24 hours ago.
  </p>

  <p class="chase-list-status mt-4 text-brand-muted" role="status"></p>

  <p
    class="chase-list-total mt-3 text-xl font-bold text-pyroduck-lime"
  ></p>

  <p class="chase-list-total-note mt-2 text-sm text-brand-muted"></p>

  <p class="chase-price-status mt-3 text-sm text-brand-muted" role="status"></p>

  <ul
    class="chase-list-items mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
  ></ul>
</section>

<script>
  import { supabase } from "@/lib/supabase";

  interface ChaseCard {
    id: string;
    scryfall_id: string;
    name: string;
    set_name: string;
    collector_number: string;
    finish: string;
    image_url: string | null;
    scryfall_uri: string | null;
    price_usd: number | string | null;
    price_checked_at: string | null;
    current_price_usd: number | string | null;
    current_price_checked_at: string | null;
  }

  interface ScryfallCard {
    id: string;
    prices?: {
      usd?: string | null;
      usd_foil?: string | null;
      usd_etched?: string | null;
    };
  }

  const list = document.querySelector<HTMLUListElement>(".chase-list-items");
  const status = document.querySelector<HTMLElement>(".chase-list-status");
  const priceStatus =
    document.querySelector<HTMLElement>(".chase-price-status");
  const totalElement =
    document.querySelector<HTMLElement>(".chase-list-total");
  const totalNote =
    document.querySelector<HTMLElement>(".chase-list-total-note");
  const refreshButton =
    document.querySelector<HTMLButtonElement>(".chase-refresh");

  const usdFormatter = new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
  });

  const dateFormatter = new Intl.DateTimeFormat(undefined, {
    year: "numeric",
    month: "short",
    day: "numeric",
    hour: "numeric",
    minute: "2-digit",
  });

  const refreshAge = 24 * 60 * 60 * 1000;

  let cards: ChaseCard[] = [];
  let loading = false;
  let refreshing = false;
  let removing = false;
  let signedIn = false;
  let requestId = 0;
  let refreshController: AbortController | undefined;

  function finishLabel(finish: string) {
    if (finish === "nonfoil") return "Nonfoil";
    if (finish === "foil") return "Foil";
    if (finish === "etched") return "Etched foil";
    return finish;
  }

  function parsePrice(value: number | string | null | undefined) {
    if (value == null || String(value).trim() === "") return null;

    const price = Number(value);
    return Number.isFinite(price) && price >= 0 ? price : null;
  }

  function priceForFinish(card: ScryfallCard, finish: string) {
    if (finish === "nonfoil") return parsePrice(card.prices?.usd);
    if (finish === "foil") return parsePrice(card.prices?.usd_foil);
    if (finish === "etched") return parsePrice(card.prices?.usd_etched);
    return null;
  }

  function needsRefresh(card: ChaseCard) {
    if (!card.current_price_checked_at) return true;

    const checked = Date.parse(card.current_price_checked_at);

    return (
      !Number.isFinite(checked) ||
      checked > Date.now() ||
      Date.now() - checked >= refreshAge
    );
  }

  function displayedPrice(card: ChaseCard) {
    // A completed current check can legitimately have no available price.
    if (card.current_price_checked_at) {
      return parsePrice(card.current_price_usd);
    }

    return parsePrice(card.price_usd);
  }

  function setStatus(message: string) {
    if (status) status.textContent = message;
  }

  function setPriceStatus(message: string) {
    if (priceStatus) priceStatus.textContent = message;
  }

  function syncButtons() {
    const busy = loading || refreshing || removing;

    if (refreshButton) {
      refreshButton.disabled = busy || !signedIn || cards.length === 0;
      refreshButton.textContent = refreshing
        ? "Refreshing…"
        : "Refresh prices";
    }

    list
      ?.querySelectorAll<HTMLButtonElement>(".chase-list-remove")
      .forEach((button) => {
        button.disabled = busy;
      });
  }

  function clearTotal() {
    if (totalElement) totalElement.textContent = "";
    if (totalNote) totalNote.textContent = "";
  }

  function renderTotal() {
    clearTotal();
    if (cards.length === 0) return;

    let totalCents = 0;
    let missing = 0;
    let savedFallbacks = 0;
    let stale = 0;

    for (const card of cards) {
      const price = displayedPrice(card);

      if (price === null) {
        missing++;
        continue;
      }

      totalCents += Math.round(price * 100);

      if (!card.current_price_checked_at) {
        savedFallbacks++;
      } else if (needsRefresh(card)) {
        stale++;
      }
    }

    if (totalElement) {
      totalElement.textContent =
        missing === cards.length
          ? "Total chase-list estimate: unavailable"
          : `Total chase-list estimate: ${
              usdFormatter.format(totalCents / 100)
            } USD`;
    }

    const notes = ["One copy per saved entry."];

    if (savedFallbacks > 0) {
      notes.push(
        `${savedFallbacks} ${
          savedFallbacks === 1 ? "entry uses its" : "entries use their"
        } original saved price until refreshed.`,
      );
    }

    if (stale > 0) {
      notes.push(
        `${stale} ${stale === 1 ? "estimate is" : "estimates are"} over 24 hours old.`,
      );
    }

    if (missing > 0) {
      notes.push(
        `${missing} ${
          missing === 1 ? "entry has" : "entries have"
        } no available price and ${
          missing === 1 ? "is" : "are"
        } excluded.`,
      );
    }

    notes.push("Estimates exclude shipping and tax.");

    if (totalNote) totalNote.textContent = notes.join(" ");
  }

  function addText(
    parent: HTMLElement,
    className: string,
    text: string,
  ) {
    const paragraph = document.createElement("p");
    paragraph.className = className;
    paragraph.textContent = text;
    parent.append(paragraph);
  }

  function renderCards() {
    if (!list) return;

    list.replaceChildren();
    renderTotal();

    setStatus(
      cards.length === 0
        ? "No cards saved yet. Use Find a card and “Use this version”."
        : `${cards.length} saved ${cards.length === 1 ? "card" : "cards"}.`,
    );

    for (const card of cards) {
      const item = document.createElement("li");
      item.className = "chase-list-card";

      if (card.image_url) {
        const image = document.createElement("img");
        image.src = card.image_url;
        image.alt = card.name;
        image.loading = "lazy";
        image.width = 488;
        image.height = 680;
        item.append(image);
      }

      const title = document.createElement("p");
      title.className = "chase-list-title";

      if (card.scryfall_uri) {
        const link = document.createElement("a");
        link.href = card.scryfall_uri;
        link.target = "_blank";
        link.rel = "noopener noreferrer";
        link.textContent = `${card.name} ↗`;
        title.append(link);
      } else {
        title.textContent = card.name;
      }

      item.append(title);

      addText(
        item,
        "chase-list-meta",
        `${card.set_name} #${card.collector_number} · ${finishLabel(card.finish)}`,
      );

      const current = parsePrice(card.current_price_usd);
      const original = parsePrice(card.price_usd);

      if (card.current_price_checked_at) {
        addText(
          item,
          "chase-list-price",
          current === null
            ? "Current estimate: unavailable"
            : `Current estimate: ${usdFormatter.format(current)} USD`,
        );
      } else {
        addText(
          item,
          "chase-list-price",
          original === null
            ? "Current estimate: not checked yet"
            : `Last saved estimate: ${usdFormatter.format(original)} USD`,
        );
      }

      addText(
        item,
        "chase-list-meta",
        original === null
          ? "No original price recorded."
          : `Price when saved: ${usdFormatter.format(original)} USD`,
      );

      if (
        card.current_price_checked_at &&
        current !== null &&
        original !== null
      ) {
        const differenceCents =
          Math.round(current * 100) - Math.round(original * 100);

        const change =
          differenceCents === 0
            ? "Unchanged since saved."
            : `${differenceCents > 0 ? "Up" : "Down"} ${
                usdFormatter.format(Math.abs(differenceCents) / 100)
              } since saved.`;

        addText(item, "chase-list-change", change);
      }

      const checkedAt =
        card.current_price_checked_at ?? card.price_checked_at;

      if (checkedAt) {
        const date = new Date(checkedAt);

        if (!Number.isNaN(date.getTime())) {
          const note = document.createElement("p");
          note.className = "chase-list-note";

          const time = document.createElement("time");
          time.dateTime = checkedAt;
          time.textContent = dateFormatter.format(date);

          note.append(
            card.current_price_checked_at
              ? "Scryfall checked "
              : "Original estimate checked ",
            time,
            ".",
          );

          if (card.current_price_checked_at && needsRefresh(card)) {
            note.append(" Refresh due.");
          }

          item.append(note);
        }
      }

      const actions = document.createElement("div");
      actions.className = "chase-list-actions";

      const button = document.createElement("button");
      button.type = "button";
      button.className = "chase-list-remove";
      button.textContent = "×";
      button.title = `Remove ${card.name}`;
      button.setAttribute(
        "aria-label",
        `Remove ${card.name}, ${card.set_name} #${card.collector_number}, ${finishLabel(card.finish)} from your chase list`,
      );

      button.addEventListener("click", () => {
        void removeCard(card, button);
      });

      actions.append(button);
      item.append(actions);
      list.append(item);
    }

    syncButtons();
  }

  async function refreshPrices(force = false) {
    if (!signedIn || loading || refreshing || removing) return;

    const pending = cards.filter((card) => force || needsRefresh(card));
    if (pending.length === 0) return;

    const activeRequest = requestId;
    const controller = new AbortController();
    refreshController = controller;
    refreshing = true;
    syncButtons();

    let updated = 0;
    let failed = 0;
    let lastError = "";

    try {
      for (const [index, card] of pending.entries()) {
        if (controller.signal.aborted || activeRequest !== requestId) return;

        setPriceStatus(
          `Checking prices ${index + 1} of ${pending.length}…`,
        );

        // Space requests instead of fetching every card at once.
        await new Promise((resolve) => window.setTimeout(resolve, 150));

        if (controller.signal.aborted || activeRequest !== requestId) return;

        let stop = false;
        const timeout = window.setTimeout(() => controller.abort(), 15000);

        try {
          if (!card.scryfall_id) {
            throw new Error("A saved card is missing its Scryfall printing ID.");
          }

          const response = await fetch(
            `https://api.scryfall.com/cards/${encodeURIComponent(card.scryfall_id)}`,
            {
              headers: { Accept: "application/json" },
              signal: controller.signal,
            },
          );

          if (response.status === 429) {
            stop = true;
            throw new Error("Scryfall is busy. Please try refreshing later.");
          }

          if (!response.ok) {
            throw new Error("A printing’s price could not be retrieved.");
          }

          const printing: ScryfallCard = await response.json();

          if (printing.id !== card.scryfall_id) {
            throw new Error("The returned printing did not match.");
          }

          if (controller.signal.aborted || activeRequest !== requestId) return;

          const price = priceForFinish(printing, card.finish);

          // Keep an existing estimate if Scryfall temporarily has no price.
          if (price === null && displayedPrice(card) !== null) {
            throw new Error(
              "Some prices are unavailable. Their previous estimates were kept.",
            );
          }

          const checkedAt = new Date().toISOString();

          const { data, error } = await supabase
            .from("chase_cards")
            .update({
              current_price_usd: price,
              current_price_checked_at: checkedAt,
            })
            .eq("id", card.id)
            .select("id");

          if (controller.signal.aborted || activeRequest !== requestId) return;

          if (error) {
            stop = true;
            throw new Error(`Couldn’t save refreshed prices: ${error.message}`);
          }

          if (!data?.length) {
            stop = true;
            throw new Error(
              "Price updates were not saved. Check your chase_cards UPDATE permission.",
            );
          }

          card.current_price_usd = price;
          card.current_price_checked_at = checkedAt;
          updated++;
        } catch (error) {
          if (activeRequest !== requestId) return;

          failed++;
          lastError = controller.signal.aborted
            ? "The refresh timed out. Previous estimates were kept."
            : error instanceof Error
              ? error.message
              : "Some prices could not be refreshed.";

          if (controller.signal.aborted) stop = true;
        } finally {
          window.clearTimeout(timeout);
        }

        if (stop) break;
      }

      if (activeRequest !== requestId) return;

      renderCards();

      setPriceStatus(
        failed > 0
          ? `${updated} updated. ${lastError}`
          : `Prices checked for ${updated} ${
              updated === 1 ? "entry" : "entries"
            }.`,
      );
    } finally {
      if (refreshController === controller) {
        refreshing = false;
        refreshController = undefined;
        syncButtons();
      }
    }
  }

  async function removeCard(card: ChaseCard, button: HTMLButtonElement) {
    if (loading || refreshing || removing) return;

    if (
      !window.confirm(
        `Remove ${card.name} — ${card.set_name} #${card.collector_number} (${finishLabel(card.finish)}) from your chase list?`,
      )
    ) {
      return;
    }

    removing = true;
    syncButtons();
    button.textContent = "…";
    setStatus(`Removing ${card.name}…`);

    let removed = false;

    try {
      const {
        data: { session },
        error: sessionError,
      } = await supabase.auth.getSession();

      if (sessionError || !session) {
        setStatus("Please sign in again before removing a card.");
        return;
      }

      const { data, error } = await supabase
        .from("chase_cards")
        .delete()
        .eq("id", card.id)
        .select("id");

      if (error) {
        setStatus(`Couldn’t remove the card: ${error.message}`);
        return;
      }

      if (!data?.length) {
        setStatus("The card wasn’t removed. Refresh your list and try again.");
        return;
      }

      removed = true;
      await loadChaseList(false);
    } catch {
      setStatus("Couldn’t remove the card. Please try again shortly.");
    } finally {
      removing = false;
      button.textContent = "×";
      syncButtons();

      if (removed) {
        const next =
          list?.querySelector<HTMLButtonElement>(".chase-list-remove");

        if (next) {
          next.focus();
        } else {
          document.querySelector<HTMLElement>("#chase-list-heading")?.focus();
        }
      }
    }
  }

  async function loadChaseList(autoRefresh = true) {
    if (!list) return;

    const activeRequest = ++requestId;

    refreshController?.abort();
    loading = true;
    clearTotal();
    setPriceStatus("");
    syncButtons();

    let loaded = false;

    try {
      const {
        data: { session },
        error: sessionError,
      } = await supabase.auth.getSession();

      if (activeRequest !== requestId) return;

      signedIn = Boolean(session) && !sessionError;

      if (!signedIn) {
        cards = [];
        list.replaceChildren();
        setStatus(
          sessionError
            ? "Couldn’t check your sign-in. Please try again."
            : "Sign in above to see your saved chase cards.",
        );
        return;
      }

      setStatus("Loading your chase list…");

      const { data, error } = await supabase
        .from("chase_cards")
        .select(
          "id, scryfall_id, name, set_name, collector_number, finish, image_url, scryfall_uri, price_usd, price_checked_at, current_price_usd, current_price_checked_at",
        )
        .order("created_at", { ascending: false });

      if (activeRequest !== requestId) return;

      if (error) {
        cards = [];
        list.replaceChildren();
        setStatus(`Couldn’t load your chase list: ${error.message}`);
        return;
      }

      cards = (data ?? []) as ChaseCard[];
      renderCards();
      loaded = true;
    } catch {
      if (activeRequest !== requestId) return;

      cards = [];
      list.replaceChildren();
      setStatus("Couldn’t load your chase list. Please try again shortly.");
    } finally {
      if (activeRequest === requestId) {
        loading = false;
        syncButtons();
      }
    }

    if (loaded && autoRefresh && activeRequest === requestId) {
      // Allow an aborted earlier refresh to finish cleaning up.
      window.setTimeout(() => {
        if (activeRequest === requestId) void refreshPrices();
      }, 0);
    }
  }

  refreshButton?.addEventListener("click", () => {
    void refreshPrices(true);
  });

  supabase.auth.onAuthStateChange(() => {
    window.setTimeout(() => {
      void loadChaseList();
    }, 0);
  });

  window.addEventListener("chase-cards-changed", () => {
    void loadChaseList();
  });

  void loadChaseList();
</script>

<style>
  .chase-refresh {
    min-height: 44px;
    padding: 0.6rem 1rem;
    border: 1px solid var(--color-pyroduck-plasma);
    border-radius: 0.5rem;
    background: transparent;
    color: var(--color-pyroduck-plasma);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .chase-refresh:hover:not(:disabled) {
    background: var(--color-pyroduck-plasma);
    color: var(--color-pyroduck-void);
  }

  .chase-refresh:focus-visible {
    outline: 2px solid var(--color-pyroduck-lime);
    outline-offset: 4px;
  }

  .chase-refresh:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .chase-list-items :global(.chase-list-card) {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
    border-radius: 1rem;
    border: 1px solid
      color-mix(in srgb, var(--color-pyroduck-plasma) 30%, transparent);
    background: var(--color-pyroduck-void);
    padding: 0.75rem;
  }

  .chase-list-items :global(.chase-list-card img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.75rem;
  }

  .chase-list-items :global(.chase-list-title) {
    margin: 0;
    font-weight: 600;
    color: var(--color-brand-text);
  }

  .chase-list-items :global(.chase-list-title a) {
    color: var(--color-pyroduck-plasma);
    text-decoration: underline;
    text-underline-offset: 3px;
    border-radius: 0.25rem;
  }

  .chase-list-items :global(.chase-list-title a:hover) {
    color: var(--color-pyroduck-lime);
  }

  .chase-list-items :global(.chase-list-title a:focus-visible) {
    outline: 2px solid var(--color-pyroduck-lime);
    outline-offset: 4px;
  }

  .chase-list-items :global(.chase-list-meta),
  .chase-list-items :global(.chase-list-change) {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-brand-muted);
  }

  .chase-list-items :global(.chase-list-price) {
    margin: 0;
    font-weight: 600;
    color: var(--color-pyroduck-lime);
  }

  .chase-list-items :global(.chase-list-note) {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--color-brand-muted);
  }

  .chase-list-items :global(.chase-list-actions) {
    position: absolute;
    top: -10px;
    right: -10px;
    z-index: 1;
  }

  .chase-list-items :global(.chase-list-remove) {
    box-sizing: border-box;
    position: relative;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 2px solid var(--color-pyroduck-void);
    border-radius: 50%;
    background: #b91c1c;
    color: #fff;
    font: inherit;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1;
    box-shadow: 0 2px 8px rgb(0 0 0 / 50%);
    cursor: pointer;
  }

  .chase-list-items :global(.chase-list-remove::before) {
    content: "";
    position: absolute;
    inset: -8px;
    border-radius: 50%;
  }

  .chase-list-items :global(.chase-list-remove:hover:not(:disabled)) {
    background: #991b1b;
  }

  .chase-list-items :global(.chase-list-remove:focus-visible) {
    outline: 2px solid var(--color-pyroduck-lime);
    outline-offset: 3px;
  }

  .chase-list-items :global(.chase-list-remove:disabled) {
    opacity: 0.6;
    cursor: wait;
  }
</style>