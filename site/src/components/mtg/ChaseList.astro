<section
  aria-labelledby="chase-list-heading"
  class="rounded-2xl border border-pyroduck-plasma/30 bg-pyroduck-afterdark p-6 sm:p-8"
>
  <h2
    id="chase-list-heading"
    class="text-2xl font-bold text-brand-text sm:text-3xl"
  >
    Your chase list.
  </h2>

  <p class="mt-3 max-w-2xl text-brand-muted">
    Printings you’ve saved while signed in. Add more with Find a card below.
  </p>

  <p class="chase-list-status mt-4 text-brand-muted" role="status"></p>

  <ul
    class="chase-list-items mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
  ></ul>
</section>

<script>
  import { supabase } from "@/lib/supabase";

  interface ChaseCard {
    id: string;
    name: string;
    set_name: string;
    collector_number: string;
    finish: string;
    image_url: string | null;
    scryfall_uri: string | null;
    price_usd: number | string | null;
    price_checked_at: string | null;
  }

  const status = document.querySelector<HTMLElement>(".chase-list-status");
  const list = document.querySelector<HTMLUListElement>(".chase-list-items");

  const usdFormatter = new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
  });

  const dateFormatter = new Intl.DateTimeFormat(undefined, {
    year: "numeric",
    month: "short",
    day: "numeric",
  });

  let loadId = 0;
  let removing = false;

  function finishLabel(finish: string) {
    if (finish === "nonfoil") return "Nonfoil";
    if (finish === "etched") return "Etched foil";
    if (finish === "foil") return "Foil";
    return finish;
  }

  function setStatus(message: string) {
    if (status) status.textContent = message;
  }

  function setRemoveButtonsDisabled(disabled: boolean) {
    list
      ?.querySelectorAll<HTMLButtonElement>(".chase-list-remove")
      .forEach((button) => {
        button.disabled = disabled;
      });
  }

  async function removeCard(card: ChaseCard, button: HTMLButtonElement) {
    if (removing) return;

    const confirmed = window.confirm(
      `Remove ${card.name} — ${card.set_name} #${card.collector_number} (${finishLabel(card.finish)}) from your chase list?`,
    );

    if (!confirmed) return;

    removing = true;
    setRemoveButtonsDisabled(true);
    button.textContent = "Removing…";
    setStatus(`Removing ${card.name}…`);

    try {
      const {
        data: { session },
        error: sessionError,
      } = await supabase.auth.getSession();

      if (sessionError || !session) {
        setStatus("Please sign in again before removing a card.");
        return;
      }

      const { data, error } = await supabase
        .from("chase_cards")
        .delete()
        .eq("id", card.id)
        .select("id");

      if (error) {
        setStatus(`Couldn’t remove the card: ${error.message}`);
        return;
      }

      if (!data?.length) {
        setStatus(
          "The card wasn’t removed. It may already be gone, or your account may not have permission to delete it.",
        );
        return;
      }

      await loadChaseList();
      setStatus(`${card.name} removed from your chase list.`);

      list
        ?.querySelector<HTMLButtonElement>(".chase-list-remove")
        ?.focus();
    } catch {
      setStatus("Couldn’t remove the card. Please try again shortly.");
    } finally {
      removing = false;
      button.textContent = "Remove";
      setRemoveButtonsDisabled(false);
    }
  }

  function renderCards(cards: ChaseCard[]) {
    if (!list) return;

    list.replaceChildren();

    if (cards.length === 0) {
      setStatus("No cards saved yet. Use Find a card and “Use this version”.");
      return;
    }

    setStatus(
      `${cards.length} saved ${cards.length === 1 ? "card" : "cards"}.`,
    );

    for (const card of cards) {
      const item = document.createElement("li");
      item.className = "chase-list-card";

      if (card.image_url) {
        const image = document.createElement("img");
        image.src = card.image_url;
        image.alt = card.name;
        image.loading = "lazy";
        image.width = 488;
        image.height = 680;
        item.append(image);
      }

      const title = document.createElement("p");
      title.className = "chase-list-title";

      if (card.scryfall_uri) {
        const link = document.createElement("a");
        link.href = card.scryfall_uri;
        link.target = "_blank";
        link.rel = "noopener noreferrer";
        link.textContent = `${card.name} ↗`;
        title.append(link);
      } else {
        title.textContent = card.name;
      }

      item.append(title);

      const meta = document.createElement("p");
      meta.className = "chase-list-meta";
      meta.textContent =
        `${card.set_name} #${card.collector_number} · ` +
        finishLabel(card.finish);
      item.append(meta);

      const price = document.createElement("p");
      price.className = "chase-list-price";

      const rawPrice = card.price_usd;
      const parsedPrice =
        rawPrice !== null && String(rawPrice).trim() !== ""
          ? Number(rawPrice)
          : NaN;

      if (Number.isFinite(parsedPrice) && parsedPrice >= 0) {
        price.textContent =
          `Price when saved: ${usdFormatter.format(parsedPrice)} USD`;
      } else {
        price.textContent = card.price_checked_at
          ? "Price unavailable when saved."
          : "No price recorded.";
      }

      item.append(price);

      if (card.price_checked_at) {
        const checkedDate = new Date(card.price_checked_at);

        if (!Number.isNaN(checkedDate.getTime())) {
          const note = document.createElement("p");
          note.className = "chase-list-note";

          const time = document.createElement("time");
          time.dateTime = card.price_checked_at;
          time.textContent = dateFormatter.format(checkedDate);

          note.append(
            "Scryfall estimate checked ",
            time,
            ". Does not update automatically.",
          );

          item.append(note);
        }
      }

      const actions = document.createElement("div");
      actions.className = "chase-list-actions";

      const removeButton = document.createElement("button");
      removeButton.type = "button";
      removeButton.className = "chase-list-remove";
      removeButton.textContent = "Remove";
      removeButton.disabled = removing;
      removeButton.setAttribute(
        "aria-label",
        `Remove ${card.name}, ${card.set_name} #${card.collector_number}, ${finishLabel(card.finish)} from your chase list`,
      );

      removeButton.addEventListener("click", () => {
        void removeCard(card, removeButton);
      });

      actions.append(removeButton);
      item.append(actions);
      list.append(item);
    }
  }

  async function loadChaseList() {
    if (!list) return;

    const currentLoad = ++loadId;

    try {
      const {
        data: { session },
        error: sessionError,
      } = await supabase.auth.getSession();

      if (currentLoad !== loadId) return;

      if (sessionError) {
        list.replaceChildren();
        setStatus("Couldn’t check your sign-in. Please try again.");
        return;
      }

      if (!session) {
        list.replaceChildren();
        setStatus("Sign in above to see your saved chase cards.");
        return;
      }

      setStatus("Loading your chase list…");

      const { data, error } = await supabase
        .from("chase_cards")
        .select(
          "id, name, set_name, collector_number, finish, image_url, scryfall_uri, price_usd, price_checked_at",
        )
        .order("created_at", { ascending: false });

      if (currentLoad !== loadId) return;

      if (error) {
        list.replaceChildren();
        setStatus(`Couldn’t load your chase list: ${error.message}`);
        return;
      }

      renderCards((data ?? []) as ChaseCard[]);
    } catch {
      if (currentLoad !== loadId) return;

      list.replaceChildren();
      setStatus("Couldn’t load your chase list. Please try again shortly.");
    }
  }

  supabase.auth.onAuthStateChange(() => {
    window.setTimeout(() => {
      void loadChaseList();
    }, 0);
  });

  window.addEventListener("chase-cards-changed", () => {
    void loadChaseList();
  });

  void loadChaseList();
</script>

<style>
  .chase-list-items :global(.chase-list-card) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
    border-radius: 1rem;
    border: 1px solid
      color-mix(in srgb, var(--color-pyroduck-plasma) 30%, transparent);
    background: var(--color-pyroduck-void);
    padding: 0.75rem;
  }

  .chase-list-items :global(.chase-list-card img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.75rem;
  }

  .chase-list-items :global(.chase-list-title) {
    margin: 0;
    font-weight: 600;
    color: var(--color-brand-text);
  }

  .chase-list-items :global(.chase-list-title a) {
    color: var(--color-pyroduck-plasma);
    text-decoration: underline;
    text-underline-offset: 3px;
    border-radius: 0.25rem;
  }

  .chase-list-items :global(.chase-list-title a:hover) {
    color: var(--color-pyroduck-lime);
  }

  .chase-list-items :global(.chase-list-title a:focus-visible) {
    outline: 2px solid var(--color-pyroduck-lime);
    outline-offset: 4px;
  }

  .chase-list-items :global(.chase-list-meta) {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-brand-muted);
  }

  .chase-list-items :global(.chase-list-price) {
    margin: 0;
    font-weight: 600;
    color: var(--color-pyroduck-lime);
  }

  .chase-list-items :global(.chase-list-note) {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--color-brand-muted);
  }

  .chase-list-items :global(.chase-list-actions) {
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .chase-list-items :global(.chase-list-remove) {
    min-height: 44px;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-pyroduck-plasma);
    border-radius: 0.5rem;
    background: transparent;
    color: var(--color-pyroduck-plasma);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color 180ms ease,
      color 180ms ease;
  }

  .chase-list-items :global(.chase-list-remove:hover:not(:disabled)) {
    background: var(--color-pyroduck-plasma);
    color: var(--color-pyroduck-void);
  }

  .chase-list-items :global(.chase-list-remove:focus-visible) {
    outline: 2px solid var(--color-pyroduck-lime);
    outline-offset: 4px;
  }

  .chase-list-items :global(.chase-list-remove:disabled) {
    opacity: 0.5;
    cursor: wait;
  }
</style>