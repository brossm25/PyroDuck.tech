---
import SaleMatches from "@/components/mtg/SaleMatches.astro";
---

<section
  aria-labelledby="chase-list-heading"
  class="rounded-2xl border border-pyroduck-plasma/30 bg-pyroduck-afterdark p-6 sm:p-8"
>
  <div class="flex flex-wrap items-center justify-between gap-4">
    <h2
      id="chase-list-heading"
      tabindex="-1"
      class="text-2xl font-bold text-brand-text sm:text-3xl"
    >
      Your chase list.
    </h2>

    <button type="button" class="chase-refresh" disabled>
      Refresh prices
    </button>
  </div>

  <p class="mt-3 max-w-2xl text-brand-muted">
    Your saved printings and finishes. Price estimates refresh when you open
    this list if their last check was more than 24 hours ago.
  </p>

  <SaleMatches />

  <p class="chase-list-status mt-4 text-brand-muted" role="status"></p>

  <p class="chase-list-total mt-3 text-xl font-bold text-pyroduck-lime"></p>

  <p class="chase-list-total-note mt-2 text-sm text-brand-muted"></p>

  <p class="chase-price-status mt-3 text-sm text-brand-muted" role="status"></p>

  <nav
    class="chase-letter-nav mt-6"
    aria-label="Jump to a chase-list letter"
    hidden
  >
    <p class="chase-letter-label">Jump to a letter</p>
    <div class="chase-letter-links"></div>
  </nav>

  <ul
    class="chase-list-items mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5"
  >
  </ul>
</section>

<dialog class="chase-preview" aria-labelledby="chase-preview-title">
  <div class="chase-preview-content">
    <button
      type="button"
      class="chase-preview-close"
      aria-label="Close card preview"
      autofocus>×</button
    >
    <h2 id="chase-preview-title" class="chase-preview-title"></h2>
    <img class="chase-preview-image" alt="" width="488" height="680" />
    <p class="chase-preview-meta"></p>
    <p class="chase-preview-error" role="status" hidden>
      Image unavailable. Please close the preview and try again.
    </p>
  </div>
</dialog>

<script>
  import { supabase } from "@/lib/supabase";

  interface ChaseCard {
    id: string;
    scryfall_id: string;
    oracle_id: string | null;
    name: string;
    set_name: string;
    collector_number: string;
    finish: string;
    image_url: string | null;
    scryfall_uri: string | null;
    price_usd: number | string | null;
    price_checked_at: string | null;
    current_price_usd: number | string | null;
    current_price_checked_at: string | null;
  }

  interface ScryfallCard {
    id: string;
    oracle_id?: string;
    prices?: {
      usd?: string | null;
      usd_foil?: string | null;
      usd_etched?: string | null;
    };
  }

  const list = document.querySelector<HTMLUListElement>(".chase-list-items");
  const status = document.querySelector<HTMLElement>(".chase-list-status");
  const priceStatus = document.querySelector<HTMLElement>(
    ".chase-price-status",
  );
  const totalElement = document.querySelector<HTMLElement>(".chase-list-total");
  const totalNote = document.querySelector<HTMLElement>(
    ".chase-list-total-note",
  );
  const refreshButton =
    document.querySelector<HTMLButtonElement>(".chase-refresh");

  const preview = document.querySelector<HTMLDialogElement>(".chase-preview");
  const previewImage = document.querySelector<HTMLImageElement>(
    ".chase-preview-image",
  );
  const previewTitle = document.querySelector<HTMLElement>(
    ".chase-preview-title",
  );
  const previewMeta = document.querySelector<HTMLElement>(
    ".chase-preview-meta",
  );
  const previewError = document.querySelector<HTMLElement>(
    ".chase-preview-error",
  );
  let previewCardId: string | undefined;
  let previewOpener: HTMLButtonElement | undefined;

  function openPreview(card: ChaseCard, opener: HTMLButtonElement) {
    if (!preview || !previewImage || !card.image_url) return;
    previewCardId = card.id;
    previewOpener = opener;
    if (previewTitle) previewTitle.textContent = card.name;
    if (previewMeta)
      previewMeta.textContent = `${card.set_name} #${card.collector_number} · ${finishLabel(card.finish)}`;
    if (previewError) previewError.hidden = true;
    previewImage.hidden = false;
    previewImage.alt = card.name;
    previewImage.src = card.image_url;
    if (!preview.open) preview.showModal();
  }

  previewImage?.addEventListener("error", () => {
    previewImage.hidden = true;
    if (previewError) previewError.hidden = false;
  });

  document
    .querySelector<HTMLButtonElement>(".chase-preview-close")
    ?.addEventListener("click", () => preview?.close());

  let backdropPress = false;
  preview?.addEventListener("pointerdown", (event) => {
    backdropPress = event.target === preview;
  });
  preview?.addEventListener("click", (event) => {
    if (backdropPress && event.target === preview) preview.close();
    backdropPress = false;
  });
  preview?.addEventListener("close", () => {
    const matchingButton = Array.from(
      list?.querySelectorAll<HTMLButtonElement>(".chase-card-preview") ?? [],
    ).find((button) => button.dataset.cardId === previewCardId);
    const target =
      matchingButton ??
      (previewOpener?.isConnected ? previewOpener : undefined);
    (
      target ?? document.querySelector<HTMLElement>("#chase-list-heading")
    )?.focus({ preventScroll: true });
    previewCardId = undefined;
    previewOpener = undefined;
  });

  const usdFormatter = new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
  });

  const dateFormatter = new Intl.DateTimeFormat(undefined, {
    year: "numeric",
    month: "short",
    day: "numeric",
    hour: "numeric",
    minute: "2-digit",
  });

  const letterNav = document.querySelector<HTMLElement>(".chase-letter-nav");
  const letterLinks = document.querySelector<HTMLElement>(
    ".chase-letter-links",
  );
  const nameSorter = new Intl.Collator("en", {
    sensitivity: "base",
    numeric: true,
  });
  const alphabet = ["#", ..."ABCDEFGHIJKLMNOPQRSTUVWXYZ"];

  function cardLetter(name: string) {
    const first = name
      .trim()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .charAt(0)
      .toUpperCase();
    return /^[A-Z]$/.test(first) ? first : "#";
  }

  function compareCards(a: ChaseCard, b: ChaseCard) {
    return (
      alphabet.indexOf(cardLetter(a.name)) -
        alphabet.indexOf(cardLetter(b.name)) ||
      nameSorter.compare(a.name, b.name) ||
      nameSorter.compare(a.set_name, b.set_name) ||
      nameSorter.compare(a.collector_number, b.collector_number) ||
      nameSorter.compare(a.finish, b.finish) ||
      nameSorter.compare(a.id, b.id)
    );
  }

  function letterId(letter: string) {
    return `chase-letter-${letter === "#" ? "other" : letter.toLowerCase()}`;
  }

  function renderLetterNav() {
    if (!letterNav || !letterLinks) return;
    letterLinks.replaceChildren();
    letterNav.hidden = cards.length === 0;
    const available = new Set(cards.map((card) => cardLetter(card.name)));

    for (const letter of alphabet) {
      if (available.has(letter)) {
        const link = document.createElement("a");
        link.href = `#${letterId(letter)}`;
        link.textContent = letter;
        link.setAttribute(
          "aria-label",
          `Jump to ${letter === "#" ? "numbers and symbols" : letter}`,
        );
        link.addEventListener("click", (event) => {
          const heading = document.getElementById(letterId(letter));
          if (!heading) return;
          event.preventDefault();
          heading.focus({ preventScroll: true });
          heading.scrollIntoView({
            behavior: window.matchMedia("(prefers-reduced-motion: reduce)")
              .matches
              ? "instant"
              : "smooth",
            block: "start",
          });
        });
        letterLinks.append(link);
      } else {
        const unavailable = document.createElement("span");
        unavailable.textContent = letter;
        unavailable.setAttribute("aria-disabled", "true");
        unavailable.setAttribute("aria-label", `No cards under ${letter}`);
        letterLinks.append(unavailable);
      }
    }
  }

  const refreshAge = 24 * 60 * 60 * 1000;

  let cards: ChaseCard[] = [];
  let loading = false;
  let refreshing = false;
  let removing = false;
  let signedIn = false;
  let requestId = 0;
  let refreshController: AbortController | undefined;

  function finishLabel(finish: string) {
    if (finish === "nonfoil") return "Nonfoil";
    if (finish === "foil") return "Foil";
    if (finish === "etched") return "Etched foil";
    return finish;
  }

  function parsePrice(value: number | string | null | undefined) {
    if (value == null || String(value).trim() === "") return null;

    const price = Number(value);
    return Number.isFinite(price) && price >= 0 ? price : null;
  }

  function priceForFinish(card: ScryfallCard, finish: string) {
    if (finish === "nonfoil") return parsePrice(card.prices?.usd);
    if (finish === "foil") return parsePrice(card.prices?.usd_foil);
    if (finish === "etched") return parsePrice(card.prices?.usd_etched);
    return null;
  }

  function needsRefresh(card: ChaseCard) {
    if (!card.current_price_checked_at) return true;

    const checked = Date.parse(card.current_price_checked_at);

    return (
      !Number.isFinite(checked) ||
      checked > Date.now() ||
      Date.now() - checked >= refreshAge
    );
  }

  function displayedPrice(card: ChaseCard) {
    // A completed current check can legitimately have no available price.
    if (card.current_price_checked_at) {
      return parsePrice(card.current_price_usd);
    }

    return parsePrice(card.price_usd);
  }

  function setStatus(message: string) {
    if (status) status.textContent = message;
  }

  function setPriceStatus(message: string) {
    if (priceStatus) priceStatus.textContent = message;
  }

  function syncButtons() {
    const busy = loading || refreshing || removing;

    if (refreshButton) {
      refreshButton.disabled = busy || !signedIn || cards.length === 0;
      refreshButton.textContent = refreshing ? "Refreshing…" : "Refresh prices";
    }

    list
      ?.querySelectorAll<HTMLButtonElement>(".chase-list-remove")
      .forEach((button) => {
        button.disabled = busy;
      });
  }

  function clearTotal() {
    if (totalElement) totalElement.textContent = "";
    if (totalNote) totalNote.textContent = "";
  }

  function renderTotal() {
    clearTotal();
    if (cards.length === 0) return;

    let totalCents = 0;
    let missing = 0;
    let savedFallbacks = 0;
    let stale = 0;

    for (const card of cards) {
      const price = displayedPrice(card);

      if (price === null) {
        missing++;
        continue;
      }

      totalCents += Math.round(price * 100);

      if (!card.current_price_checked_at) {
        savedFallbacks++;
      } else if (needsRefresh(card)) {
        stale++;
      }
    }

    if (totalElement) {
      totalElement.textContent =
        missing === cards.length
          ? "Total chase-list estimate: unavailable"
          : `Total chase-list estimate: ${usdFormatter.format(
              totalCents / 100,
            )} USD`;
    }

    const notes = ["One copy per saved entry."];

    if (savedFallbacks > 0) {
      notes.push(
        `${savedFallbacks} ${
          savedFallbacks === 1 ? "entry uses its" : "entries use their"
        } original saved price until refreshed.`,
      );
    }

    if (stale > 0) {
      notes.push(
        `${stale} ${stale === 1 ? "estimate is" : "estimates are"} over 24 hours old.`,
      );
    }

    if (missing > 0) {
      notes.push(
        `${missing} ${
          missing === 1 ? "entry has" : "entries have"
        } no available price and ${missing === 1 ? "is" : "are"} excluded.`,
      );
    }

    notes.push("Estimates exclude shipping and tax.");

    if (totalNote) totalNote.textContent = notes.join(" ");
  }

  function addText(parent: HTMLElement, className: string, text: string) {
    const paragraph = document.createElement("p");
    paragraph.className = className;
    paragraph.textContent = text;
    parent.append(paragraph);
  }

  function renderCards() {
    if (!list) return;

    list.replaceChildren();
    renderTotal();
    renderLetterNav();

    setStatus(
      cards.length === 0
        ? "No cards saved yet. Use Find a card and “Use this version”."
        : `${cards.length} saved ${cards.length === 1 ? "card" : "cards"}.`,
    );

    let previousLetter = "";
    for (const card of [...cards].sort(compareCards)) {
      const letter = cardLetter(card.name);
      if (letter !== previousLetter) {
        const divider = document.createElement("li");
        divider.className = "chase-letter-divider";
        const heading = document.createElement("h3");
        heading.id = letterId(letter);
        heading.tabIndex = -1;
        heading.textContent = letter;
        divider.append(heading);
        list.append(divider);
        previousLetter = letter;
      }
      const item = document.createElement("li");
      item.className = "chase-list-card";

      if (card.image_url) {
        const image = document.createElement("img");
        image.src = card.image_url;
        image.alt = card.name;
        image.loading = "lazy";
        image.width = 488;
        image.height = 680;
        const imageButton = document.createElement("button");
        imageButton.type = "button";
        imageButton.className = "chase-card-preview";
        imageButton.dataset.cardId = card.id;
        imageButton.setAttribute("aria-haspopup", "dialog");
        imageButton.setAttribute(
          "aria-label",
          `Enlarge ${card.name}, ${card.set_name} #${card.collector_number}, ${finishLabel(card.finish)}`,
        );
        imageButton.addEventListener("click", () =>
          openPreview(card, imageButton),
        );
        imageButton.append(image);
        item.append(imageButton);
      }

      const title = document.createElement("p");
      title.className = "chase-list-title";

      if (card.scryfall_uri) {
        const link = document.createElement("a");
        link.href = card.scryfall_uri;
        link.target = "_blank";
        link.rel = "noopener noreferrer";
        link.textContent = `${card.name} ↗`;
        title.append(link);
      } else {
        title.textContent = card.name;
      }

      item.append(title);

      addText(
        item,
        "chase-list-meta",
        `${card.set_name} #${card.collector_number} · ${finishLabel(card.finish)}`,
      );

      const current = parsePrice(card.current_price_usd);
      const original = parsePrice(card.price_usd);

      if (card.current_price_checked_at) {
        addText(
          item,
          "chase-list-price",
          current === null
            ? "Current estimate: unavailable"
            : `Current estimate: ${usdFormatter.format(current)} USD`,
        );
      } else {
        addText(
          item,
          "chase-list-price",
          original === null
            ? "Current estimate: not checked yet"
            : `Last saved estimate: ${usdFormatter.format(original)} USD`,
        );
      }

      const checkedAt = card.current_price_checked_at ?? card.price_checked_at;

      if (checkedAt) {
        const date = new Date(checkedAt);

        if (!Number.isNaN(date.getTime())) {
          const note = document.createElement("p");
          note.className = "chase-list-note";

          const time = document.createElement("time");
          time.dateTime = checkedAt;
          time.textContent = dateFormatter.format(date);

          note.append(
            card.current_price_checked_at
              ? "Scryfall checked "
              : "Original estimate checked ",
            time,
            ".",
          );

          if (card.current_price_checked_at && needsRefresh(card)) {
            note.append(" Refresh due.");
          }

          item.append(note);
        }
      }

      const actions = document.createElement("div");
      actions.className = "chase-list-actions";

      const button = document.createElement("button");
      button.type = "button";
      button.className = "chase-list-remove";
      button.textContent = "×";
      button.title = `Remove ${card.name}`;
      button.setAttribute(
        "aria-label",
        `Remove ${card.name}, ${card.set_name} #${card.collector_number}, ${finishLabel(card.finish)} from your chase list`,
      );

      button.addEventListener("click", () => {
        void removeCard(card, button);
      });

      actions.append(button);
      item.append(actions);
      list.append(item);
    }

    syncButtons();
  }

  async function refreshPrices(force = false) {
    if (!signedIn || loading || refreshing || removing) return;

    const pending = cards.filter((card) => force || needsRefresh(card));
    if (pending.length === 0) return;

    const activeRequest = requestId;
    const controller = new AbortController();
    refreshController = controller;
    refreshing = true;
    syncButtons();

    let updated = 0;
    let failed = 0;
    let lastError = "";

    try {
      for (const [index, card] of pending.entries()) {
        if (controller.signal.aborted || activeRequest !== requestId) return;

        setPriceStatus(`Checking prices ${index + 1} of ${pending.length}…`);

        // Space requests instead of fetching every card at once.
        await new Promise((resolve) => window.setTimeout(resolve, 150));

        if (controller.signal.aborted || activeRequest !== requestId) return;

        let stop = false;
        const timeout = window.setTimeout(() => controller.abort(), 15000);

        try {
          if (!card.scryfall_id) {
            throw new Error(
              "A saved card is missing its Scryfall printing ID.",
            );
          }

          const response = await fetch(
            `https://api.scryfall.com/cards/${encodeURIComponent(card.scryfall_id)}`,
            {
              headers: { Accept: "application/json" },
              signal: controller.signal,
            },
          );

          if (response.status === 429) {
            stop = true;
            throw new Error("Scryfall is busy. Please try refreshing later.");
          }

          if (!response.ok) {
            throw new Error("A printing’s price could not be retrieved.");
          }

          const printing: ScryfallCard = await response.json();

          if (printing.id !== card.scryfall_id) {
            throw new Error("The returned printing did not match.");
          }

          if (controller.signal.aborted || activeRequest !== requestId) return;

          const price = priceForFinish(printing, card.finish);

          // Keep an existing estimate if Scryfall temporarily has no price.
          if (price === null && displayedPrice(card) !== null) {
            throw new Error(
              "Some prices are unavailable. Their previous estimates were kept.",
            );
          }

          const checkedAt = new Date().toISOString();

          const { data, error } = await supabase
            .from("chase_cards")
            .update({
              ...(printing.oracle_id ? { oracle_id: printing.oracle_id } : {}),
              current_price_usd: price,
              current_price_checked_at: checkedAt,
            })
            .eq("id", card.id)
            .select("id");

          if (controller.signal.aborted || activeRequest !== requestId) return;

          if (error) {
            stop = true;
            throw new Error(`Couldn’t save refreshed prices: ${error.message}`);
          }

          if (!data?.length) {
            stop = true;
            throw new Error(
              "Price updates were not saved. Check your chase_cards UPDATE permission.",
            );
          }

          card.current_price_usd = price;
          card.current_price_checked_at = checkedAt;
          updated++;
        } catch (error) {
          if (activeRequest !== requestId) return;

          failed++;
          lastError = controller.signal.aborted
            ? "The refresh timed out. Previous estimates were kept."
            : error instanceof Error
              ? error.message
              : "Some prices could not be refreshed.";

          if (controller.signal.aborted) stop = true;
        } finally {
          window.clearTimeout(timeout);
        }

        if (stop) break;
      }

      if (activeRequest !== requestId) return;

      renderCards();

      setPriceStatus(
        failed > 0
          ? `${updated} updated. ${lastError}`
          : `Prices checked for ${updated} ${
              updated === 1 ? "entry" : "entries"
            }.`,
      );
    } finally {
      if (refreshController === controller) {
        refreshing = false;
        refreshController = undefined;
        syncButtons();
      }
    }
  }

  async function removeCard(card: ChaseCard, button: HTMLButtonElement) {
    if (loading || refreshing || removing) return;

    if (
      !window.confirm(
        `Remove ${card.name} — ${card.set_name} #${card.collector_number} (${finishLabel(card.finish)}) from your chase list?`,
      )
    ) {
      return;
    }

    removing = true;
    syncButtons();
    button.textContent = "…";
    setStatus(`Removing ${card.name}…`);

    let removed = false;

    try {
      const {
        data: { session },
        error: sessionError,
      } = await supabase.auth.getSession();

      if (sessionError || !session) {
        setStatus("Please sign in again before removing a card.");
        return;
      }

      const { data, error } = await supabase
        .from("chase_cards")
        .delete()
        .eq("id", card.id)
        .select("id");

      if (error) {
        setStatus(`Couldn’t remove the card: ${error.message}`);
        return;
      }

      if (!data?.length) {
        setStatus("The card wasn’t removed. Refresh your list and try again.");
        return;
      }

      removed = true;
      await loadChaseList(false);
    } catch {
      setStatus("Couldn’t remove the card. Please try again shortly.");
    } finally {
      removing = false;
      button.textContent = "×";
      syncButtons();

      if (removed) {
        const next =
          list?.querySelector<HTMLButtonElement>(".chase-list-remove");

        if (next) {
          next.focus();
        } else {
          document.querySelector<HTMLElement>("#chase-list-heading")?.focus();
        }
      }
    }
  }

  async function loadChaseList(autoRefresh = true) {
    if (!list) return;

    const activeRequest = ++requestId;

    refreshController?.abort();
    loading = true;
    clearTotal();
    if (letterNav) letterNav.hidden = true;
    setPriceStatus("");
    syncButtons();

    let loaded = false;

    try {
      const {
        data: { session },
        error: sessionError,
      } = await supabase.auth.getSession();

      if (activeRequest !== requestId) return;

      signedIn = Boolean(session) && !sessionError;

      if (sessionError || !session) {
        cards = [];
        list.replaceChildren();
        setStatus(
          sessionError
            ? "Couldn’t check your sign-in. Please try again."
            : "Sign in above to see your saved chase cards.",
        );
        return;
      }

      const loadedCards: ChaseCard[] = [];
      const pageSize = 100;
      let offset = 0;

      while (true) {
        const { data, error } = await supabase
          .from("chase_cards")
          .select(
            "id, scryfall_id, oracle_id, name, set_name, collector_number, finish, image_url, scryfall_uri, price_usd, price_checked_at, current_price_usd, current_price_checked_at",
          )
          .eq("user_id", session.user.id)
          .order("name", { ascending: true })
          .order("id", { ascending: true })
          .range(offset, offset + pageSize - 1);

        if (activeRequest !== requestId) return;

        if (error) {
          cards = [];
          list.replaceChildren();
          setStatus(`Couldn’t load your chase list: ${error.message}`);
          return;
        }

        const page = (data ?? []) as ChaseCard[];
        loadedCards.push(...page);

        if (page.length === 0) break;

        offset += page.length;
      }

      cards = loadedCards;
      renderCards();
      window.dispatchEvent(new Event("chase-list-loaded"));
      loaded = true;
    } catch {
      if (activeRequest !== requestId) return;

      cards = [];
      list.replaceChildren();
      setStatus("Couldn’t load your chase list. Please try again shortly.");
    } finally {
      if (activeRequest === requestId) {
        loading = false;
        syncButtons();
      }
    }

    if (loaded && autoRefresh && activeRequest === requestId) {
      // Allow an aborted earlier refresh to finish cleaning up.
      window.setTimeout(() => {
        if (activeRequest === requestId) void refreshPrices();
      }, 0);
    }
  }

  refreshButton?.addEventListener("click", () => {
    void refreshPrices(true);
  });

  let observedUserId: string | null | undefined;
  let authLoadTimer: number | undefined;

  supabase.auth.onAuthStateChange((event, session) => {
    if (
      event !== "INITIAL_SESSION" &&
      event !== "SIGNED_IN" &&
      event !== "SIGNED_OUT"
    ) {
      return;
    }

    const nextUserId = session?.user.id ?? null;

    // Repeated sign-in events for the same user need no reload.
    if (nextUserId === observedUserId) return;
    observedUserId = nextUserId;

    // Immediately invalidate requests and clear the previous user's cards.
    requestId++;
    refreshController?.abort();
    signedIn = false;
    loading = true;
    cards = [];
    list?.replaceChildren();
    clearTotal();
    setPriceStatus("");
    if (letterNav) letterNav.hidden = true;
    if (preview?.open) preview.close();
    setStatus(
      nextUserId
        ? "Loading your chase list…"
        : "Sign in above to see your saved chase cards.",
    );
    syncButtons();

    window.clearTimeout(authLoadTimer);
    authLoadTimer = window.setTimeout(() => {
      void loadChaseList();
    }, 0);
  });

  window.addEventListener("chase-cards-changed", () => {
    void loadChaseList();
  });
</script>

