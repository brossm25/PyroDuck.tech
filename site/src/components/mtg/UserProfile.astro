<dialog
  class="profile-dialog"
  aria-labelledby="profile-dialog-heading"
  aria-describedby="profile-dialog-description"
>
  <div class="profile-dialog-header">
    <h2 id="profile-dialog-heading">Your player profile.</h2>

    <button
      type="button"
      class="profile-close profile-secondary"
      aria-label="Close profile editor"
      autofocus
    >
      ✕
    </button>
  </div>

  <p id="profile-dialog-description" class="profile-description">
    Choose your username and display name. Your email stays separate and is
    still used to sign in.
  </p>

  <p class="profile-status" role="status"></p>

  <form class="profile-form" autocomplete="off" novalidate hidden>
    <fieldset class="profile-fields" disabled>
      <div>
        <label for="player-username" class="profile-label"> Username </label>

        <input
          id="player-username"
          name="player_handle"
          type="text"
          required
          minlength="3"
          maxlength="24"
          pattern="[a-z0-9][a-z0-9_]{2,23}"
          autocomplete="off"
          autocapitalize="none"
          spellcheck="false"
          aria-describedby="username-help"
          placeholder="ducky"
          class="profile-input"
        />

        <p id="username-help" class="profile-help">
          3–24 letters, numbers, or underscores. Start with a letter or number.
          Usernames are saved in lowercase and must be unique.
        </p>
      </div>

      <div>
        <label for="player-display-name" class="profile-label">
          Display name
        </label>

        <input
          id="player-display-name"
          name="display_name"
          type="text"
          required
          maxlength="60"
          autocomplete="nickname"
          placeholder="Ducky"
          class="profile-input"
        />

        <p class="profile-help">
          The name other players see. Spaces and capital letters are fine.
        </p>
      </div>

      <div class="profile-actions">
        <button type="submit" class="profile-save"> Save profile </button>

        <button type="button" class="profile-cancel profile-secondary">
          Cancel
        </button>
      </div>
    </fieldset>
  </form>
</dialog>

<script>
  import { supabase } from "@/lib/supabase";
  import { createAccountChangeGuard } from "@/lib/authAccountGuard";

  interface Profile {
    id: string;
    username: string;
    display_name: string;
  }

  const dialog = document.querySelector<HTMLDialogElement>(".profile-dialog");
  const form = document.querySelector<HTMLFormElement>(".profile-form");
  const fields = document.querySelector<HTMLFieldSetElement>(".profile-fields");
  const usernameInput =
    document.querySelector<HTMLInputElement>("#player-username");
  const displayNameInput = document.querySelector<HTMLInputElement>(
    "#player-display-name",
  );
  const status = document.querySelector<HTMLElement>(".profile-status");
  const saveButton = document.querySelector<HTMLButtonElement>(".profile-save");
  const closeButton =
    document.querySelector<HTMLButtonElement>(".profile-close");
  const cancelButton =
    document.querySelector<HTMLButtonElement>(".profile-cancel");

  let profile: Profile | null = null;
  let activeUserId: string | null = null;
  let loading = false;
  let saving = false;
  let requestId = 0;
  let returnFocus: HTMLElement | null = null;

  function setStatus(message: string) {
    if (status) status.textContent = message;
  }

  function render() {
    if (form) form.hidden = loading || !activeUserId;

    if (fields) {
      fields.disabled = loading || saving || !activeUserId;
    }

    if (closeButton) closeButton.disabled = saving;
    if (cancelButton) cancelButton.disabled = saving;

    if (saveButton) {
      saveButton.textContent = saving ? "Saving…" : "Save profile";
    }
  }

  function fillInputs() {
    if (usernameInput) {
      usernameInput.value = profile?.username ?? "";
      usernameInput.setCustomValidity("");
    }

    if (displayNameInput) {
      displayNameInput.value = profile?.display_name ?? "";
      displayNameInput.setCustomValidity("");
    }
  }

  function openDialog() {
    if (!dialog || dialog.open) return;

    if (!returnFocus && document.activeElement instanceof HTMLElement) {
      returnFocus = document.activeElement;
    }

    dialog.showModal();
  }

  function resetProfile() {
    requestId++;
    profile = null;
    activeUserId = null;
    loading = false;
    saving = false;

    dialog?.close();
    fillInputs();
    setStatus("");
    render();
  }

  async function loadProfile(openRequested = false) {
    if (saving) return;

    const currentRequest = ++requestId;

    loading = true;
    activeUserId = null;
    profile = null;

    fillInputs();
    render();
    setStatus("Loading your profile…");

    if (openRequested) openDialog();

    try {
      const {
        data: { session },
        error: sessionError,
      } = await supabase.auth.getSession();

      if (currentRequest !== requestId) return;

      if (sessionError) {
        setStatus("Couldn’t check your sign-in. Close and try again.");
        return;
      }

      if (!session) {
        setStatus("Sign in using the header to edit your profile.");
        return;
      }

      const { data, error } = await supabase
        .from("profiles")
        .select("id, username, display_name")
        .eq("id", session.user.id)
        .maybeSingle();

      if (currentRequest !== requestId) return;

      if (error) {
        setStatus(`Couldn’t load your profile: ${error.message}`);
        return;
      }

      activeUserId = session.user.id;
      profile = data as Profile | null;
      fillInputs();

      setStatus(profile ? "" : "Choose your player identity to get started.");

      if (!profile) openDialog();
    } catch {
      if (currentRequest === requestId) {
        setStatus("Couldn’t load your profile. Close and try again.");
      }
    } finally {
      if (currentRequest === requestId) {
        loading = false;
        render();
      }
    }
  }

  window.addEventListener("open-player-profile", (event) => {
    if (saving) return;

    if (
      event instanceof CustomEvent &&
      event.detail?.opener instanceof HTMLElement
    ) {
      returnFocus = event.detail.opener;
    }

    void loadProfile(true);
  });

  closeButton?.addEventListener("click", () => {
    if (!saving) dialog?.close();
  });

  cancelButton?.addEventListener("click", () => {
    if (!saving) dialog?.close();
  });

  dialog?.addEventListener("cancel", (event) => {
    if (saving) event.preventDefault();
  });

  dialog?.addEventListener("close", () => {
    fillInputs();

    if (returnFocus?.isConnected && returnFocus.getClientRects().length) {
      returnFocus.focus();
    }

    returnFocus = null;
  });

  usernameInput?.addEventListener("input", () => {
    usernameInput.setCustomValidity("");
  });

  displayNameInput?.addEventListener("input", () => {
    displayNameInput.setCustomValidity("");
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (
      saving ||
      loading ||
      !activeUserId ||
      !usernameInput ||
      !displayNameInput
    ) {
      return;
    }

    const username = usernameInput.value.trim().toLowerCase();
    const displayName = displayNameInput.value.trim();

    usernameInput.value = username;
    displayNameInput.value = displayName;

    usernameInput.setCustomValidity(
      /^[a-z0-9][a-z0-9_]{2,23}$/.test(username)
        ? ""
        : "Use 3–24 letters, numbers, or underscores. Start with a letter or number.",
    );

    displayNameInput.setCustomValidity(
      displayName.length >= 1 && displayName.length <= 60
        ? ""
        : "Enter a display name between 1 and 60 characters.",
    );

    if (!form.reportValidity()) return;

    const userId = activeUserId;
    const currentRequest = requestId;

    saving = true;
    render();
    setStatus("Saving your profile…");

    try {
      const {
        data: { session },
        error: sessionError,
      } = await supabase.auth.getSession();

      if (currentRequest !== requestId) return;

      if (sessionError || session?.user.id !== userId) {
        setStatus("Your sign-in changed. Close and reopen the editor.");
        return;
      }

      const values = {
        username,
        display_name: displayName,
      };

      const result = profile
        ? await supabase
            .from("profiles")
            .update(values)
            .eq("id", userId)
            .select("id, username, display_name")
            .single()
        : await supabase
            .from("profiles")
            .insert({ id: userId, ...values })
            .select("id, username, display_name")
            .single();

      if (currentRequest !== requestId) return;

      if (result.error) {
        setStatus(
          result.error.code === "23505"
            ? "That username is taken, or your profile was created in another tab. Try another username or reopen the editor."
            : `Couldn’t save your profile: ${result.error.message}`,
        );
        return;
      }

      profile = result.data as Profile;
      setStatus("");

      window.dispatchEvent(
        new CustomEvent("player-profile-changed", {
          detail: {
            displayName: profile.display_name,
            username: profile.username,
          },
        }),
      );

      dialog?.close();
    } catch {
      if (currentRequest === requestId) {
        setStatus("Couldn’t save your profile. Please try again.");
      }
    } finally {
      if (currentRequest === requestId) {
        saving = false;
        render();
      }
    }
  });

  const accountChanged = createAccountChangeGuard(true);
  let authLoadTimer: number | undefined;

  supabase.auth.onAuthStateChange((event, session) => {
    if (!accountChanged(event, session)) return;

    window.clearTimeout(authLoadTimer);
    resetProfile();

    if (session?.user.id) {
      authLoadTimer = window.setTimeout(() => {
        void loadProfile();
      }, 0);
    }
  });
</script>

<style>
  [hidden] {
    display: none !important;
  }

  .profile-dialog {
    box-sizing: border-box;
    width: min(34rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: 1.5rem;
    overflow-y: auto;
    border: 1px solid var(--color-pyroduck-plasma);
    border-radius: 1rem;
    background: var(--color-pyroduck-afterdark);
    color: var(--color-brand-text);
    box-shadow: 0 0 50px
      color-mix(in srgb, var(--color-pyroduck-plasma) 18%, transparent);
  }

  .profile-dialog::backdrop {
    background: rgb(0 0 0 / 80%);
  }

  .profile-dialog-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.4rem, 5vw, 1.8rem);
    font-weight: 700;
  }

  .profile-description,
  .profile-status {
    margin: 1rem 0 0;
    color: var(--color-brand-muted);
    line-height: 1.6;
  }

  .profile-status:empty {
    display: none;
  }

  .profile-form {
    margin-top: 1.5rem;
  }

  .profile-fields {
    display: grid;
    gap: 1.5rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .profile-label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  .profile-input {
    box-sizing: border-box;
    width: 100%;
    min-height: 44px;
    padding: 0.75rem 1rem;
    border: 1px solid
      color-mix(in srgb, var(--color-pyroduck-plasma) 45%, transparent);
    border-radius: 0.5rem;
    background: var(--color-pyroduck-void);
    color: var(--color-brand-text);
    font: inherit;
  }

  .profile-help {
    margin: 0.5rem 0 0;
    color: var(--color-brand-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .profile-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  button {
    min-height: 44px;
    padding: 0.75rem 1.25rem;
    border-radius: 0.5rem;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .profile-save {
    border: 1px solid var(--color-pyroduck-plasma);
    background: var(--color-pyroduck-plasma);
    color: var(--color-pyroduck-void);
  }

  .profile-save:hover:not(:disabled) {
    border-color: var(--color-pyroduck-lime);
    background: var(--color-pyroduck-lime);
  }

  .profile-secondary {
    border: 1px solid var(--color-pyroduck-plasma);
    background: transparent;
    color: var(--color-brand-text);
  }

  .profile-secondary:hover:not(:disabled) {
    color: var(--color-pyroduck-lime);
  }

  .profile-close {
    flex-shrink: 0;
    width: 44px;
    padding: 0;
  }

  input:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--color-pyroduck-lime);
    outline-offset: 3px;
  }

  .profile-fields:disabled,
  button:disabled {
    opacity: 0.6;
  }

  button:disabled {
    cursor: default;
  }
</style>
