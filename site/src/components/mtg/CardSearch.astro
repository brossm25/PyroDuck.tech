<section aria-labelledby="card-search-heading">
  <h2 id="card-search-heading" class="text-3xl font-bold text-brand-text">
    Find a card.
  </h2>

  <form class="card-search-form mt-6 flex flex-col gap-3 sm:flex-row">
    <div class="min-w-0 flex-1">
      <label for="card-query" class="sr-only">Card name</label>
      <input
        id="card-query"
        name="query"
        type="search"
        list="card-name-suggestions"
        autocomplete="off"
        aria-describedby="card-search-help"
        required
        maxlength="100"
        placeholder="Try Chromatic Lantern"
        class="w-full rounded-lg border border-pyroduck-plasma/40 bg-pyroduck-afterdark px-4 py-3 text-brand-text focus-visible:outline-2 focus-visible:outline-pyroduck-lime"
      />
      <datalist id="card-name-suggestions"></datalist>
    </div>

    <button
      type="submit"
      class="rounded-lg bg-pyroduck-plasma px-6 py-3 font-semibold text-pyroduck-void hover:bg-pyroduck-lime focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-pyroduck-lime disabled:opacity-60"
    >
      Search
    </button>
  </form>

  <p id="card-search-help" class="mt-3 text-sm text-brand-muted">
    Type at least two characters for card-name suggestions, then select a name
    or press Search.
  </p>

  <p class="search-status mt-4 text-brand-muted" role="status"></p>

  <ul
    class="search-results mt-6 grid grid-cols-1 gap-6 sm:grid-cols-3 lg:grid-cols-4"
  >
  </ul>

  <p class="mt-3 text-sm text-brand-muted">
    Card information, images, and price estimates provided by{" "}
    <a
      href="https://scryfall.com"
      class="text-pyroduck-plasma underline hover:text-pyroduck-lime"
    >
      Scryfall
    </a>
  </p>
</section>

<dialog
  class="printing-dialog text-brand-text"
  aria-label="Choose card printing"
>
  <form method="dialog" class="printing-controls">
    <button type="submit" class="printing-button" autofocus>Close ✕</button>
  </form>

  <h3 class="text-2xl font-bold">Choose your version.</h3>
  <p class="printing-status mt-3 text-brand-muted" role="status"></p>

  <label class="printing-label">
    Set and collector number
    <select class="printing-select" disabled></select>
  </label>

  <img class="printing-image" alt="" hidden />

  <label class="printing-label">
    Finish
    <select class="finish-select" disabled></select>
  </label>

  <p class="printing-price text-brand-muted" role="status"></p>

  <button type="button" class="printing-confirm printing-button" disabled>
    Use this version
  </button>

  <p class="mt-4 text-sm text-brand-muted">
    Saves this printing, finish, and available USD price estimate to your chase
    list when you’re signed in. The saved price does not update automatically.
  </p>
</dialog>

<script>
  import { supabase } from "@/lib/supabase";

  interface Card {
    id: string;
    oracle_id?: string;
    name: string;
    scryfall_uri: string;
    prints_search_uri: string;
    set_name: string;
    collector_number: string;
    finishes: string[];
    prices?: {
      usd: string | null;
      usd_foil: string | null;
      usd_etched: string | null;
    };
    image_uris?: { normal: string };
    card_faces?: { image_uris?: { normal: string } }[];
  }

  interface CardPage {
    data: Card[];
    has_more: boolean;
    next_page?: string;
  }

  const form = document.querySelector<HTMLFormElement>(".card-search-form");
  const status = document.querySelector<HTMLElement>(".search-status");
  const results = document.querySelector<HTMLUListElement>(".search-results");
  const dialog = document.querySelector<HTMLDialogElement>(".printing-dialog");
  const printingSelect =
    document.querySelector<HTMLSelectElement>(".printing-select");
  const finishSelect =
    document.querySelector<HTMLSelectElement>(".finish-select");
  const printingImage =
    document.querySelector<HTMLImageElement>(".printing-image");
  const printingStatus =
    document.querySelector<HTMLElement>(".printing-status");
  const printingPrice = document.querySelector<HTMLElement>(".printing-price");
  const confirmButton =
    document.querySelector<HTMLButtonElement>(".printing-confirm");

  const queryInput = document.querySelector<HTMLInputElement>("#card-query");
  const suggestions = document.querySelector<HTMLDataListElement>(
    "#card-name-suggestions",
  );
  let suggestionTimer: number | undefined;
  let suggestionRequest: AbortController | undefined;
  let suggestionVersion = 0;
  let searchRequest: AbortController | undefined;

  function clearSuggestions() {
    window.clearTimeout(suggestionTimer);
    suggestionRequest?.abort();
    suggestionVersion++;
    suggestions?.replaceChildren();
  }

  queryInput?.addEventListener("input", () => {
    clearSuggestions();
    const query = queryInput.value.trim();
    if (query.length < 2 || !suggestions) return;
    const version = suggestionVersion;

    suggestionTimer = window.setTimeout(async () => {
      const controller = new AbortController();
      suggestionRequest = controller;
      try {
        const endpoint = new URL("https://api.scryfall.com/cards/autocomplete");
        endpoint.searchParams.set("q", query);
        const response = await fetch(endpoint, {
          headers: { Accept: "application/json" },
          signal: controller.signal,
        });
        if (!response.ok) return;
        const payload: { data?: unknown } = await response.json();
        if (
          controller.signal.aborted ||
          version !== suggestionVersion ||
          queryInput.value.trim() !== query
        )
          return;
        if (!Array.isArray(payload.data)) return;
        for (const name of payload.data.slice(0, 10)) {
          if (typeof name === "string")
            suggestions.append(new Option(name, name));
        }
      } catch {
        // Suggestions are optional; the regular Search button still works.
      }
    }, 300);
  });

  queryInput?.addEventListener("change", () => {
    if (
      suggestions &&
      Array.from(suggestions.options).some(
        (option) => option.value === queryInput.value,
      )
    ) {
      form?.requestSubmit();
    }
  });

  const usdFormatter = new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
  });

  let printings: Card[] = [];
  let pickerRequest: AbortController | undefined;
  let saving = false;
  let printingsCheckedAt: string | null = null;

  function getImage(card: Card) {
    return card.image_uris?.normal ?? card.card_faces?.[0]?.image_uris?.normal;
  }

  function finishLabel(finish: string) {
    if (finish === "nonfoil") return "Nonfoil";
    if (finish === "etched") return "Etched foil";
    if (finish === "foil") return "Foil";
    return finish;
  }

  function getPrice(card: Card, finish: string): number | null {
    const rawPrice =
      finish === "foil"
        ? card.prices?.usd_foil
        : finish === "etched"
          ? card.prices?.usd_etched
          : finish === "nonfoil"
            ? card.prices?.usd
            : null;

    if (rawPrice == null || rawPrice.trim() === "") return null;

    const price = Number(rawPrice);
    return Number.isFinite(price) && price >= 0 ? price : null;
  }

  function updatePrice() {
    if (!printingSelect || !finishSelect || !printingPrice) return;

    const card = printings[Number(printingSelect.value)];
    if (!card) {
      printingPrice.textContent = "";
      return;
    }

    const price = getPrice(card, finishSelect.value);

    printingPrice.textContent =
      price === null
        ? "No USD price available for this printing and finish."
        : `Scryfall estimate: ${usdFormatter.format(price)} USD`;
  }

  function updatePrinting() {
    if (!printingSelect || !finishSelect || !printingImage || !confirmButton)
      return;

    const card = printings[Number(printingSelect.value)];
    if (!card) return;

    const imageUrl = getImage(card);

    printingImage.hidden = !imageUrl;
    if (imageUrl) printingImage.src = imageUrl;
    printingImage.alt = `${card.name} — ${card.set_name} #${card.collector_number}`;

    finishSelect.replaceChildren();

    for (const finish of card.finishes) {
      finishSelect.add(new Option(finishLabel(finish), finish));
    }

    finishSelect.disabled = saving || card.finishes.length === 0;
    confirmButton.disabled = saving || card.finishes.length === 0;

    updatePrice();
  }

  printingSelect?.addEventListener("change", updatePrinting);
  finishSelect?.addEventListener("change", updatePrice);

  dialog?.addEventListener("close", () => {
    pickerRequest?.abort();
  });

  async function openPrintings(card: Card) {
    if (
      saving ||
      !dialog ||
      !printingSelect ||
      !finishSelect ||
      !printingImage ||
      !printingStatus ||
      !confirmButton
    ) {
      return;
    }

    pickerRequest?.abort();
    const controller = new AbortController();
    pickerRequest = controller;

    printings = [];
    printingsCheckedAt = null;
    printingSelect.replaceChildren();
    finishSelect.replaceChildren();
    printingSelect.disabled = true;
    finishSelect.disabled = true;
    printingImage.hidden = true;
    confirmButton.disabled = true;
    printingStatus.textContent = `Loading versions of ${card.name}…`;
    if (printingPrice) printingPrice.textContent = "";

    if (!dialog.open) dialog.showModal();

    try {
      const endpoint = new URL(card.prints_search_uri);
      const query = endpoint.searchParams.get("q") ?? "";

      endpoint.searchParams.set("q", `(${query}) game:paper`);
      endpoint.searchParams.set("unique", "prints");

      let next: string | undefined = endpoint.href;
      const loadedPrintings: Card[] = [];

      while (next) {
        controller.signal.throwIfAborted();

        const response = await fetch(next, {
          headers: { Accept: "application/json" },
          signal: controller.signal,
        });

        if (response.status === 404) {
          printingStatus.textContent = "No paper printings found.";
          return;
        }

        if (!response.ok) throw new Error("Printings unavailable");

        const page: CardPage = await response.json();
        loadedPrintings.push(...page.data);
        next = page.has_more ? page.next_page : undefined;

        if (next) {
          await new Promise((resolve) => setTimeout(resolve, 150));
        }
      }

      controller.signal.throwIfAborted();
      printings = loadedPrintings;
      printingsCheckedAt = new Date().toISOString();

      for (const [index, printing] of printings.entries()) {
        printingSelect.add(
          new Option(
            `${printing.set_name} — #${printing.collector_number}`,
            String(index),
          ),
        );
      }

      printingSelect.disabled = printings.length === 0;
      printingStatus.textContent =
        `${printings.length} paper printings. ` +
        "Choose a set to preview its artwork.";

      updatePrinting();
    } catch {
      if (!controller.signal.aborted) {
        printingStatus.textContent =
          "Couldn’t load printings. Close and try again.";
      }
    }
  }

  confirmButton?.addEventListener("click", async () => {
    if (
      saving ||
      !printingSelect ||
      !finishSelect ||
      !confirmButton ||
      !status
    ) {
      return;
    }

    const card = printings[Number(printingSelect.value)];
    const finish = finishSelect.value;
    if (!card || !card.finishes.includes(finish)) return;

    saving = true;
    confirmButton.disabled = true;
    printingSelect.disabled = true;
    finishSelect.disabled = true;

    try {
      const {
        data: { session },
        error: sessionError,
      } = await supabase.auth.getSession();

      if (sessionError) throw sessionError;

      if (!session) {
        status.textContent =
          "Sign in above to save this printing to your chase list.";
        dialog?.close();
        return;
      }

      status.textContent = "Saving to your chase list…";
      if (printingStatus) {
        printingStatus.textContent = "Saving to your chase list…";
      }

      const { error } = await supabase.from("chase_cards").insert({
        scryfall_id: card.id,
        oracle_id: card.oracle_id ?? null,
        name: card.name,
        set_name: card.set_name,
        collector_number: card.collector_number,
        finish,
        image_url: getImage(card) ?? null,
        scryfall_uri: card.scryfall_uri,
        price_usd: getPrice(card, finish),
        price_checked_at: printingsCheckedAt,
      });

      if (error) {
        if (error.code === "23505") {
          const message =
            `Already on your list: ${card.name} — ${card.set_name} ` +
            `#${card.collector_number}, ${finishLabel(finish)}.`;

          status.textContent = message;
          if (printingStatus) printingStatus.textContent = message;
          return;
        }

        throw error;
      }

      status.textContent =
        `Saved: ${card.name} — ${card.set_name} ` +
        `#${card.collector_number}, ${finishLabel(finish)}.`;

      searchRequest?.abort();
      clearSuggestions();
      form?.reset();
      if (queryInput) queryInput.value = "";
      results?.replaceChildren();
      window.dispatchEvent(new Event("chase-cards-changed"));
      dialog?.close();
      window.requestAnimationFrame(() =>
        queryInput?.focus({ preventScroll: true }),
      );
    } catch (error) {
      const message =
        error instanceof Error
          ? error.message
          : "Couldn’t save this card. Please try again.";

      status.textContent = message;
      if (printingStatus) printingStatus.textContent = message;
    } finally {
      saving = false;
      printingSelect.disabled = printings.length === 0;
      finishSelect.disabled = card.finishes.length === 0;
      confirmButton.disabled = card.finishes.length === 0;
    }
  });

  if (form && status && results) {
    const button = form.querySelector<HTMLButtonElement>("button");

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (button?.disabled) return;

      const query = String(new FormData(form).get("query") ?? "").trim();
      if (!query) return;

      clearSuggestions();
      searchRequest?.abort();
      const controller = new AbortController();
      searchRequest = controller;
      results.replaceChildren();
      status.textContent = "Searching…";
      if (button) button.disabled = true;

      try {
        const endpoint = new URL("https://api.scryfall.com/cards/search");
        endpoint.searchParams.set("q", query);
        endpoint.searchParams.set("unique", "cards");
        endpoint.searchParams.set("order", "name");

        const response = await fetch(endpoint, {
          headers: { Accept: "application/json" },
          signal: controller.signal,
        });

        if (response.status === 404) {
          status.textContent = "No cards found. Try another name.";
          return;
        }

        if (!response.ok) throw new Error("Search unavailable");

        const data: CardPage = await response.json();
        if (controller.signal.aborted) return;
        const cards = data.data.slice(0, 12);

        for (const card of cards) {
          const item = document.createElement("li");
          const link = document.createElement("a");

          link.href = card.scryfall_uri;
          link.target = "_blank";
          link.rel = "noopener noreferrer";
          link.className = "card-result";
          link.setAttribute(
            "aria-label",
            `${card.name} on Scryfall (opens in a new tab)`,
          );

          const imageUrl = getImage(card);

          if (imageUrl) {
            const image = document.createElement("img");
            image.src = imageUrl;
            image.alt = card.name;
            image.loading = "lazy";
            image.width = 488;
            image.height = 680;
            link.append(image);
          }

          const name = document.createElement("span");
          name.textContent = `${card.name} ↗`;
          link.append(name);

          const choose = document.createElement("button");
          choose.type = "button";
          choose.className = "printing-button";
          choose.textContent = "Choose printing";
          choose.setAttribute("aria-haspopup", "dialog");
          choose.setAttribute("aria-label", `Choose printing for ${card.name}`);
          choose.addEventListener("click", () => openPrintings(card));

          item.append(link, choose);
          results.append(item);
        }

        status.textContent =
          `Showing ${cards.length} ${cards.length === 1 ? "result" : "results"}. ` +
          "Use Choose printing to browse artwork and finishes." +
          (data.has_more || data.data.length > 12
            ? " Narrow your search for more specific results."
            : "");
      } catch {
        if (!controller.signal.aborted)
          status.textContent =
            "Search couldn’t load. Please try again shortly.";
      } finally {
        if (button) button.disabled = false;
      }
    });
  }
</script>

<style>
  .search-results :global(.card-result) {
    display: block;
    border-radius: 0.75rem;
    color: var(--color-pyroduck-plasma);
    font-weight: 600;
  }

  .search-results :global(.card-result img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-pyroduck-plasma);
    border-radius: 0.75rem;
  }

  .search-results :global(.card-result span) {
    display: block;
    margin-top: 0.75rem;
  }

  .search-results :global(.card-result:hover) {
    color: var(--color-pyroduck-lime);
  }

  .search-results :global(.card-result:focus-visible) {
    outline: 2px solid var(--color-pyroduck-lime);
    outline-offset: 4px;
  }

  .printing-dialog {
    width: min(560px, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: 1.5rem;
    overflow: auto;
    border: 1px solid var(--color-pyroduck-plasma);
    border-radius: 1rem;
    background: var(--color-pyroduck-afterdark);
  }

  .printing-dialog::backdrop {
    background: rgb(0 0 0 / 85%);
  }

  .printing-controls {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 1rem;
  }

  .printing-label {
    display: grid;
    gap: 0.5rem;
    margin-block: 1rem;
    font-weight: 600;
  }

  .printing-select,
  .finish-select {
    width: 100%;
    min-width: 0;
    padding: 0.75rem;
    border: 1px solid var(--color-pyroduck-plasma);
    border-radius: 0.5rem;
    background: var(--color-pyroduck-void);
    color: inherit;
    font: inherit;
  }

  .printing-image {
    display: block;
    width: 100%;
    max-width: 300px;
    height: auto;
    margin: 1rem auto;
    border-radius: 0.75rem;
  }

  .printing-image[hidden] {
    display: none;
  }

  :global(.printing-button) {
    margin-top: 0.75rem;
    padding: 0.65rem 1rem;
    border-radius: 0.5rem;
    background: var(--color-pyroduck-plasma);
    color: var(--color-pyroduck-void);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  :global(.printing-button:hover) {
    background: var(--color-pyroduck-lime);
  }

  :global(.printing-button:disabled) {
    opacity: 0.5;
    cursor: default;
  }

  :global(.printing-button:focus-visible),
  .printing-select:focus-visible,
  .finish-select:focus-visible {
    outline: 2px solid var(--color-pyroduck-lime);
    outline-offset: 3px;
  }
</style>
