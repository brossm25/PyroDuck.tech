<section aria-labelledby="player-search-heading" class="player-search">
  <h2 id="player-search-heading">Find a player.</h2>

  <p class="player-search-description">
    Search a friend’s username. Enter at least 3 characters.
  </p>

  <form class="player-search-form" novalidate>
    <div class="player-search-field">
      <label for="player-search-query" class="sr-only"> Player username </label>

      <input
        id="player-search-query"
        name="username"
        type="search"
        required
        minlength="3"
        maxlength="25"
        autocomplete="off"
        autocapitalize="none"
        spellcheck="false"
        placeholder="Search by username"
        class="player-search-input"
      />
    </div>

    <button type="submit" class="player-search-button"> Search players </button>
  </form>

  <p class="player-search-status" role="status"></p>

  <ul class="player-search-results"></ul>

  <p class="player-search-help">
    Send a request with Add friend. Use the Friends menu to accept, decline, or
    cancel requests.
  </p>
</section>

<script>
  import { supabase } from "@/lib/supabase";

  interface Player {
    id: string;
    username: string;
    display_name: string;
  }

  interface Friendship {
    friendship_id: string;
    requester_id: string;
    recipient_id: string;
    status: "pending" | "accepted";
    player_id: string;
  }

  const form = document.querySelector<HTMLFormElement>(".player-search-form");

  const input = document.querySelector<HTMLInputElement>(
    "#player-search-query",
  );

  const searchButton = document.querySelector<HTMLButtonElement>(
    ".player-search-button",
  );

  const status = document.querySelector<HTMLElement>(".player-search-status");

  const results = document.querySelector<HTMLUListElement>(
    ".player-search-results",
  );

  let players: Player[] = [];
  let friendships: Friendship[] = [];
  let userId: string | null = null;
  let searching = false;
  let sending = false;
  let requestId = 0;
  let connectionsRequestId = 0;

  function setStatus(message: string) {
    if (status) status.textContent = message;
  }

  function syncControls() {
    if (searchButton) {
      searchButton.disabled = searching || sending;
      searchButton.textContent = searching ? "Searching…" : "Search players";
    }

    if (input) input.disabled = sending;
  }

  function renderPlayers() {
    if (!results) return;
    results.replaceChildren();

    for (const player of players) {
      const item = document.createElement("li");
      item.className = "player-result";

      const name = document.createElement("a");
      name.className = "player-result-name";
      name.href = `/mtg/player?id=${encodeURIComponent(player.id)}`;
      name.textContent = player.display_name || player.username;

      const username = document.createElement("p");
      username.className = "player-result-username";
      username.textContent = `@${player.username}`;

      item.append(name, username);

      const connection = friendships.find(
        (friendship) => friendship.player_id === player.id,
      );

      if (connection) {
        const state = document.createElement("p");
        state.className = "player-connection-state";

        if (connection.status === "accepted") {
          state.textContent = "✓ Friends";
        } else if (connection.requester_id === userId) {
          state.textContent = "Friend request sent";
        } else {
          state.textContent = "Request received — open Friends to accept.";
        }

        item.append(state);
      } else {
        const addButton = document.createElement("button");
        addButton.type = "button";
        addButton.className = "player-add-friend";
        addButton.textContent = "Add friend";
        addButton.disabled = searching || sending || !userId;

        addButton.setAttribute(
          "aria-label",
          `Send a friend request to @${player.username}`,
        );

        addButton.addEventListener("click", () => {
          void sendFriendRequest(player);
        });

        item.append(addButton);
      }

      results.append(item);
    }
  }

  function resetSearch() {
    requestId++;
    connectionsRequestId++;
    players = [];
    friendships = [];
    userId = null;
    searching = false;
    sending = false;

    results?.replaceChildren();
    setStatus("");
    syncControls();
  }

  async function refreshConnections() {
    if (!userId || searching || sending) return;

    const currentRequest = requestId;
    const currentConnectionsRequest = ++connectionsRequestId;

    try {
      const { data, error } = await supabase.rpc("get_my_friendships");

      if (
        currentRequest !== requestId ||
        currentConnectionsRequest !== connectionsRequestId
      ) {
        return;
      }

      if (error) {
        setStatus(
          "Friend connections couldn’t refresh. Search again before sending another request.",
        );
        return;
      }

      friendships = (data ?? []) as Friendship[];
      renderPlayers();
    } catch {
      if (
        currentRequest === requestId &&
        currentConnectionsRequest === connectionsRequestId
      ) {
        setStatus("Couldn’t refresh connections. Please search again.");
      }
    }
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!input || searching || sending) return;

    const query = input.value.trim().toLowerCase().replace(/^@/, "");

    input.value = query;

    if (!/^[a-z0-9_]{3,24}$/.test(query)) {
      setStatus(
        "Enter 3–24 letters, numbers, or underscores from the username.",
      );
      return;
    }

    const currentRequest = ++requestId;
    connectionsRequestId++;
    searching = true;
    players = [];
    friendships = [];
    userId = null;

    syncControls();
    renderPlayers();
    setStatus("Searching for players…");

    try {
      const {
        data: { session },
        error: sessionError,
      } = await supabase.auth.getSession();

      if (currentRequest !== requestId) return;
      if (sessionError) throw sessionError;

      if (!session) {
        setStatus("Sign in using the header to search for players.");
        return;
      }

      userId = session.user.id;

      const [searchResult, connectionsResult] = await Promise.all([
        supabase.rpc("search_players", {
          search_query: query,
        }),
        supabase.rpc("get_my_friendships"),
      ]);

      if (currentRequest !== requestId) return;

      if (searchResult.error) throw searchResult.error;
      if (connectionsResult.error) throw connectionsResult.error;

      players = (searchResult.data ?? []) as Player[];
      friendships = (connectionsResult.data ?? []) as Friendship[];

      if (!players.length) {
        setStatus(
          "No other players found. Check the username. Your own profile isn’t included.",
        );
        return;
      }

      setStatus(
        `Found ${players.length} ${
          players.length === 1 ? "player" : "players"
        }.` +
          (players.length === 20
            ? " Enter more of the username to narrow your results."
            : ""),
      );
    } catch {
      if (currentRequest === requestId) {
        players = [];
        setStatus(
          "Couldn’t load players and friend connections. Please try again.",
        );
      }
    } finally {
      if (currentRequest === requestId) {
        searching = false;
        syncControls();
        renderPlayers();
      }
    }
  });

  async function sendFriendRequest(player: Player) {
    if (sending || searching || !userId) return;

    if (friendships.some((friendship) => friendship.player_id === player.id)) {
      return;
    }

    const currentRequest = requestId;
    const currentUserId = userId;
    connectionsRequestId++;
    sending = true;

    syncControls();
    renderPlayers();
    setStatus(`Sending a request to @${player.username}…`);

    try {
      const {
        data: { session },
        error: sessionError,
      } = await supabase.auth.getSession();

      if (currentRequest !== requestId) return;

      if (sessionError || session?.user.id !== currentUserId) {
        setStatus("Your sign-in changed. Sign in and search again.");
        return;
      }

      const { data, error } = await supabase
        .from("friendships")
        .insert({
          requester_id: currentUserId,
          recipient_id: player.id,
        })
        .select("id")
        .single();

      if (currentRequest !== requestId) return;

      if (error) {
        if (error.code === "23505") {
          setStatus(
            "A connection or request already exists. Check the Friends menu.",
          );

          sending = false;
          window.dispatchEvent(new Event("friendships-changed"));
          return;
        }

        if (error.code === "23503") {
          setStatus(
            "Both players need a saved player profile. Open your account menu and choose Edit profile.",
          );
          return;
        }

        setStatus(`Couldn’t send the request: ${error.message}`);
        return;
      }

      friendships.push({
        friendship_id: data.id,
        requester_id: currentUserId,
        recipient_id: player.id,
        status: "pending",
        player_id: player.id,
      });

      setStatus(
        `Friend request sent to @${player.username}. They’ll need to accept it.`,
      );

      sending = false;
      window.dispatchEvent(new Event("friendships-changed"));
    } catch {
      if (currentRequest === requestId) {
        setStatus("Couldn’t send the request. Please try again.");
      }
    } finally {
      if (currentRequest === requestId) {
        sending = false;
        syncControls();
        renderPlayers();
      }
    }
  }

  window.addEventListener("friendships-changed", () => {
    void refreshConnections();
  });

  let observedAuthUserId: string | null | undefined;

  supabase.auth.onAuthStateChange((event, session) => {
    if (
      event !== "INITIAL_SESSION" &&
      event !== "SIGNED_IN" &&
      event !== "SIGNED_OUT"
    ) {
      return;
    }

    const nextUserId = session?.user.id ?? null;

    if (observedAuthUserId === undefined) {
      observedAuthUserId = nextUserId;
      return;
    }

    if (nextUserId === observedAuthUserId) return;
    observedAuthUserId = nextUserId;
    if (event === "SIGNED_OUT" || event === "SIGNED_IN") {
      resetSearch();
    }
  });
</script>

<style>
  .player-search {
    padding: 1rem;
  }

  h2 {
    margin: 0;
    color: var(--color-brand-text);
    font-size: clamp(1.5rem, 5vw, 1.875rem);
    font-weight: 700;
  }

  .player-search-description {
    margin: 0.75rem 0 0;
    color: var(--color-brand-muted);
    line-height: 1.6;
  }

  .player-search-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .player-search-field {
    flex: 1 1 14rem;
    min-width: 0;
  }

  .player-search-input {
    box-sizing: border-box;
    width: 100%;
    min-height: 44px;
    padding: 0.75rem 1rem;
    border: 1px solid
      color-mix(in srgb, var(--color-pyroduck-plasma) 45%, transparent);
    border-radius: 0.5rem;
    background: var(--color-pyroduck-void);
    color: var(--color-brand-text);
    font: inherit;
  }

  .player-search-button {
    min-height: 44px;
    padding: 0.75rem 1.25rem;
    border: 0;
    border-radius: 0.5rem;
    background: var(--color-pyroduck-plasma);
    color: var(--color-pyroduck-void);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .player-search-button:hover:not(:disabled) {
    background: var(--color-pyroduck-lime);
  }

  .player-search-button:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .player-search-input:focus-visible,
  .player-search-button:focus-visible {
    outline: 2px solid var(--color-pyroduck-lime);
    outline-offset: 3px;
  }

  .player-search-status {
    margin: 1rem 0 0;
    color: var(--color-brand-muted);
    line-height: 1.5;
  }

  .player-search-status:empty {
    display: none;
  }

  .player-search-results {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .player-search-results:not(:empty) {
    margin-top: 1.5rem;
  }

  .player-search-results :global(.player-result) {
    min-width: 0;
    padding: 1rem;
    border: 1px solid
      color-mix(in srgb, var(--color-pyroduck-plasma) 30%, transparent);
    border-radius: 0.75rem;
    background: var(--color-pyroduck-void);
    overflow-wrap: anywhere;
  }

  .player-search-results :global(.player-result-name) {
    display: inline-block;
    margin: 0;
    border-radius: 0.25rem;
    color: var(--color-pyroduck-lime);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .player-search-results :global(.player-result-name:hover) {
    color: var(--color-pyroduck-plasma);
  }

  .player-search-results :global(.player-result-name:focus-visible) {
    outline: 2px solid var(--color-pyroduck-lime);
    outline-offset: 3px;
  }

  .player-search-results :global(.player-result-username) {
    margin: 0.25rem 0 0;
    color: var(--color-brand-muted);
  }

  .player-search-results :global(.player-add-friend) {
    min-height: 44px;
    margin-top: 1rem;
    padding: 0.65rem 1rem;
    border: 1px solid var(--color-pyroduck-plasma);
    border-radius: 0.5rem;
    background: var(--color-pyroduck-plasma);
    color: var(--color-pyroduck-void);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .player-search-results :global(.player-add-friend:hover:not(:disabled)) {
    border-color: var(--color-pyroduck-lime);
    background: var(--color-pyroduck-lime);
  }

  .player-search-results :global(.player-add-friend:focus-visible) {
    outline: 2px solid var(--color-pyroduck-lime);
    outline-offset: 3px;
  }

  .player-search-results :global(.player-add-friend:disabled) {
    opacity: 0.6;
    cursor: wait;
  }

  .player-search-results :global(.player-connection-state) {
    margin: 0.75rem 0 0;
    color: var(--color-pyroduck-lime);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .player-search-help {
    margin: 1.5rem 0 0;
    color: var(--color-brand-muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }
</style>
