<details class="friends-menu">
  <summary class="friends-trigger">
    Friends
    <span class="friends-count" hidden></span>
    <span class="friends-chevron" aria-hidden="true">⌄</span>
  </summary>

  <div class="friends-panel">
    <p class="friends-status" role="status"></p>
    <div class="friends-content"></div>
  </div>
</details>

<script>
  import { supabase } from "@/lib/supabase";

  interface Friendship {
    friendship_id: string;
    requester_id: string;
    recipient_id: string;
    status: "pending" | "accepted";
    created_at: string;
    player_id: string;
    username: string;
    display_name: string;
  }

  const menus = Array.from(
    document.querySelectorAll<HTMLDetailsElement>(".friends-menu"),
  );

  const duckyPlayerId = "297b9756-34b9-4071-b21f-94517e7117c2";
  const dismissedWelcomeUsers = new Set<string>();

  function welcomeKey(id: string) {
    return `binderlink:welcome-dismissed:${id}`;
  }

  function welcomeDismissed(id: string) {
    if (dismissedWelcomeUsers.has(id)) return true;

    try {
      return localStorage.getItem(welcomeKey(id)) === "true";
    } catch {
      return false;
    }
  }

  let friendships: Friendship[] = [];
  let userId: string | null = null;
  let loading = false;
  let changing = false;
  let requestId = 0;

  function setStatus(message: string) {
    menus.forEach((menu) => {
      const status = menu.querySelector<HTMLElement>(".friends-status");

      if (status) status.textContent = message;
    });
  }

  function render() {
    const incoming = friendships.filter(
      (item) => item.status === "pending" && item.recipient_id === userId,
    );

    const outgoing = friendships.filter(
      (item) => item.status === "pending" && item.requester_id === userId,
    );

    const accepted = friendships.filter((item) => item.status === "accepted");

    menus.forEach((menu) => {
      const count = menu.querySelector<HTMLElement>(".friends-count");
      const content = menu.querySelector<HTMLElement>(".friends-content");

      if (count) {
        count.hidden = incoming.length === 0;
        count.textContent = String(incoming.length);
        count.setAttribute(
          "aria-label",
          `${incoming.length} incoming friend requests`,
        );
      }

      if (!content) return;
      content.replaceChildren();

      if (!userId || loading) return;

      if (userId !== duckyPlayerId && !welcomeDismissed(userId)) {
        const welcome = document.createElement("div");
        welcome.className = "friend-row welcome-connection";

        const eyebrow = document.createElement("p");
        eyebrow.className = "welcome-label";
        eyebrow.textContent = "Your first connection";

        const link = document.createElement("a");
        link.className = "friend-name welcome-name";
        link.href = `/mtg/player?id=${encodeURIComponent(duckyPlayerId)}`;
        link.textContent = "Ducky ";

        const duck = document.createElementNS(
          "http://www.w3.org/2000/svg",
          "svg",
        );

        duck.setAttribute("viewBox", "0 0 64 64");
        duck.setAttribute("width", "24");
        duck.setAttribute("height", "24");
        duck.setAttribute("aria-hidden", "true");
        duck.classList.add("welcome-duck");

        duck.innerHTML = `
          <path
            d="M45 26h13c3 0 4 4 1 6l-13 5"
            fill="white"
          />
          <path
            d="M29 34c-5-5-5-11-2-16 3-6 11-8 17-5
               7 3 10 12 6 19l-4 7c7 1 11 5 10 10
               -1 8-11 12-25 12C15 61 6 54 7 42
               c0-5 2-9 5-12 2 7 8 10 17 4Z"
            fill="white"
          />
          <circle cx="42" cy="23" r="2.5" fill="black" />
        `;

        link.append(duck);

        link.addEventListener("click", () => {
          document
            .querySelectorAll<HTMLDetailsElement>("header details")
            .forEach((details) => {
              details.open = false;
            });
        });

        const introduction = document.createElement("p");
        introduction.className = "welcome-description";
        introduction.textContent =
          "Welcome to BinderLink! I’m Ducky, the creator. Every collection starts with a connection.";

        const explanation = document.createElement("p");
        explanation.className = "welcome-note";
        explanation.textContent =
          "A welcome connection, separate from your friends. Friends-only cards and decks stay between accepted friends.";

        const actions = document.createElement("div");
        actions.className = "friend-actions";

        const dismiss = document.createElement("button");
        dismiss.type = "button";
        dismiss.className = "friend-button";
        dismiss.textContent = "Dismiss welcome";
        dismiss.setAttribute("aria-label", "Dismiss Ducky’s welcome card");

        dismiss.addEventListener("click", () => {
          if (!userId) return;

          dismissedWelcomeUsers.add(userId);

          try {
            localStorage.setItem(welcomeKey(userId), "true");
          } catch {
            // Still dismiss it for this page if storage is unavailable.
          }

          render();

          menu.querySelector<HTMLElement>("summary")?.focus();
        });

        actions.append(dismiss);
        welcome.append(eyebrow, link, introduction, explanation, actions);
        content.append(welcome);
      }

      function addGroup(title: string, items: Friendship[]) {
        if (!items.length || !content) return;

        const heading = document.createElement("h3");
        heading.className = "friend-group-heading";
        heading.textContent = `${title} (${items.length})`;

        const list = document.createElement("ul");
        list.className = "friend-group-list";

        for (const item of items) {
          const row = document.createElement("li");
          row.className = "friend-row";

          const name = document.createElement("a");
          name.className = "friend-name";
          name.href = `/mtg/player?id=${encodeURIComponent(item.player_id)}`;
          name.textContent = item.display_name || item.username;

          name.addEventListener("click", () => {
            document
              .querySelectorAll<HTMLDetailsElement>("header details")
              .forEach((details) => {
                details.open = false;
              });
          });

          const username = document.createElement("p");
          username.className = "friend-username";
          username.textContent = `@${item.username}`;

          const actions = document.createElement("div");
          actions.className = "friend-actions";

          function addButton(
            label: string,
            action: "accept" | "remove",
            primary = false,
          ) {
            const button = document.createElement("button");
            button.type = "button";
            button.className = primary
              ? "friend-button friend-button-primary"
              : "friend-button";

            button.textContent = label;
            button.disabled = changing;
            button.setAttribute("aria-label", `${label}: @${item.username}`);

            button.addEventListener("click", () => {
              void changeFriendship(item, action);
            });

            actions.append(button);
          }

          if (item.status === "accepted") {
            const messageButton = document.createElement("button");
            messageButton.type = "button";
            messageButton.className = "friend-button";
            messageButton.textContent = "Message";
            messageButton.disabled = changing;
            messageButton.setAttribute(
              "aria-label",
              `Message @${item.username}`,
            );

            messageButton.addEventListener("click", async () => {
              if (messageButton.disabled || !userId) return;

              const currentUser = userId;
              messageButton.disabled = true;
              messageButton.textContent = "Opening…";

              try {
                const { data, error } = await supabase.rpc(
                  "start_friend_conversation",
                  { p_friend_id: item.player_id },
                );

                if (userId !== currentUser || !messageButton.isConnected)
                  return;
                if (error) throw error;
                if (typeof data !== "string")
                  throw new Error("Conversation unavailable.");

                window.location.assign(
                  `/mtg/messages?conversation=${encodeURIComponent(data)}`,
                );
              } catch {
                if (userId === currentUser && messageButton.isConnected) {
                  messageButton.disabled = false;
                  messageButton.textContent = "Retry message";
                  messageButton.title =
                    "Couldn’t open the conversation. Try again.";
                }
              }
            });

            actions.append(messageButton);
            addButton("Remove friend", "remove");
          } else if (item.recipient_id === userId) {
            addButton("Accept", "accept", true);
            addButton("Decline", "remove");
          } else {
            addButton("Cancel request", "remove");
          }

          row.append(name, username, actions);
          list.append(row);
        }

        content.append(heading, list);
      }

      addGroup("Incoming requests", incoming);
      addGroup("Your friends", accepted);
      addGroup("Sent requests", outgoing);

      if (!friendships.length) {
        const empty = document.createElement("p");
        empty.className = "friend-empty";
        empty.textContent = "No friends yet. Find a player to send a request.";

        content.append(empty);
      }
    });
  }

  async function loadFriends() {
    if (changing) return;

    const currentRequest = ++requestId;

    loading = true;
    friendships = [];
    userId = null;

    render();
    setStatus("Loading friends…");

    try {
      const {
        data: { session },
        error: sessionError,
      } = await supabase.auth.getSession();

      if (currentRequest !== requestId) return;
      if (sessionError) throw sessionError;

      if (!session) {
        setStatus("Sign in to see friends and friend requests.");
        return;
      }

      userId = session.user.id;

      const { data, error } = await supabase.rpc("get_my_friendships");

      if (currentRequest !== requestId) return;
      if (error) throw error;

      friendships = (data ?? []) as Friendship[];
      setStatus("");
    } catch {
      if (currentRequest === requestId) {
        setStatus(
          "Couldn’t load friends. Close and reopen this menu to retry.",
        );
      }
    } finally {
      if (currentRequest === requestId) {
        loading = false;
        render();
      }
    }
  }

  async function changeFriendship(
    item: Friendship,
    action: "accept" | "remove",
  ) {
    if (changing || loading || !userId) return;

    if (
      action === "remove" &&
      item.status === "accepted" &&
      !window.confirm(`Remove @${item.username} from your friends?`)
    ) {
      return;
    }

    const currentRequest = requestId;
    const currentUserId = userId;
    let succeeded = false;

    changing = true;
    render();

    setStatus(action === "accept" ? "Accepting request…" : "Removing…");

    try {
      const {
        data: { session },
        error: sessionError,
      } = await supabase.auth.getSession();

      if (currentRequest !== requestId) return;

      if (sessionError || session?.user.id !== currentUserId) {
        throw new Error("Your sign-in changed. Reopen the menu.");
      }

      const result =
        action === "accept"
          ? await supabase
              .from("friendships")
              .update({ status: "accepted" })
              .eq("id", item.friendship_id)
              .eq("recipient_id", currentUserId)
              .eq("status", "pending")
              .select("id")
          : await supabase
              .from("friendships")
              .delete()
              .eq("id", item.friendship_id)
              .select("id");

      if (currentRequest !== requestId) return;
      if (result.error) throw result.error;

      if (!result.data?.length) {
        throw new Error("This connection changed. Reopen the menu.");
      }

      succeeded = true;
    } catch (error) {
      if (currentRequest === requestId) {
        setStatus(
          typeof error === "object" &&
            error !== null &&
            "message" in error &&
            typeof error.message === "string"
            ? error.message
            : "Couldn’t update this connection. Please try again.",
        );
      }
    } finally {
      if (currentRequest === requestId) {
        changing = false;
        render();
      }
    }

    if (succeeded && currentRequest === requestId) {
      window.dispatchEvent(new Event("friendships-changed"));
    }
  }

  menus.forEach((menu) => {
    menu.addEventListener("toggle", () => {
      if (menu.open && !changing) {
        void loadFriends();
      }
    });
  });

  window.addEventListener("friendships-changed", () => {
    void loadFriends();
  });

  supabase.auth.onAuthStateChange((event, session) => {
    if (
      event === "SIGNED_OUT" ||
      (event === "SIGNED_IN" && session?.user.id !== userId)
    ) {
      requestId++;
      changing = false;
      loading = false;
      userId = null;
      friendships = [];

      render();
      setStatus("Sign in to see friends and friend requests.");

      window.setTimeout(() => {
        void loadFriends();
      }, 0);
    }
  });

  void loadFriends();
</script>

<style>
  [hidden] {
    display: none !important;
  }

  .friends-menu {
    position: relative;
  }

  .friends-trigger {
    display: flex;
    min-height: 44px;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    color: var(--color-brand-text);
    font-size: 1.125rem;
    font-weight: 500;
    list-style: none;
    cursor: pointer;
  }

  .friends-trigger::-webkit-details-marker {
    display: none;
  }

  .friends-trigger:hover {
    background: var(--color-pyroduck-afterdark);
    color: var(--color-pyroduck-lime);
  }

  .friends-trigger:focus-visible {
    outline: 2px solid var(--color-pyroduck-lime);
    outline-offset: 3px;
  }

  .friends-count {
    min-width: 1.25rem;
    padding: 0.1rem 0.35rem;
    border-radius: 999px;
    background: var(--color-pyroduck-lime);
    color: var(--color-pyroduck-void);
    font-size: 0.75rem;
    font-weight: 700;
    text-align: center;
  }

  .friends-chevron {
    margin-left: auto;
  }

  .friends-menu[open] > summary .friends-chevron {
    transform: rotate(180deg);
  }

  .friends-panel {
    padding: 1rem;
    border: 1px solid
      color-mix(in srgb, var(--color-pyroduck-plasma) 35%, transparent);
    border-radius: 0.75rem;
    background: var(--color-pyroduck-void);
    color: var(--color-brand-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .friends-status {
    margin: 0;
  }

  .friends-status:empty {
    display: none;
  }

  .friends-content :global(.friend-group-heading) {
    margin: 1rem 0 0.5rem;
    color: var(--color-pyroduck-lime);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .friends-content :global(.friend-group-heading:first-child) {
    margin-top: 0;
  }

  .friends-content :global(.friend-group-list) {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .friends-content :global(.friend-row) {
    padding: 0.75rem;
    border: 1px solid
      color-mix(in srgb, var(--color-pyroduck-plasma) 25%, transparent);
    border-radius: 0.5rem;
    background: var(--color-pyroduck-afterdark);
    overflow-wrap: anywhere;
  }

  .friends-content :global(.friend-name) {
    display: inline-block;
    margin: 0;
    border-radius: 0.25rem;
    color: var(--color-pyroduck-plasma);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .friends-content :global(.friend-name:hover) {
    color: var(--color-pyroduck-lime);
  }

  .friends-content :global(.friend-name:focus-visible) {
    outline: 2px solid var(--color-pyroduck-lime);
    outline-offset: 3px;
  }

  .friends-content :global(.friend-username) {
    margin: 0.2rem 0 0;
    color: var(--color-brand-muted);
    font-size: 0.8rem;
  }

  .friends-content :global(.friend-actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .friends-content :global(.friend-button) {
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-pyroduck-plasma);
    border-radius: 0.5rem;
    background: transparent;
    color: var(--color-brand-text);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .friends-content :global(.friend-button-primary) {
    background: var(--color-pyroduck-plasma);
    color: var(--color-pyroduck-void);
  }

  .friends-content :global(.friend-button:hover:not(:disabled)) {
    border-color: var(--color-pyroduck-lime);
    color: var(--color-pyroduck-lime);
  }

  .friends-content :global(.friend-button-primary:hover:not(:disabled)) {
    background: var(--color-pyroduck-lime);
    color: var(--color-pyroduck-void);
  }

  .friends-content :global(.friend-button:focus-visible) {
    outline: 2px solid var(--color-pyroduck-lime);
    outline-offset: 3px;
  }

  .friends-content :global(.friend-button:disabled) {
    opacity: 0.6;
    cursor: wait;
  }

  .friends-content :global(.friend-empty) {
    margin: 0;
  }

  @media (min-width: 1280px) {
    .friends-trigger {
      padding: 0.5rem 0.65rem;
      font-size: 1rem;
      white-space: nowrap;
    }

    .friends-panel {
      position: absolute;
      right: 0;
      top: 100%;
      z-index: 60;
      width: min(21rem, calc(100vw - 2rem));
      max-height: min(32rem, calc(100dvh - 9rem));
      margin-top: 0.5rem;
      overflow-y: auto;
      box-shadow: 0 12px 32px rgb(0 0 0 / 45%);
    }
  }

  @media (min-width: 1536px) {
    .friends-trigger {
      padding-inline: 0.85rem;
      font-size: 1.125rem;
    }
  }

  .friends-content :global(.welcome-connection) {
    margin-bottom: 1rem;
    border-color: var(--color-pyroduck-plasma);
  }

  .friends-content :global(.welcome-label) {
    margin: 0 0 0.5rem;
    color: var(--color-pyroduck-lime);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .friends-content :global(.welcome-description) {
    margin: 0.75rem 0 0;
    color: var(--color-brand-text);
    line-height: 1.6;
  }

  .friends-content :global(.welcome-note) {
    margin: 0.5rem 0 0;
    color: var(--color-brand-muted);
    font-size: 0.8rem;
    line-height: 1.6;
  }

  .friends-content :global(.welcome-name) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
  }

  .friends-content :global(.welcome-name .welcome-duck) {
    margin-left: 0;
  }
</style>
