# Copy to site/.env.local for local dev (gitignored).
# For GitHub Pages deploys, set the same names as repository Secrets:
#   PUBLIC_SUPABASE_URL
#   PUBLIC_SUPABASE_PUBLISHABLE_KEY
#
# Use the Supabase Project URL and the publishable/anon key only — never the service role key.

PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key
